settings_summary= {"language": "zh", "c308l_default_lang_migrated": null, "display": {"_animations_enabled_comment": "Enable UI animations and transitions. Default: auto-detected from platform capabilities (off on embedded/basic hardware, on for standard).", "_backlight_enable_ioctl_comment": "Use BACKLIGHT_ENABLE/DISABLE ioctls for Allwinner display control. Some platforms (e.g. Elegoo CC1, AD5X) invert PWM polarity when these are called; set false for brightness-only control. Default: true.", "_backlight_floor_percent_comment": "Lowest brightness level (percent of the panel's raw range) the screen may drop to while on. Some panels render lower levels as black; raise this if the panel goes black before the slider minimum. 0 disables. Default: 0 (20 on K2 builds). Requires restart.", "_bed_mesh_render_mode_comment": "Bed mesh visualization mode. 0=3D surface (default), 1=2D heatmap. Default: 0.", "_bed_mesh_show_zero_plane_comment": "Show translucent reference plane at Z=0 in bed mesh 3D view. Helps visualize where nozzle touches bed. Default: true.", "_dim_brightness_comment": "Brightness percentage when dimmed (1-100). Default: 30%.", "_dim_sec_comment": "Seconds of inactivity before display dims (0 = no dimming). Default: 600 (10 minutes). Must be less than sleep_sec.", "_drm_device_comment": "Override DRM device path (e.g., '/dev/dri/card1'). Empty string enables auto-detection. Pi 5 has multiple DRM cards: card0 (v3d, 3D only), card1 (DSI touchscreen), card2 (vc4/HDMI). Auto-detection finds the first with dumb buffer support and a connected display.", "_gcode_render_mode_comment": "G-code visualization mode. 0=Auto, 1=3D GLES, 2=2D Layer (default). Can also be overridden via HELIX_GCODE_MODE env var (3D/2D).", "_screensaver_type_comment": "Screensaver during display sleep. 0=Off (blank screen), 1=Flying Toasters, 2=Starfield, 3=3D Pipes. Default: 1, or 0 on low-power hardware. Replaces legacy screensaver_enabled boolean.", "_sleep_backlight_off_comment": "Power off backlight during display sleep. Set false only on platforms where backlight power-off is verified to prevent wake-on-touch. When false, software overlay + FBIOBLANK make screen appear off while backlight stays powered. Default: true.", "_sleep_sec_comment": "Seconds of inactivity before display turns OFF (0 = never). Default: 1200 (20 minutes).", "_sleep_while_printing_comment": "Allow display to dim and sleep during active prints. When false, display stays on while printing. Default: true.", "_theme_comment": "Color theme, loaded from assets/config/themes/defaults/<name>.json. Options: ayu, catppuccin, chatgpt, cupertino, dracula, everforest, gruvbox, helixscreen, kanagawa, material-design, midnight, nord, onedark, rose-pine, solarized, tokyonight, yami. Default: 'helixscreen'. Requires restart.", "_time_format_comment": "Time display format. 0 = 12-hour (2:30 PM), 1 = 24-hour (14:30). Default is 12-hour.", "_timezone_comment": "IANA timezone ID (e.g., 'America/New_York', 'Europe/London'). Applied via setenv/tzset so all localtime_r() calls produce correct local times. Default: 'UTC'.", "animations_enabled": true, "backlight_enable_ioctl": true, "backlight_floor_percent": 0, "bed_mesh_render_mode": 0, "bed_mesh_show_zero_plane": true, "dim_brightness": 30, "dim_sec": 0, "drm_device": "", "gcode_render_mode": 3, "gpu_3d_blocked": false, "gpu_blur_blocked": false, "rotate": 270, "screensaver_type": 1, "sleep_backlight_off": true, "sleep_sec": 0, "sleep_while_printing": true, "theme": "helixscreen", "time_format": 0, "timezone": "UTC"}, "input": {"_device_blacklist_comment": "List of USB input devices HelixScreen ignores entirely for keyboard/scanner input, as 'vid:pid' lowercase 4-digit hex strings (e.g. ['002c:261a']). Use this when an external barcode scanner tool (like afc-spool-scan) needs the device and HelixScreen keeps grabbing it. Find a device's VID:PID in the Barcode Scanner settings device list, or in helixscreen.log lines '[InputScanner] Found keyboard:' / 'Found USB HID keyboard device:'. Empty list = no blacklist.", "_force_calibration_comment": "Force touch calibration on next startup. Automatically cleared after calibration completes. Default: false.", "_scroll_limit_comment": "Pixels of movement before scrolling starts. Lower = more responsive. Default LVGL is 10, we use 10 to match.", "_scroll_throw_comment": "Scroll momentum decay rate (1-99). Higher = faster decay. Default LVGL is 10, we use 25 for better touchpad feel.", "_touch_device_comment": "Override touch/pointer input device (e.g., '/dev/input/event1'). Empty string enables auto-detection. Auto-detection finds touch or pointer capable devices.", "calibration": {"_comment": "Touch calibration coefficients. Set by calibration wizard or manually.", "a": 1.0, "b": 0.0, "c": 0.0, "d": 0.0, "e": 1.0, "f": 0.0, "valid": false}, "device_blacklist": [], "force_calibration": false, "scroll_limit": 10, "scroll_throw": 25, "touch_device": ""}, "brightness": 80}
