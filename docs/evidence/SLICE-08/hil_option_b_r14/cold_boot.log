import pathlib
for p in sorted(pathlib.Path("/proc").iterdir(), key=lambda x: int(x.name) if x.name.isdigit() else 999999):
    if not p.name.isdigit():
        continue
    try:
        cmd = (p / "cmdline").read_bytes().replace(b"\x00", b" ").decode(errors="replace").strip()
        if any(k in cmd for k in ("printer-soc", "services.py", "dbus", "forward_service", "device_manager", "helix", "gateway")):
            exe = ""
            try:
                exe = str((p / "exe").resolve())
            except Exception as e:
                exe = f"ERR:{e}"
            print(f"PID={p.name} EXE={exe} CMD={cmd}")
    except Exception:
        pass
