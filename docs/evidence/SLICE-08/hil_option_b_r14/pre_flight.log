#!/bin/sh

case "$1" in
    start)
        echo "Starting MBP drivers..."
        if [ -x /usr/bin/load_mbd.sh ]; then
            /usr/bin/load_mbd.sh
        else
            echo "Error: /usr/bin/load_mbd.sh not found!"
            exit 1
        fi

        # Disabled pipeline demo by default to avoid resource & GPIO conflicts
        # if [ -x /usr/bin/run_pipeline.sh ]; then
        #     /usr/bin/run_pipeline.sh 2
        # fi
        ;;
    stop)
        echo "Stopping pipeline demo..."
        killall pipeline_demo 2>/dev/null
        if [ -x /usr/bin/ipc-property-startup.sh ]; then
            /usr/bin/ipc-property-startup.sh stop 2>/dev/null
        fi
        ;;
    restart)
        $0 stop
        sleep 1
        $0 start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
