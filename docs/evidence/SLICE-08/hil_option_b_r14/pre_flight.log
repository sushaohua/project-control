#!/bin/sh

# Start all init scripts in /etc/init.d
# executing them in numerical order.

VENDOR_DIR=/amlogic/modules/vendor
if [ -f $VENDOR_DIR/vendor_install.sh ]; then
    cd $VENDOR_DIR
    $VENDOR_DIR/vendor_install.sh
    cd -
fi

for initscript in /etc/init.d/S[0-9][0-9]*
do
    if [ -x $initscript ] ;
    then
        $initscript start
    fi
done
