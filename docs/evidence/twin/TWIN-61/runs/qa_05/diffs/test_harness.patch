+        self.assertEqual(report["missing_th_tx_seqs"], [])
+
+    def test_evaluate_burst_debug_logs_rejects_missing_th_or_tx_ack(self) -> None:
+        """验证反例：缺失单帧 TH 高位序列（如 seq=289）或缺失单帧 TX ACK 应答时必须判定失败。"""
+        plan = generate_290_burst_plan()
+        mc_log, th_log = simulate_honest_290_burst_logs(plan)
+
+        th_missing_289 = re.sub(r"\[TH-DBG\].*?dir=RX\s+node=TH\s+seq=289\s+.*?\r\n", "", th_log)
+        passed_th_rx, rep_th_rx = evaluate_burst_debug_logs(mc_log, th_missing_289, expected_total_frames=290)
+        self.assertFalse(passed_th_rx)
+        self.assertIn(289, rep_th_rx["missing_th_rx_seqs"])
