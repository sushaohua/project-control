+def _drive_live_seq01(http_base: str, mc_log_path: Optional[Path]) -> bool:
+    """执行 SEQ-01：动态 `boot_id` 校验 -> OOBE 完成 -> `G28` 归零 -> X/Y/Z 点动 -> `0x17` 急停 -> 故障清除 -> 再次归零恢复 `READY`。"""
+    _, ver1 = _http_json_call(http_base, "GET", "/api/v1/system/versions")
+    _http_json_call(http_base, "POST", "/api/v1/system/reset_mcu", {})
+    _, ver2 = _http_json_call(http_base, "GET", "/api/v1/system/versions")
+    _, state0 = _http_json_call(http_base, "GET", "/api/v1/state")
+    _, snap0 = _http_json_call(http_base, "GET", "/api/v1/temperature/snapshot")
+    b1 = (int(ver1.get("mc_boot_id", 0)), int(ver1.get("th_boot_id", 0)))
+    b2 = (int(ver2.get("mc_boot_id", 0)), int(ver2.get("th_boot_id", 0)))
+    snap_ok, _ = verify_seq01_oobe_bootid_and_adc_snapshot(state0, snap0, b1, b2)
+
+    c_oobe, _ = _http_json_call(http_base, "POST", "/api/v1/oobe/complete", {"completed": True})
+    c_home1, _ = _http_json_call(http_base, "POST", "/api/v1/motion/home", {"axes": ["X", "Y", "Z"]})
+    for axis in ("X", "Y", "Z"):
+        if _http_json_call(http_base, "POST", "/api/v1/motion/jog", {"axis": axis, "distance_mm": 1.0, "feedrate": 1500})[0] != 200:
+            return False
+    c_stop, _ = _http_json_call(http_base, "POST", "/api/v1/motion/stop", {})
+    c_clr, _ = _http_json_call(http_base, "POST", "/api/v1/system/clear_fault", {})
+    c_home2, _ = _http_json_call(http_base, "POST", "/api/v1/motion/home", {"axes": ["X", "Y", "Z"]})
+    _, st_after = _http_json_call(http_base, "GET", "/api/v1/state")
+    mc_text = mc_log_path.read_text(encoding="utf-8", errors="replace") if (mc_log_path and mc_log_path.exists()) else ""
+    logs_ok = ("op=HOME" in mc_text and "op=MOVE" in mc_text and "cmd=0x17" in mc_text)
+    return bool(
+        snap_ok
+        and all(c == 200 for c in (c_oobe, c_home1, c_stop, c_clr, c_home2))
+        and st_after.get("system_status") == "READY"
+        and logs_ok
+    )
+
