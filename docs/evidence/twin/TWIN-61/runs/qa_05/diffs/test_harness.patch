+# 权威物理量程与哨兵值常量（对齐 telemetry_types.h 与 minimc_telemetry.h）
+AISOC_BED_VALID_MIN_MILLIC = 5000
+AISOC_BED_VALID_MAX_MILLIC = 130000
+AISOC_NOZZLE_VALID_MIN_MILLIC = 5000
+AISOC_NOZZLE_VALID_MAX_MILLIC = 300000
+AISOC_TEMP_MILLIC_FAULT = 2147483647
+AISOC_TEMP_MILLIC_OFFLINE = 2147483646
+AISOC_FRESHNESS_STALE_MS = 1500
+AISOC_FRESHNESS_FAULT_MS = 3000
+VALID_GCODE_REGEX = re.compile(
+    r"^\s*(?:G0|G1|G28|G29|G90|G91|G92|M82|M83|M104|M106|M107|M109|M114|M140|M190|T[0-3])\b",
+    re.MULTILINE,
