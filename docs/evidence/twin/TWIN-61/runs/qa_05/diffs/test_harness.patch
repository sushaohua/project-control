+def main(argv: Optional[Sequence[str]] = None) -> int:
+    """命令行主入口：支持 `--self-test` 或 `--live`（带断链/重连命令钩子）运行全部 5 类复合序列。"""
+    parser = argparse.ArgumentParser(description="TWIN-61 5类复合业务序列自动化验证套件")
+    parser.add_argument("--self-test", action="store_true", help="运行内置 5 类复合序列正反例与端到端状态机自检")
+    parser.add_argument("--live", action="store_true", help="针对指定网关 URL 执行端到端复合业务序列验证")
+    parser.add_argument("--http-base", type=str, default="http://192.168.77.134:8080", help="实机网关 URL")
+    parser.add_argument("--mc-log", type=Path, default=None, help="MC 调试日志路径")
+    parser.add_argument("--th-log", type=Path, default=None, help="TH 调试日志路径")
+    parser.add_argument(
+        "--disconnect-cmd",
+        type=str,
+        default="systemctl stop forward-service || true",
+        help="SEQ-05 实机触发底层串口断链的外部命令",
+    )
+    parser.add_argument(
+        "--reconnect-cmd",
+        type=str,
+        default="systemctl start forward-service || true",
+        help="SEQ-05 实机恢复底层串口重连的外部命令",
+    )
+    args = parser.parse_args(argv)
+
+    if args.live:
+        hooks = _build_cli_hooks(args.disconnect_cmd, args.reconnect_cmd)
+        passed, report = run_live_composite_sequences(args.http_base, args.mc_log, args.th_log, hooks=hooks)
+        print(json.dumps(report, indent=2, ensure_ascii=False))
+        return 0 if passed else 1
+
+    suite = unittest.defaultTestLoader.loadTestsFromTestCase(TestCompositeLifecycleSequences)
+    result = unittest.TextTestRunner(verbosity=2).run(suite)
+    return 0 if result.wasSuccessful() else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
