+
+        th_missing_tx_290 = re.sub(r"\[TH-DBG\].*?dir=TX\s+node=TH\s+seq=290\s+.*?\r\n", "", th_log)
+        passed_th_tx, rep_th_tx = evaluate_burst_debug_logs(mc_log, th_missing_tx_290, expected_total_frames=290)
