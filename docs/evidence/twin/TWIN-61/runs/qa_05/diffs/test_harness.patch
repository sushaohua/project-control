+class _CompositeMockGatewayHandler(http.server.BaseHTTPRequestHandler):
+    """用于 `--self-test` 端到端验证 `run_live_composite_sequences` 的本地状态机网关处理器。"""
+
+    sim_state: Optional[_CompositeSimState] = None
+
+    def log_message(self, format_str: str, *args: object) -> None:
+        """静默标准错误日志。"""
+        return
+
+    def _send_json(self, status_code: int, payload: Dict[str, object]) -> None:
+        """发送带精确 Content-Length 的 JSON 响应。"""
+        raw = json.dumps(payload, separators=(",", ":")).encode("utf-8")
+        self.send_response(status_code)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(raw)))
+        self.send_header("Connection", "close")
+        self.end_headers()
+        self.wfile.write(raw)
+
+    def do_GET(self) -> None:
+        """处理复合序列 GET 请求（完全由状态机与单调时钟驱动）。"""
+        sim = self.sim_state
+        if sim is None:
+            self._send_json(500, {"error": 500})
+            return
+        if self.path == "/api/v1/system/versions":
+            self._send_json(200, {"mc_boot_id": sim.mc_boot_id, "th_boot_id": sim.th_boot_id})
+        elif self.path in ("/api/v1/state", "/api/v1/temperature/snapshot"):
+            self._send_json(200, sim.build_state_snapshot())
+        elif self.path == "/api/v1/calibration/status":
+            sim.append_mc("[MC-DBG] ts=1100 dir=STATE node=MC seq=12 cmd=0x18 status=OK op=GRID_READ probe_idx=7 z_offset_um=-42 grid_valid=1 status=DONE")
+            self._send_json(200, {"grid_valid": True})
+        elif self.path == "/api/v1/motion/position":
+            sim.append_mc("[MC-DBG] ts=1200 dir=STATE node=MC seq=14 cmd=0x16 status=OK op=POS_QUERY axes_mask=0x07 x_mm_x100=12500 y_mm_x100=8525 z_mm_x100=1000 feed=2400 homed_mask=0x07 motion_state=IDLE")
+            self._send_json(200, {"x_mm": 125.0, "y_mm": 85.25, "z_mm": 10.0})
+        else:
+            self._send_json(404, {"error": 404, "message": "Not Found"})
+
+    def do_POST(self) -> None:
+        """处理复合序列 POST 请求。"""
+        sim = self.sim_state
+        if sim is None:
+            self._send_json(500, {"error": 500})
+            return
+        length = int(self.headers.get("Content-Length", "0"))
+        raw_body = self.rfile.read(length).decode("utf-8", errors="replace") if length > 0 else "{}"
+        payload = json.loads(raw_body) if raw_body else {}
+        code, resp = _dispatch_sim_post(sim, self.path, payload)
+        self._send_json(code, resp)
+
+
+def _build_cli_hooks(disconnect_cmd: str, reconnect_cmd: str) -> Dict[str, object]:
+    """根据 CLI `--disconnect-cmd` 与 `--reconnect-cmd` 构造实机断链/重连与真实单调时钟钩子字典。"""
+    return {
+        "disconnect": lambda: subprocess.run(disconnect_cmd, shell=True, check=True),
+        "reconnect": lambda: subprocess.run(reconnect_cmd, shell=True, check=True),
+        "clock_fn": time.monotonic,
+        "sleep_fn": time.sleep,
+    }
+
+
