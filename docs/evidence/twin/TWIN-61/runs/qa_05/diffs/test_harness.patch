+    def test_run_live_composite_sequences_end_to_end_with_stateful_sim(self) -> None:
+        """验证 `run_live_composite_sequences` 配合步进时钟与断链/重连钩子完整跑通 SEQ-01..SEQ-05。"""
+        with tempfile.TemporaryDirectory() as tmpdir:
+            mc_path = Path(tmpdir) / "mc_composite.log"
+            th_path = Path(tmpdir) / "th_composite.log"
+            mc_path.write_text("", encoding="utf-8")
+            th_path.write_text("", encoding="utf-8")
+            sim = _CompositeSimState(mc_path, th_path)
+            _CompositeMockGatewayHandler.sim_state = sim
+
+            server = http.server.HTTPServer(("127.0.0.1", 0), _CompositeMockGatewayHandler)
+            port = server.server_port
+            thread = threading.Thread(target=server.serve_forever, daemon=True)
+            thread.start()
+            try:
+                passed, report = run_live_composite_sequences(
+                    f"http://127.0.0.1:{port}",
+                    mc_path,
+                    th_path,
+                    hooks={
+                        "disconnect": sim.disconnect_serial,
+                        "reconnect": sim.reconnect_serial,
+                        "clock_fn": sim.clock,
+                        "sleep_fn": sim.sleep,
+                    },
+                )
+            finally:
+                server.shutdown()
+                server.server_close()
+
+            self.assertTrue(passed, f"Composite sequence suite failed: {report}")
+            for key in ("SEQ-01", "SEQ-02", "SEQ-03", "SEQ-04", "SEQ-05"):
+                self.assertTrue(report[key], f"{key} failed in end-to-end composite HTTP suite")
