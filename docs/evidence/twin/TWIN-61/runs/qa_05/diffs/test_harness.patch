+def _drive_live_seq02(http_base: str, mc_log_path: Optional[Path]) -> bool:
+    """执行 SEQ-02：25点调平与坐标零截断校验 + 喷头 (`5, 210, 300°C`) 与热床 (`5, 60, 130°C`) 设温 + 越界 `400` + 归零 (`0°C`)。"""
+    _http_json_call(http_base, "POST", "/api/v1/motion/level", {"mode": "bed_level_25"})
+    _http_json_call(http_base, "GET", "/api/v1/calibration/status")
+    _http_json_call(http_base, "GET", "/api/v1/motion/position")
+    for nozzle_c in (5, 210, 300):
+        if _http_json_call(http_base, "POST", "/api/v1/temperature/set", {"tool_target_c": nozzle_c})[0] != 200:
+            return False
+    for bed_c in (5, 60, 130):
+        if _http_json_call(http_base, "POST", "/api/v1/temperature/set", {"bed_target_c": bed_c})[0] != 200:
+            return False
+    for bad_payload in (
+        {"tool_target_c": 4},
+        {"tool_target_c": 301},
+        {"bed_target_c": 4},
+        {"bed_target_c": 131},
+    ):
+        if _http_json_call(http_base, "POST", "/api/v1/temperature/set", bad_payload)[0] != 400:
+            return False
+    c_zero, _ = _http_json_call(http_base, "POST", "/api/v1/temperature/set", {"tool_target_c": 0, "bed_target_c": 0})
+    mc_text = mc_log_path.read_text(encoding="utf-8", errors="replace") if (mc_log_path and mc_log_path.exists()) else ""
+    motion_ok, _ = verify_seq02_homing_leveling_jog_and_pos_log(mc_text)
+    return bool(c_zero == 200 and motion_ok and "cmd=0x10" in mc_text)
+
