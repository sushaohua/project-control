+def build_minimc_v2_resp_frame(
+    src_id: int,
+    cmd_id: int,
+    seq: int,
+    payload: bytes = b"",
+) -> bytes:
+    """
+    构建一条发回给 AP (0x01) 的 MiniMCProto V2 二进制响应/ACK 帧。
+
+    :param src_id: 源节点 ID (0x02=MC, 0x03=TH)
+    :param cmd_id: 响应命令码
+    :param seq: 匹配的 16位无符号序列号
+    :param payload: 响应载荷字节流
+    :return: 完整二进制响应帧字节流
+    """
+    flags = MINIMC_FLAG_IS_RESPONSE | MINIMC_FLAG_PROTO_V2
+    header = struct.pack(
+        "<BBBBBBBBHH",
+        MINIMC_SOF_1,
+        MINIMC_SOF_2,
+        src_id & 0xFF,
+        MINIMC_NODE_AP,
+        flags & 0xFF,
+        cmd_id & 0xFF,
+        4,
+        0,
+        seq & 0xFFFF,
+        len(payload) & 0xFFFF,
+    )
+    body = header + payload
+    return body + struct.pack("<H", minimc_crc16(body))
+
