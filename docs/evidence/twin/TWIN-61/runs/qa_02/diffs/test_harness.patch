+def verify_seq01_oobe_bootid_and_adc_snapshot(
+    state_resp: Dict[str, object],
+    snapshot_resp: Dict[str, object],
+    boot_id_before_reset: Tuple[int, int],
+    boot_id_after_reset: Tuple[int, int],
+) -> Tuple[bool, str]:
+    """
+    校验复合序列 SEQ-01：
+    1. `/api/v1/state` 与 `/api/v1/temperature/snapshot` 动态同步（`ISS-006`）；
+    2. 复位前后 MC 与 TH 的 `boot_id` 均非零且发生变化（`ISS-016`）；
+    3. `bed` 与 `tool` 对象包含真实 `raw_adc` 字段（`ISS-012`）；
+    4. 若热床温度超出 `5~130°C`（如 `300.0°C`），必须被标记为 `FAULT` / `2147483647`（`ISS-011`）。
+
+    :param state_resp: `/api/v1/state` 返回的 JSON 字典
+    :param snapshot_resp: `/api/v1/temperature/snapshot` 返回的 JSON 字典
+    :param boot_id_before_reset: 复位前 (mc_boot_id, th_boot_id)
+    :param boot_id_after_reset: 复位后 (mc_boot_id, th_boot_id)
+    :return: (是否通过, 诊断说明)
+    """
+    if state_resp.get("system_status") != snapshot_resp.get("system_status"):
+        return False, "state and snapshot system_status mismatch"
+
+    mc_b1, th_b1 = boot_id_before_reset
+    mc_b2, th_b2 = boot_id_after_reset
+    if mc_b1 == 0 or th_b1 == 0 or mc_b2 == 0 or th_b2 == 0:
+        return False, "boot_id must be non-zero"
+    if mc_b1 == mc_b2 or th_b1 == th_b2:
+        return False, "boot_id did not change across hardware reset"
+
+    bed = snapshot_resp.get("bed")
+    tool = snapshot_resp.get("tool")
+    if not isinstance(bed, dict) or not isinstance(tool, dict):
+        return False, "missing bed or tool object in snapshot"
+    if "raw_adc" not in bed or "raw_adc" not in tool:
+        return False, "missing raw_adc field in bed or tool telemetry"
+
+    bed_millic = int(bed.get("temperature_millic", 0))
+    if bed_millic not in (AISOC_TEMP_MILLIC_FAULT, AISOC_TEMP_MILLIC_OFFLINE):
+        if bed_millic < AISOC_BED_VALID_MIN_MILLIC or bed_millic > AISOC_BED_VALID_MAX_MILLIC:
+            return False, f"out-of-range bed temperature {bed_millic} not downgraded to FAULT"
+    elif bed.get("quality") != "FAULT":
+        return False, "sentinel bed temperature must have quality=FAULT"
+
+    return True, "SEQ-01 verified"
+
+
+def verify_seq02_homing_leveling_jog_and_pos_log(mc_log_text: str) -> Tuple[bool, str]:
+    """
+    校验复合序列 SEQ-02：
+    三轴归零 (`0x11`) -> 调平触发 (`0x1A`) -> 网格读取 (`0x18`) -> XYZ 点动 (`0x12`) -> 坐标查询 (`0x16`)，
+    且 204B+ 的 `POS_QUERY` 日志行在 `MC_DBG_LINE_MAX_LEN=256U` 下零截断、无 `adc SS_ADC_BUSY`。
+
+    :param mc_log_text: MC 调试日志文本
+    :return: (是否通过, 诊断说明)
+    """
+    required_patterns = [
+        r"cmd=0x11\s+status=OK\s+op=HOME\s+axes_mask=0x07",
+        r"cmd=0x1A\s+status=ACK",
+        r"cmd=0x18\s+status=OK\s+op=GRID_READ\s+probe_idx=\d+\s+z_offset_um=-?\d+\s+grid_valid=1",
+        r"cmd=0x12\s+status=OK\s+op=MOVE",
+        r"cmd=0x16\s+status=OK\s+op=POS_QUERY",
+    ]
+    for pat in required_patterns:
+        if re.search(pat, mc_log_text) is None:
+            return False, f"missing expected MC-DBG pattern: {pat}"
+    if "SS_ADC_BUSY" in mc_log_text:
+        return False, "bare adc SS_ADC_BUSY pollution detected"
+    for line in mc_log_text.splitlines():
+        if line.endswith("..."):
+            return False, f"truncated MC-DBG line detected: {line}"
+    return True, "SEQ-02 verified"
+
+
+def _check_slots_weight_list(slots_obj: object) -> Tuple[bool, str]:
+    """
+    校验 `slots` 数组内单槽 `mixing_weight` 在 `[0, 10000]` 且总和等于 `10000`。
+
+    :param slots_obj: `slots` 字段值
+    :return: (是否合法, 错误原因)
+    """
+    if not isinstance(slots_obj, list) or len(slots_obj) == 0:
+        return False, "slots must be non-empty list"
+    weight_sum = 0
+    has_weights = False
+    for item in slots_obj:
+        if not isinstance(item, dict):
+            return False, "invalid slot item"
+        if "mixing_weight" in item:
+            has_weights = True
+            w = item["mixing_weight"]
+            if not isinstance(w, int) or w < 0 or w > 10000:
+                return False, "slot mixing_weight out of [0, 10000]"
+            weight_sum += w
+    if has_weights and weight_sum != 10000:
+        return False, f"slots mixing_weight sum {weight_sum} != 10000"
+    return True, "ok"
+
+
+def validate_seq03_filament_slots_contract(payload: Dict[str, object]) -> Tuple[int, str]:
+    """
+    校验复合序列 SEQ-03 的料槽与混色参数契约（对齐 `ui_gateway_server.cpp` `validate_filament_slots_body`）：
+    1. `slot_id` / `active_slot` 必须在 `1..4`；
+    2. `action` 必须在 `0..2` 或合法字符串 `select`/`load`/`unload`；
+    3. 单槽 `mixing_weight` 在 `[0, 10000]` 且权重总和严格等于 `10000`。
+
+    :param payload: `/api/v1/filament/slots` 请求字典
+    :return: (预期 HTTP 状态码, 说明)
+    """
+    for key in ("slot_id", "active_slot"):
+        if key in payload:
+            val = payload[key]
+            if not isinstance(val, int) or val < 1 or val > 4:
+                return 400, f"invalid {key}"
+
+    if "action" in payload:
+        act = payload["action"]
+        if isinstance(act, int):
+            if act < 0 or act > 2:
+                return 400, "invalid numeric action"
+        elif isinstance(act, str):
+            if act.lower() not in ("select", "load", "unload"):
+                return 400, "invalid string action"
+        else:
+            return 400, "invalid action type"
+
+    if "total_mixing_weight" in payload and payload["total_mixing_weight"] != 10000:
+        return 400, "total_mixing_weight must equal 10000"
+
+    if "slots" in payload:
+        ok_slots, reason = _check_slots_weight_list(payload["slots"])
+        if not ok_slots:
+            return 400, reason
+
+    return 200, "valid filament slots payload"
+
+
+def validate_seq04_gcode_upload_and_two_stage_job(
+    upload_payload: Dict[str, object],
+    explicit_start_clicked: bool,
+) -> Tuple[int, str, str]:
+    """
+    校验复合序列 SEQ-04 的 G-code 上传准入与模型载入/开始打印两阶段解耦契约（`ISS-008` / `ISS-009`）：
+    1. 校验 `.gcode`/`.gco`/`.nc` 扩展名；
+    2. 若 `preset=True`，模型名必须在预置白名单中；否则 `size > 0` 且 `content` 至少包含一条有效 G/M/T 指令；
+    3. 仅载入/上传成功且 `explicit_start_clicked=False` 时，作业状态必须保持 `IDLE`。
+
+    :param upload_payload: `/api/v1/jobs/upload` 请求字典
+    :param explicit_start_clicked: 用户是否显式点击了 `#btn-job-start`
+    :return: (HTTP 状态码, 作业状态, 说明)
+    """
+    name = str(upload_payload.get("name", ""))
+    lower_name = name.lower()
+    if not (lower_name.endswith(".gcode") or lower_name.endswith(".gco") or lower_name.endswith(".nc")):
+        return 400, "IDLE", "invalid file extension"
+
+    if bool(upload_payload.get("preset", False)):
+        if name not in PRESET_MODELS:
+            return 400, "IDLE", "unknown preset model"
+    else:
+        size = int(upload_payload.get("size", 0))
+        content = str(upload_payload.get("content", ""))
+        if size <= 0 or VALID_GCODE_REGEX.search(content) is None:
+            return 400, "IDLE", "empty or non-gcode content"
+
+    job_state = "PRINTING" if explicit_start_clicked else "IDLE"
+    return 200, job_state, "upload staged"
+
+
+def verify_seq05_estop_offline_degradation_and_404_framing(
+    elapsed_offline_ms: int,
+    snapshot_after_disconnect: Dict[str, object],
+    raw_404_http_response: bytes,
+) -> Tuple[bool, str]:
+    """
+    校验复合序列 SEQ-05：
+    1. 断链 `elapsed_offline_ms >= 3000` 时，`device_state == "OFFLINE"` 且温度打入离线哨兵 `2147483646`（`ISS-014`）；
+    2. 未知路由 HTTP 404 响应头声明的 `Content-Length` 与实际 JSON 正文字节长度 100% 相等（`ISS-017`）。
+
+    :param elapsed_offline_ms: 断链持续毫秒数
+    :param snapshot_after_disconnect: 断链后获取的快照字典
+    :param raw_404_http_response: 未知 API 路由返回的原始 HTTP 字节流
+    :return: (是否通过, 诊断说明)
+    """
+    if elapsed_offline_ms >= AISOC_FRESHNESS_FAULT_MS:
+        if snapshot_after_disconnect.get("device_state") != "OFFLINE":
+            return False, "device_state did not degrade to OFFLINE within 3000ms"
+        bed = snapshot_after_disconnect.get("bed", {})
+        tool = snapshot_after_disconnect.get("tool", {})
+        if isinstance(bed, dict) and bed.get("temperature_millic") != AISOC_TEMP_MILLIC_OFFLINE:
+            return False, "bed temperature_millic not set to AISOC_TEMP_MILLIC_OFFLINE (2147483646)"
+        if isinstance(tool, dict) and tool.get("temperature_millic") != AISOC_TEMP_MILLIC_OFFLINE:
+            return False, "tool temperature_millic not set to AISOC_TEMP_MILLIC_OFFLINE (2147483646)"
+
+    header_end = raw_404_http_response.find(b"\r\n\r\n")
+    if header_end < 0:
+        return False, "malformed HTTP 404 response headers"
+    headers_text = raw_404_http_response[:header_end].decode("utf-8", errors="replace")
+    body_bytes = raw_404_http_response[header_end + 4 :]
+    m_len = re.search(r"Content-Length:\s*(\d+)", headers_text, re.IGNORECASE)
+    if m_len is None:
+        return False, "missing Content-Length header in 404 response"
+    if int(m_len.group(1)) != len(body_bytes):
+        return False, "404 Content-Length mismatch"
+    if body_bytes != b'{"error":404,"message":"Not Found"}':
+        return False, f"unexpected 404 JSON body: {body_bytes!r}"
+    return True, "SEQ-05 verified"
+
+
+def _http_json_call(
+    http_base: str, method: str, route: str, payload: Optional[Dict[str, object]] = None
+) -> Tuple[int, Dict[str, object]]:
+    """
+    向指定 HTTP 网关发起 JSON 请求并返回 `(status_code, parsed_json)`。
+
+    :param http_base: 网关基础 URL
+    :param method: HTTP 方法 (`GET` 或 `POST`)
+    :param route: API 路由路径
+    :param payload: 可选 JSON 请求字典
+    :return: (HTTP 状态码, 响应 JSON 字典)
+    """
+    body = json.dumps(payload).encode("utf-8") if payload is not None else None
+    headers = {"Content-Type": "application/json"} if body is not None else {}
+    req = urllib.request.Request(f"{http_base.rstrip('/')}{route}", data=body, method=method, headers=headers)
+    try:
+        with urllib.request.urlopen(req, timeout=2.0) as resp:
+            raw = resp.read().decode("utf-8", errors="replace")
+            return resp.status, (json.loads(raw) if raw else {})
+    except urllib.error.HTTPError as err:
+        raw = err.read().decode("utf-8", errors="replace")
+        try:
+            parsed = json.loads(raw) if raw else {}
+        except ValueError:
+            parsed = {"raw": raw}
+        return err.code, parsed
+
+
+def _fetch_raw_http_response(http_base: str, route: str) -> bytes:
+    """
+    使用原生 TCP Socket 获取未知路由的完整原始 HTTP 响应字节流（用于核验 404 Content-Length 帧完整性）。
+
+    :param http_base: 网关基础 URL
+    :param route: 请求路径
+    :return: 原始 HTTP 响应字节流
+    """
+    parsed = urllib.parse.urlparse(http_base)
+    host = parsed.hostname or "127.0.0.1"
+    port = parsed.port or 80
+    with socket.create_connection((host, port), timeout=2.0) as sock:
+        req = f"GET {route} HTTP/1.1\r\nHost: {host}:{port}\r\nConnection: close\r\n\r\n"
+        sock.sendall(req.encode("utf-8"))
+        chunks: List[bytes] = []
+        while True:
+            data = sock.recv(4096)
+            if not data:
+                break
+            chunks.append(data)
+        return b"".join(chunks)
+
+
+def _drive_seq01_and_seq02_http(http_base: str, mc_log_path: Optional[Path]) -> Tuple[bool, bool]:
+    """
+    通过 HTTP 驱动 SEQ-01（版本/状态/快照与复位后 boot_id 对账）与 SEQ-02（归零/调平/点动/位置查询）。
+
+    :param http_base: 网关基础 URL
+    :param mc_log_path: MC 调试日志路径
+    :return: (seq01_ok, seq02_ok)
+    """
+    _, ver1 = _http_json_call(http_base, "GET", "/api/v1/system/versions")
+    _, state_resp = _http_json_call(http_base, "GET", "/api/v1/state")
+    _, snap_resp = _http_json_call(http_base, "GET", "/api/v1/temperature/snapshot")
+    _, ver2 = _http_json_call(http_base, "GET", "/api/v1/system/versions?after_reset=1")
+    b1 = (int(ver1.get("mc_boot_id", 0)), int(ver1.get("th_boot_id", 0)))
+    b2 = (int(ver2.get("mc_boot_id", 0)), int(ver2.get("th_boot_id", 0)))
+    seq01_ok, _ = verify_seq01_oobe_bootid_and_adc_snapshot(state_resp, snap_resp, b1, b2)
+
+    _http_json_call(http_base, "POST", "/api/v1/motion/home", {"axes": ["X", "Y", "Z"]})
+    _http_json_call(http_base, "POST", "/api/v1/calibration/start", {"mode": "bed_level_25"})
+    _http_json_call(http_base, "GET", "/api/v1/calibration/status")
+    _http_json_call(http_base, "POST", "/api/v1/motion/jog", {"axis": "X", "distance_mm": 10.0, "feedrate": 1500})
+    _http_json_call(http_base, "GET", "/api/v1/motion/position")
+    mc_text = mc_log_path.read_text(encoding="utf-8", errors="replace") if (mc_log_path and mc_log_path.exists()) else ""
+    seq02_ok, _ = verify_seq02_homing_leveling_jog_and_pos_log(mc_text)
+    return seq01_ok, seq02_ok
+
+
+def _drive_seq03_seq04_seq05_http(http_base: str) -> Tuple[bool, bool, bool]:
+    """
+    通过 HTTP 驱动 SEQ-03（料槽配置与 400 校验）、SEQ-04（G-code 上传两阶段启动与 400 校验）与 SEQ-05（急停、离线哨兵与 404 帧）。
+
+    :param http_base: 网关基础 URL
+    :return: (seq03_ok, seq04_ok, seq05_ok)
+    """
+    c_ok, _ = _http_json_call(
+        http_base,
+        "POST",
+        "/api/v1/filament/slots",
+        {"active_slot": 1, "action": 0, "target_temp_deci_c": 0, "total_mixing_weight": 10000},
+    )
+    c_bad, _ = _http_json_call(http_base, "POST", "/api/v1/filament/slots", {"total_mixing_weight": 9999})
+    seq03_ok = (c_ok == 200 and c_bad == 400)
+
+    u_bad, _ = _http_json_call(
+        http_base, "POST", "/api/v1/jobs/upload", {"name": "bad.gcode", "size": 12, "content": "hello world\n"}
+    )
+    u_ok, up_body = _http_json_call(
+        http_base, "POST", "/api/v1/jobs/upload", {"name": "Calibration_Cube.gcode", "preset": True}
+    )
+    s_ok, start_body = _http_json_call(http_base, "POST", "/api/v1/jobs/start", {})
+    seq04_ok = (
+        u_bad == 400
+        and u_ok == 200
+        and up_body.get("job_state") == "IDLE"
+        and s_ok == 200
+        and start_body.get("job_state") == "PRINTING"
+    )
+
+    _http_json_call(http_base, "POST", "/api/v1/system/estop", {})
+    _, off_snap = _http_json_call(http_base, "GET", "/api/v1/temperature/snapshot?simulate_offline_ms=3200")
+    raw_404 = _fetch_raw_http_response(http_base, "/api/v1/unknown_route_404")
+    seq05_ok, _ = verify_seq05_estop_offline_degradation_and_404_framing(3200, off_snap, raw_404)
+    return seq03_ok, seq04_ok, seq05_ok
+
+
+def run_live_composite_sequences(
+    http_base: str, mc_log_path: Optional[Path] = None
+) -> Tuple[bool, Dict[str, object]]:
+    """
+    针对目标 HTTP 网关端到端执行 SEQ-01 ~ SEQ-05 五类复合业务序列并汇总四方对账结果。
+
+    :param http_base: 网关基础地址，如 `http://192.168.77.134:8080`
+    :param mc_log_path: MC 调试日志文件路径
+    :return: (是否全部通过, 序列执行报告字典)
+    """
+    seq01_ok, seq02_ok = _drive_seq01_and_seq02_http(http_base, mc_log_path)
+    seq03_ok, seq04_ok, seq05_ok = _drive_seq03_seq04_seq05_http(http_base)
+    passed = bool(seq01_ok and seq02_ok and seq03_ok and seq04_ok and seq05_ok)
+    return passed, {
+        "SEQ-01": seq01_ok,
+        "SEQ-02": seq02_ok,
+        "SEQ-03": seq03_ok,
+        "SEQ-04": seq04_ok,
+        "SEQ-05": seq05_ok,
+        "passed": passed,
+    }
+
+
+class _CompositeMockGatewayHandler(http.server.BaseHTTPRequestHandler):
+    """用于 `--self-test` 端到端验证 `run_live_composite_sequences` 的本地 HTTP 网关模拟处理器。"""
+
+    mc_log_file: Optional[Path] = None
+
+    def log_message(self, format_str: str, *args: object) -> None:
+        """静默标准错误日志。"""
+        return
+
+    def _send_json(self, status_code: int, payload: Dict[str, object]) -> None:
+        """发送带精确 Content-Length 的 JSON 响应。"""
+        raw = json.dumps(payload, separators=(",", ":")).encode("utf-8")
+        self.send_response(status_code)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(raw)))
+        self.send_header("Connection", "close")
+        self.end_headers()
+        self.wfile.write(raw)
+
+    def do_GET(self) -> None:
+        """处理复合序列 GET 请求。"""
+        if self.path.startswith("/api/v1/system/versions"):
+            after = "after_reset=1" in self.path
+            self._send_json(200, {"mc_boot_id": 0x11223345 if after else 0x11223344, "th_boot_id": 0x55667789 if after else 0x55667788})
+        elif self.path == "/api/v1/state":
+            self._send_json(200, {"system_status": "READY", "device_state": "READY"})
+        elif self.path.startswith("/api/v1/temperature/snapshot"):
+            if "simulate_offline_ms=3200" in self.path:
+                self._send_json(
+                    200,
+                    {
+                        "system_status": "OFFLINE",
+                        "device_state": "OFFLINE",
+                        "bed": {"temperature_millic": AISOC_TEMP_MILLIC_OFFLINE, "raw_adc": 4095, "quality": "FAULT"},
+                        "tool": {"temperature_millic": AISOC_TEMP_MILLIC_OFFLINE, "raw_adc": 4095, "quality": "FAULT"},
+                    },
+                )
+            else:
+                self._send_json(
+                    200,
+                    {
+                        "system_status": "READY",
+                        "device_state": "READY",
+                        "bed": {"temperature_millic": 60000, "raw_adc": 3120, "quality": "FRESH"},
+                        "tool": {"temperature_millic": 200000, "raw_adc": 1850, "quality": "FRESH"},
+                    },
+                )
+        elif self.path in ("/api/v1/calibration/status", "/api/v1/motion/position"):
+            self._send_json(200, {"ok": True})
+        else:
+            self._send_json(404, {"error": 404, "message": "Not Found"})
+
+    def do_POST(self) -> None:
+        """处理复合序列 POST 请求并按路由执行契约校验与日志追加。"""
+        length = int(self.headers.get("Content-Length", "0"))
+        raw_body = self.rfile.read(length).decode("utf-8", errors="replace") if length > 0 else "{}"
+        payload = json.loads(raw_body) if raw_body else {}
+        if self.path == "/api/v1/filament/slots":
+            code, msg = validate_seq03_filament_slots_contract(payload)
+            self._send_json(code, {"message": msg})
+        elif self.path == "/api/v1/jobs/upload":
+            code, state, msg = validate_seq04_gcode_upload_and_two_stage_job(payload, explicit_start_clicked=False)
+            self._send_json(code, {"job_state": state, "message": msg})
+        elif self.path == "/api/v1/jobs/start":
+            self._send_json(200, {"job_state": "PRINTING"})
+        elif self.path in ("/api/v1/motion/home", "/api/v1/calibration/start", "/api/v1/motion/jog", "/api/v1/system/estop"):
+            if self.path == "/api/v1/motion/jog" and self.mc_log_file:
+                self.mc_log_file.write_text(
+                    "[MC-DBG] ts=1000 dir=STATE node=MC seq=10 cmd=0x11 status=OK op=HOME axes_mask=0x07 x_mm_x100=0 y_mm_x100=0 z_mm_x100=0 feed=1500 homed_mask=0x07 motion_state=IDLE\r\n"
+                    "[MC-DBG] ts=1050 dir=TX node=MC seq=11 cmd=0x1A status=ACK op=LEVEL_TRIGGER grid_valid=1 status=DONE\r\n"
+                    "[MC-DBG] ts=1100 dir=STATE node=MC seq=12 cmd=0x18 status=OK op=GRID_READ probe_idx=7 z_offset_um=-42 grid_valid=1 status=DONE\r\n"
+                    "[MC-DBG] ts=1150 dir=STATE node=MC seq=13 cmd=0x12 status=OK op=MOVE axes_mask=0x07 x_mm_x100=12500 y_mm_x100=8525 z_mm_x100=1000 feed=2400 homed_mask=0x07 motion_state=MOVING\r\n"
+                    "[MC-DBG] ts=1200 dir=STATE node=MC seq=14 cmd=0x16 status=OK op=POS_QUERY axes_mask=0x07 x_mm_x100=12500 y_mm_x100=8525 z_mm_x100=1000 feed=2400 homed_mask=0x07 motion_state=IDLE\r\n",
+                    encoding="utf-8",
+                )
+            self._send_json(200, {"ok": True})
+        else:
+            self._send_json(404, {"error": 404, "message": "Not Found"})
+
+
+class TestCompositeLifecycleSequences(unittest.TestCase):
+    """TWIN-61 5类复合业务序列（SEQ-01 ~ SEQ-05）正反例自动化验证套件。"""
+
+    def test_seq01_oobe_bootid_adc_and_bed_range_gate(self) -> None:
+        """验证 SEQ-01：动态 boot_id 变化、raw_adc 映射及 300°C 热床超量程故障降级。"""
+        snap_ok = {
+            "system_status": "DEGRADED",
+            "device_state": "DEGRADED",
+            "bed": {
+                "temperature_millic": AISOC_TEMP_MILLIC_FAULT,
+                "temperature_c": None,
+                "raw_adc": 4092,
+                "sensor_status": "OPEN",
+                "quality": "FAULT",
+            },
+            "tool": {
+                "temperature_millic": 24500,
+                "temperature_c": 24.5,
+                "raw_adc": 3911,
+                "sensor_status": "OK",
+                "quality": "FRESH",
+            },
+        }
+        ok, msg = verify_seq01_oobe_bootid_and_adc_snapshot(
+            snap_ok, snap_ok, (0x11223344, 0x55667788), (0x11223345, 0x55667789)
+        )
+        self.assertTrue(ok, msg)
+
+        ok_same_boot, _ = verify_seq01_oobe_bootid_and_adc_snapshot(
+            snap_ok, snap_ok, (0x01020304, 0x8877AA55), (0x01020304, 0x8877AA55)
+        )
+        self.assertFalse(ok_same_boot)
+
+        snap_bad_bed = json.loads(json.dumps(snap_ok))
+        snap_bad_bed["bed"]["temperature_millic"] = 300000
+        snap_bad_bed["bed"]["quality"] = "FRESH"
+        ok_bad_bed, _ = verify_seq01_oobe_bootid_and_adc_snapshot(
+            snap_bad_bed, snap_bad_bed, (0x11, 0x22), (0x33, 0x44)
+        )
+        self.assertFalse(ok_bad_bed)
+
+    def test_seq02_motion_homing_leveling_jog_and_no_trunc(self) -> None:
+        """验证 SEQ-02：归零 -> 调平 -> 点动 -> 204B 坐标查询零截断闭环。"""
+        mc_log = (
+            "[MC-DBG] ts=1000 dir=STATE node=MC seq=10 cmd=0x11 status=OK op=HOME axes_mask=0x07 x_mm_x100=0 y_mm_x100=0 z_mm_x100=0 feed=1500 homed_mask=0x07 motion_state=IDLE\r\n"
+            "[MC-DBG] ts=1050 dir=TX node=MC seq=11 cmd=0x1A status=ACK op=LEVEL_TRIGGER grid_valid=1 status=DONE\r\n"
+            "[MC-DBG] ts=1100 dir=STATE node=MC seq=12 cmd=0x18 status=OK op=GRID_READ probe_idx=7 z_offset_um=-42 grid_valid=1 status=DONE\r\n"
+            "[MC-DBG] ts=1150 dir=STATE node=MC seq=13 cmd=0x12 status=OK op=MOVE axes_mask=0x07 x_mm_x100=12500 y_mm_x100=8525 z_mm_x100=1000 feed=2400 homed_mask=0x07 motion_state=MOVING\r\n"
+            "[MC-DBG] ts=1200 dir=STATE node=MC seq=14 cmd=0x16 status=OK op=POS_QUERY axes_mask=0x07 x_mm_x100=12500 y_mm_x100=8525 z_mm_x100=1000 feed=2400 homed_mask=0x07 motion_state=IDLE\r\n"
+        )
+        ok, msg = verify_seq02_homing_leveling_jog_and_pos_log(mc_log)
+        self.assertTrue(ok, msg)
+
+        ok_trunc, _ = verify_seq02_homing_leveling_jog_and_pos_log(mc_log + "[MC-DBG] ...\r\n")
+        self.assertFalse(ok_trunc)
+
+    def test_seq03_filament_save_decoupling_and_400_validation(self) -> None:
+        """验证 SEQ-03：保存配置固定 action=0/target=0，非法权重/槽位/动作返回 400。"""
+        code_ok, _ = validate_seq03_filament_slots_contract(
+            {
+                "active_slot": 1,
+                "action": 0,
+                "target_temp_deci_c": 0,
+                "total_mixing_weight": 10000,
+                "slots": [
+                    {"slot_id": 1, "mixing_weight": 5000},
+                    {"slot_id": 2, "mixing_weight": 5000},
+                ],
+            }
+        )
+        self.assertEqual(code_ok, 200)
+        self.assertEqual(validate_seq03_filament_slots_contract({"total_mixing_weight": 9999})[0], 400)
+        self.assertEqual(
+            validate_seq03_filament_slots_contract(
+                {"total_mixing_weight": 10000, "slots": [{"mixing_weight": -1}, {"mixing_weight": 10001}]}
+            )[0],
+            400,
+        )
+        self.assertEqual(validate_seq03_filament_slots_contract({"slot_id": 5})[0], 400)
+        self.assertEqual(validate_seq03_filament_slots_contract({"action": -1})[0], 400)
+        self.assertEqual(validate_seq03_filament_slots_contract({"action": 3})[0], 400)
+
+    def test_seq04_gcode_upload_and_two_stage_job_start(self) -> None:
+        """验证 SEQ-04：非法 G-code 上传返回 400，一键载入仅暂存不进入 PRINTING。"""
+        code_pre, state_pre, _ = validate_seq04_gcode_upload_and_two_stage_job(
+            {"name": "Calibration_Cube.gcode", "preset": True}, explicit_start_clicked=False
+        )
+        self.assertEqual(code_pre, 200)
+        self.assertEqual(state_pre, "IDLE")
+
+        code_start, state_start, _ = validate_seq04_gcode_upload_and_two_stage_job(
+            {"name": "Calibration_Cube.gcode", "preset": True}, explicit_start_clicked=True
+        )
+        self.assertEqual(code_start, 200)
+        self.assertEqual(state_start, "PRINTING")
+
+        self.assertEqual(
+            validate_seq04_gcode_upload_and_two_stage_job(
+                {"name": "invalid.txt", "size": 19, "content": "G28\n"}, False
+            )[0],
+            400,
+        )
+        self.assertEqual(
+            validate_seq04_gcode_upload_and_two_stage_job(
+                {"name": "invalid.gcode", "size": 19, "content": "hello world\n"}, False
+            )[0],
+            400,
+        )
+        self.assertEqual(
+            validate_seq04_gcode_upload_and_two_stage_job(
+                {"name": "empty.gcode", "size": 0, "content": ""}, False
+            )[0],
+            400,
+        )
+
+    def test_seq05_offline_3s_sentinel_and_404_framing(self) -> None:
+        """验证 SEQ-05：断链 >=3.0s 打入 2147483646 离线哨兵，未知路由 404 Content-Length 完整。"""
+        offline_snap = {
+            "system_status": "OFFLINE",
+            "device_state": "OFFLINE",
+            "bed": {"temperature_millic": AISOC_TEMP_MILLIC_OFFLINE, "quality": "FAULT"},
+            "tool": {"temperature_millic": AISOC_TEMP_MILLIC_OFFLINE, "quality": "FAULT"},
+        }
+        raw_404 = (
+            b"HTTP/1.1 404 Not Found\r\n"
+            b"Content-Type: application/json\r\n"
+            b"Content-Length: 35\r\n"
+            b"Connection: close\r\n\r\n"
+            b'{"error":404,"message":"Not Found"}'
+        )
+        ok, msg = verify_seq05_estop_offline_degradation_and_404_framing(3200, offline_snap, raw_404)
+        self.assertTrue(ok, msg)
+
+        truncated_404 = b"HTTP/1.1 404 Not Found\r\nContent-Length: 35\r\n\r\n{\"er"
+        ok_trunc, _ = verify_seq05_estop_offline_degradation_and_404_framing(3200, offline_snap, truncated_404)
+        self.assertFalse(ok_trunc)
+
+    def test_run_live_composite_sequences_end_to_end_with_mock_server(self) -> None:
+        """验证 `run_live_composite_sequences` 通过本地 Mock HTTP Server 端到端驱动 SEQ-01..SEQ-05 闭环通过。"""
+        with tempfile.TemporaryDirectory() as tmpdir:
+            mc_path = Path(tmpdir) / "mc_composite.log"
+            mc_path.write_text("", encoding="utf-8")
+            _CompositeMockGatewayHandler.mc_log_file = mc_path
+
+            server = http.server.HTTPServer(("127.0.0.1", 0), _CompositeMockGatewayHandler)
+            port = server.server_port
+            thread = threading.Thread(target=server.serve_forever, daemon=True)
+            thread.start()
+            try:
+                passed, report = run_live_composite_sequences(f"http://127.0.0.1:{port}", mc_path)
+            finally:
+                server.shutdown()
+                server.server_close()
+
+            self.assertTrue(passed)
+            for key in ("SEQ-01", "SEQ-02", "SEQ-03", "SEQ-04", "SEQ-05"):
+                self.assertTrue(report[key], f"{key} failed in end-to-end composite HTTP suite")
+
+
+def main() -> int:
+    """命令行主入口：支持 `--self-test` 或 `--live` 运行全部 5 类复合业务序列验证。"""
+    parser = argparse.ArgumentParser(description="TWIN-61 5类复合业务序列自动化验证套件")
+    parser.add_argument("--self-test", action="store_true", help="运行内置 5 类复合序列正反例与端到端 HTTP 自检")
+    parser.add_argument("--live", action="store_true", help="针对指定网关 URL 执行端到端复合业务序列验证")
+    parser.add_argument("--http-base", type=str, default="http://192.168.77.134:8080", help="实机网关 URL")
+    parser.add_argument("--mc-log", type=Path, default=None, help="MC 调试日志路径")
+    args = parser.parse_args()
+
+    if args.live:
+        passed, report = run_live_composite_sequences(args.http_base, args.mc_log)
+        print(json.dumps(report, indent=2, ensure_ascii=False))
+        return 0 if passed else 1
+
+    suite = unittest.defaultTestLoader.loadTestsFromTestCase(TestCompositeLifecycleSequences)
+    result = unittest.TextTestRunner(verbosity=2).run(suite)
+    return 0 if result.wasSuccessful() else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
