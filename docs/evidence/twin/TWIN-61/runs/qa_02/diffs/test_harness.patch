+    def test_evaluate_burst_debug_logs_rejects_8bit_wrap_and_adc_pollution(self) -> None:
+        """验证反例：当发生 8-bit 序列号回绕、裸 `adc SS_ADC_BUSY` 污染、TIMEOUT 或长行 `...` 截断时严格拦截。"""
