+        passed_wrap, rep_wrap = evaluate_burst_debug_logs(mc_wrapped, th_log, expected_total_frames=290)
+        self.assertFalse(passed_wrap)
+        self.assertIn(290, rep_wrap["missing_high_seqs_256_plus"])
+
+    def test_run_live_http_burst_end_to_end_with_mock_server(self) -> None:
