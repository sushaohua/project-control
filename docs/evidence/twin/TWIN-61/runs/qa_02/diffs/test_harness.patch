+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""
+@file test_290_frame_burst_stress.py
+@brief TWIN-61 (ISS-20261105-005 / DELTA-BAUD-BURST-290) 290帧高频突发压测与16位序列号/零截断对账套件。
+
+本脚本固化 `hil_full_acceptance_master_plan_20261105.md` §4 定义的 290 帧突发压测规格：
+1. 生成覆盖 seq=1..290（跨越 8-bit 255->256 边界）的 29 个均衡业务周期（共 290 帧）真实 MiniMCProto V2 二进制协议帧；
+2. 支持 `--live` 模式驱动 290 帧 HTTP 业务请求并直接调用 `evaluate_burst_debug_logs` 对 `[MC-DBG]`/`[TH-DBG]` 原始日志流执行四方对账；
+3. 支持 `--self-test` 与 `unittest` 模式验证正例（含本地 Mock HTTP Server 290 帧端到端驱动对账）、seq=256..290 无截断、
+   TIMEOUT=0、CRC_ERR=0、BAD_FRAME=0、drop_delta=0、trunc_delta=0 与反例拦截。
+"""
+
+import argparse
+import http.server
+import json
+import re
+import struct
+import sys
+import tempfile
+import threading
+import time
+import unittest
+import urllib.error
+import urllib.request
+from pathlib import Path
+from typing import Dict, List, Optional, Tuple
+
+
+# MiniMCProto V2 协议常量定义
+MINIMC_SOF_1 = 0x55
+MINIMC_SOF_2 = 0xAA
+MINIMC_NODE_AP = 0x01
+MINIMC_NODE_MC = 0x02
+MINIMC_NODE_TH = 0x03
+MINIMC_FLAG_WANTS_ACK = 0x01
+MINIMC_FLAG_IS_RESPONSE = 0x02
+MINIMC_FLAG_PROTO_V2 = 0x04
+
+MINIMC_CMD_GET_VERSION = 0x01
+MINIMC_CMD_VERSION_REPORT = 0x02
+MINIMC_CMD_PING = 0x03
+MINIMC_CMD_PONG = 0x04
+MINIMC_CMD_GET_TEMP = 0x14
+MINIMC_CMD_POS_QUERY = 0x16
+MINIMC_CMD_LEVEL_GRID_QUERY = 0x18
+MINIMC_CMD_SLOT_SELECT = 0x19
+MINIMC_CMD_GCODE_EXEC = 0x1C
+
+
+def minimc_crc16(data: bytes) -> int:
+    """
+    计算 MiniMCProto V2 帧头与载荷的 CRC16-CCITT (多项式 0x1021，初值 0xFFFF)。
+
+    :param data: 待计算字节序列
+    :return: 16位无符号 CRC 校验值
+    """
+    crc = 0xFFFF
+    for byte in data:
+        crc ^= (byte << 8) & 0xFFFF
+        for _ in range(8):
+            if (crc & 0x8000) != 0:
+                crc = ((crc << 1) ^ 0x1021) & 0xFFFF
+            else:
+                crc = (crc << 1) & 0xFFFF
+    return crc
+
+
+def build_minimc_v2_frame(
+    src_id: int,
+    dst_id: int,
+    cmd_id: int,
+    seq: int,
+    payload: bytes = b"",
+    is_response: bool = False,
+) -> bytes:
+    """
+    构建一条带完整 12 字节帧头与尾随小端 CRC16 的 MiniMCProto V2 二进制协议帧。
+
+    :param src_id: 源节点 ID (0x01=AP, 0x02=MC, 0x03=TH)
+    :param dst_id: 目标节点 ID
+    :param cmd_id: 命令码
+    :param seq: 16位无符号序列号 (1..65535)
+    :param payload: 业务载荷字节流
+    :param is_response: 是否为响应帧
+    :return: 完整二进制帧字节流
+    """
+    flags = (MINIMC_FLAG_IS_RESPONSE if is_response else MINIMC_FLAG_WANTS_ACK) | MINIMC_FLAG_PROTO_V2
+    header = struct.pack(
+        "<BBBBBBBBHH",
+        MINIMC_SOF_1,
+        MINIMC_SOF_2,
+        src_id & 0xFF,
+        dst_id & 0xFF,
+        flags & 0xFF,
+        cmd_id & 0xFF,
+        4,
+        0,
+        seq & 0xFFFF,
+        len(payload) & 0xFFFF,
+    )
+    body = header + payload
+    return body + struct.pack("<H", minimc_crc16(body))
+
+
+def _build_single_burst_spec(seq: int) -> Tuple[int, int, bytes, str, str, str]:
+    """
+    根据序列号 `seq` (1..290) 构造单帧协议参数与对应的 HTTP 路由/方法。
+
+    :param seq: 16位递增序列号 (1..290)
+    :return: (dst, cmd, payload, desc, http_method, http_route)
+    """
+    offset = (seq - 1) % 10
+    table = {
+        0: (MINIMC_NODE_MC, MINIMC_CMD_GET_VERSION, b"", "MC_GET_VERSION", "GET", "/api/v1/system/versions"),
+        1: (MINIMC_NODE_TH, MINIMC_CMD_GET_VERSION, b"", "TH_GET_VERSION", "GET", "/api/v1/system/versions"),
+        2: (MINIMC_NODE_MC, MINIMC_CMD_PING, struct.pack("<I", seq * 20), "MC_PING", "GET", "/api/v1/state"),
+        3: (MINIMC_NODE_TH, MINIMC_CMD_PING, struct.pack("<I", seq * 20), "TH_PING", "GET", "/api/v1/state"),
+        4: (MINIMC_NODE_MC, MINIMC_CMD_GET_TEMP, b"", "MC_GET_TEMP", "POST", "/api/v1/temperature/sample"),
+        5: (MINIMC_NODE_TH, MINIMC_CMD_GET_TEMP, b"", "TH_GET_TEMP", "POST", "/api/v1/temperature/sample"),
+        6: (MINIMC_NODE_MC, MINIMC_CMD_POS_QUERY, b"", "MC_POS_QUERY", "GET", "/api/v1/motion/position"),
+        7: (MINIMC_NODE_MC, MINIMC_CMD_LEVEL_GRID_QUERY, bytes([seq % 25]), "MC_GRID_QUERY", "GET", "/api/v1/calibration/status"),
+        8: (MINIMC_NODE_MC, MINIMC_CMD_SLOT_SELECT, bytes([seq % 4, 0, 0]), "MC_TH_SLOT_SELECT", "POST", "/api/v1/filament/slots"),
+    }
+    if offset in table:
+        return table[offset]
+    gcode = b"M114"
+    pay = struct.pack("<BB", len(gcode), 0) + gcode
+    return (MINIMC_NODE_MC, MINIMC_CMD_GCODE_EXEC, pay, "MC_TH_GCODE_M114", "GET", "/api/v1/motion/position")
+
+
+def generate_290_burst_plan() -> List[Dict[str, object]]:
+    """
+    按 `hil_full_acceptance_master_plan_20261105.md` §4.1 生成 290 帧突发压测向量清单。
+    共 29 个周期 × 10 种业务帧 = 290 帧，序列号严格覆盖 1..290。
+
+    :return: 290 条突发帧规格字典列表
+    """
+    specs: List[Dict[str, object]] = []
+    for idx in range(290):
+        seq = idx + 1
+        dst, cmd, pay, desc, method, route = _build_single_burst_spec(seq)
+        wire = build_minimc_v2_frame(MINIMC_NODE_AP, dst, cmd, seq, pay, is_response=False)
+        specs.append(
+            {
+                "seq": seq,
+                "dst": dst,
+                "cmd": cmd,
+                "desc": desc,
+                "http_method": method,
+                "http_route": route,
+                "payload_hex": pay.hex(),
+                "wire_hex": wire.hex(),
+                "wire_len": len(wire),
+            }
+        )
+    return specs
+
+
+def _extract_debug_log_metrics(
+    mc_log_text: str, th_log_text: str, expected_total_frames: int
+) -> Dict[str, object]:
+    """
+    从 MC 与 TH 调试日志文本中提取序列号集合、错误计数与截断/ADC污染指标。
+
+    :param mc_log_text: MC 调试日志文本
+    :param th_log_text: TH 调试日志文本
+    :param expected_total_frames: 预期总帧数
+    :return: 解析后的指标字典
+    """
+    combined = mc_log_text + "\n" + th_log_text
+    ellipsis_lines = [
+        line for line in (mc_log_text.splitlines() + th_log_text.splitlines()) if line.endswith("...")
+    ]
+    mc_rx_seqs = {
+        int(m.group(1))
+        for m in re.finditer(r"\[MC-DBG\].*?dir=RX\s+node=(?:MC|TH)\s+seq=(\d+)", mc_log_text)
+    }
+    th_rx_seqs = {
+        int(m.group(1))
+        for m in re.finditer(r"\[TH-DBG\].*?dir=RX\s+node=TH\s+seq=(\d+)", th_log_text)
+    }
+    expected_seqs = set(range(1, expected_total_frames + 1))
+    high_seqs = set(range(256, expected_total_frames + 1)) if expected_total_frames >= 256 else set()
+    return {
+        "bare_adc_busy": ("SS_ADC_BUSY" in combined),
+        "crc_err_count": len(re.findall(r"status=CRC_ERR", combined)),
+        "bad_frame_count": len(re.findall(r"status=BAD_FRAME", combined)),
+        "timeout_count": len(re.findall(r"status=TIMEOUT", combined)),
+        "ellipsis_count": len(ellipsis_lines),
+        "mc_rx_seqs": mc_rx_seqs,
+        "th_rx_seqs": th_rx_seqs,
+        "missing_seqs": sorted(expected_seqs - mc_rx_seqs),
+        "missing_high_seqs": sorted(high_seqs - mc_rx_seqs),
+    }
+
+
+def evaluate_burst_debug_logs(
+    mc_log_text: str,
+    th_log_text: str,
+    expected_total_frames: int = 290,
+    mc_drop_delta: int = 0,
+    mc_trunc_delta: int = 0,
+    th_drop_delta: int = 0,
+    th_trunc_delta: int = 0,
+) -> Tuple[bool, Dict[str, object]]:
+    """
+    审计 290 帧突发压测期间的 `[MC-DBG]` 与 `[TH-DBG]` 原始日志文本，校验零 `SS_ADC_BUSY`、
+    零 `CRC_ERR`/`BAD_FRAME`/`TIMEOUT`、`drop_delta == 0`、`trunc_delta == 0` 及 16-bit `seq` 连续性。
+    """
+    m = _extract_debug_log_metrics(mc_log_text, th_log_text, expected_total_frames)
+    deltas_zero = (mc_drop_delta == 0 and mc_trunc_delta == 0 and th_drop_delta == 0 and th_trunc_delta == 0)
+    errors_zero = (
+        not m["bare_adc_busy"]
+        and m["crc_err_count"] == 0
+        and m["bad_frame_count"] == 0
+        and m["timeout_count"] == 0
+        and m["ellipsis_count"] == 0
+    )
+    seqs_ok = (len(m["missing_seqs"]) == 0 and len(m["missing_high_seqs"]) == 0 and len(m["th_rx_seqs"]) > 0)
+    passed = bool(deltas_zero and errors_zero and seqs_ok)
+    report = {
+        "expected_total_frames": expected_total_frames,
+        "observed_mc_unique_rx_seqs": len(m["mc_rx_seqs"]),
+        "observed_th_unique_rx_seqs": len(m["th_rx_seqs"]),
+        "max_seq_observed": max(m["mc_rx_seqs"]) if m["mc_rx_seqs"] else 0,
+        "missing_seqs_count": len(m["missing_seqs"]),
+        "missing_high_seqs_256_plus": m["missing_high_seqs"],
+        "bare_adc_busy_detected": m["bare_adc_busy"],
+        "crc_err_count": m["crc_err_count"],
+        "bad_frame_count": m["bad_frame_count"],
+        "timeout_count": m["timeout_count"],
+        "ellipsis_trunc_line_count": m["ellipsis_count"],
+        "mc_drop_delta": mc_drop_delta,
+        "mc_trunc_delta": mc_trunc_delta,
+        "th_drop_delta": th_drop_delta,
+        "th_trunc_delta": th_trunc_delta,
+        "passed": passed,
+    }
+    return passed, report
+
+
+def _format_single_frame_debug_logs(item: Dict[str, object], ts_ms: int) -> Tuple[List[str], List[str]]:
+    """
+    为单条突发协议帧生成对应的参考 `[MC-DBG]` 与 `[TH-DBG]` 日志行列表。
+
+    :param item: 单帧规格字典
+    :param ts_ms: 时间戳毫秒数
+    :return: (mc_lines, th_lines)
+    """
+    seq = int(item["seq"])
+    dst = int(item["dst"])
+    cmd = int(item["cmd"])
+    wire_len = int(item["wire_len"])
+    node_str = "TH" if dst == MINIMC_NODE_TH else "MC"
+    mc_lines = [f"[MC-DBG] ts={ts_ms} dir=RX node={node_str} seq={seq} cmd=0x{cmd:02X} status=OK len={wire_len}"]
+    th_lines: List[str] = []
+    if dst == MINIMC_NODE_TH or cmd in (MINIMC_CMD_SLOT_SELECT, MINIMC_CMD_GCODE_EXEC):
+        resp_cmd = (
+            MINIMC_CMD_VERSION_REPORT
+            if cmd == MINIMC_CMD_GET_VERSION
+            else (MINIMC_CMD_PONG if cmd == MINIMC_CMD_PING else cmd)
+        )
+        mc_lines.append(f"[MC-DBG] ts={ts_ms} dir=RELAY_TX node=TH seq={seq} cmd=0x{cmd:02X} status=EXEC timeout_ms=200")
+        th_lines.append(f"[TH-DBG] ts={ts_ms + 1} dir=RX node=TH seq={seq} cmd=0x{cmd:02X} status=OK len={wire_len}")
+        th_lines.append(f"[TH-DBG] ts={ts_ms + 2} dir=TX node=TH seq={seq} cmd=0x{resp_cmd:02X} status=ACK ok=1")
+        mc_lines.append(f"[MC-DBG] ts={ts_ms + 3} dir=RELAY_RX node=TH seq={seq} cmd=0x{resp_cmd:02X} status=ACK elapsed_ms=3")
+    if dst == MINIMC_NODE_MC:
+        if cmd == MINIMC_CMD_POS_QUERY:
+            mc_lines.append(
+                f"[MC-DBG] ts={ts_ms + 1} dir=STATE node=MC seq={seq} cmd=0x16 status=OK "
+                f"op=POS_QUERY axes_mask=0x07 x_mm_x100=12050 y_mm_x100=8525 z_mm_x100=1000 "
+                f"feed=1500 homed_mask=0x07 motion_state=IDLE"
+            )
+        mc_lines.append(f"[MC-DBG] ts={ts_ms + 2} dir=TX node=MC seq={seq} cmd=0x{cmd:02X} status=ACK ok=1")
+    return mc_lines, th_lines
+
+
+def simulate_honest_290_burst_logs(specs: List[Dict[str, object]]) -> Tuple[str, str]:
+    """
+    根据 290 帧协议帧规格生成用于解析器/门禁自检的参考 `[MC-DBG]` 与 `[TH-DBG]` 日志流。
+
+    :param specs: 290 帧规格列表
+    :return: (mc_log_text, th_log_text)
+    """
+    mc_lines: List[str] = []
+    th_lines: List[str] = []
+    ts_ms = 1000
+    for item in specs:
+        m_chunk, t_chunk = _format_single_frame_debug_logs(item, ts_ms)
+        mc_lines.extend(m_chunk)
+        th_lines.extend(t_chunk)
+        ts_ms += 20
+    return "\r\n".join(mc_lines) + "\r\n", "\r\n".join(th_lines) + "\r\n"
+
+
+def _send_single_burst_http_request(http_base: str, item: Dict[str, object]) -> Tuple[bool, str]:
+    """
+    按 290 帧突发计划中的单条规格向网关发起 HTTP 请求，并附带序列号与协议帧头信息。
+
+    :param http_base: 网关基础 URL
+    :param item: 单帧突发规格字典
+    :return: (是否 HTTP 200, 错误信息)
+    """
+    seq = int(item["seq"])
+    route = str(item.get("http_route", "/api/v1/state"))
+    method = str(item.get("http_method", "GET"))
+    headers = {"X-MiniMC-Seq": str(seq), "X-MiniMC-Wire-Hex": str(item["wire_hex"])}
+    body: Optional[bytes] = None
+    if method == "POST":
+        headers["Content-Type"] = "application/json"
+        if route.endswith("/slots"):
+            body = json.dumps({"active_slot": (seq % 4) + 1, "action": 0, "target_temp_deci_c": 0}).encode("utf-8")
+        else:
+            body = json.dumps({"seq": seq}).encode("utf-8")
+    req = urllib.request.Request(f"{http_base.rstrip('/')}{route}", data=body, method=method, headers=headers)
+    try:
+        with urllib.request.urlopen(req, timeout=2.0) as resp:
+            if resp.status == 200:
+                return True, ""
+            return False, f"seq={seq} status={resp.status}"
+    except urllib.error.URLError as exc:
+        return False, f"seq={seq} err={exc}"
+
+
+def _read_incremental_text(log_path: Optional[Path], offset: int) -> str:
+    """
+    从指定日志文件偏移量起读取新增的 UTF-8 文本内容。
+
+    :param log_path: 日志文件路径
+    :param offset: 起始字节偏移
+    :return: 增量日志文本
+    """
+    if not log_path or not log_path.exists():
+        return ""
+    with log_path.open("rb") as f:
+        f.seek(offset)
+        return f.read().decode("utf-8", errors="replace")
+
+
+def run_live_http_burst(
+    http_base: str,
+    mc_log_path: Optional[Path],
+    th_log_path: Optional[Path],
+    pacing_sec: float = 0.02,
+) -> Tuple[bool, Dict[str, object]]:
+    """
+    驱动 `generate_290_burst_plan()` 定义的 290 帧序列向 `http_base` 发起请求，
+    并直接调用 `evaluate_burst_debug_logs` 校验 16-bit `seq` (1..290) 连续性、
+    `TIMEOUT == 0`、`drop_delta == 0`、`trunc_delta == 0`、`CRC_ERR == 0` 与 `BAD_FRAME == 0`。
+
+    :param http_base: 网关基础地址，例如 http://192.168.77.134:8080
+    :param mc_log_path: MC 调试日志文件路径
+    :param th_log_path: TH 调试日志文件路径
+    :param pacing_sec: 帧间间隔秒数（默认 20ms）
+    :return: (是否通过, 完整对账报告字典)
+    """
+    plan = generate_290_burst_plan()
+    mc_offset = mc_log_path.stat().st_size if (mc_log_path and mc_log_path.exists()) else 0
+    th_offset = th_log_path.stat().st_size if (th_log_path and th_log_path.exists()) else 0
+    http_ok = 0
+    http_errors: List[str] = []
+    for item in plan:
+        ok, err_msg = _send_single_burst_http_request(http_base, item)
+        if ok:
+            http_ok += 1
+        else:
+            http_errors.append(err_msg)
+        if pacing_sec > 0.0:
+            time.sleep(pacing_sec)
+
+    mc_text = _read_incremental_text(mc_log_path, mc_offset)
+    th_text = _read_incremental_text(th_log_path, th_offset)
+    eval_passed, report = evaluate_burst_debug_logs(mc_text, th_text, expected_total_frames=len(plan))
+    overall_passed = (http_ok == len(plan)) and eval_passed
+    report["http_ok"] = http_ok
+    report["http_error_count"] = len(http_errors)
+    report["passed"] = overall_passed
+    return overall_passed, report
+
+
+class _BurstMockGatewayHandler(http.server.BaseHTTPRequestHandler):
+    """用于 `--self-test` 端到端验证 `run_live_http_burst` 的本地 HTTP 网关模拟处理器。"""
+
+    spec_by_seq: Dict[int, Dict[str, object]] = {}
+    mc_log_file: Optional[Path] = None
+    th_log_file: Optional[Path] = None
+
+    def log_message(self, format_str: str, *args: object) -> None:
+        """静默标准错误输出以保持自检控制台整洁。"""
+        return
+
+    def _handle_burst_req(self) -> None:
+        """处理单次突发 HTTP 请求并向临时日志文件追加对应的 `[MC-DBG]`/`[TH-DBG]` 帧记录。"""
+        content_len = int(self.headers.get("Content-Length", "0"))
+        if content_len > 0:
+            _ = self.rfile.read(content_len)
+        seq = int(self.headers.get("X-MiniMC-Seq", "0"))
+        item = self.spec_by_seq.get(seq)
+        if item and self.mc_log_file and self.th_log_file:
+            mc_lines, th_lines = _format_single_frame_debug_logs(item, 1000 + seq * 20)
+            with self.mc_log_file.open("a", encoding="utf-8") as mf:
+                mf.write("\r\n".join(mc_lines) + "\r\n")
+            if th_lines:
+                with self.th_log_file.open("a", encoding="utf-8") as tf:
+                    tf.write("\r\n".join(th_lines) + "\r\n")
+        body = b'{"ok":true}'
+        self.send_response(200)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+    def do_GET(self) -> None:
+        """处理 GET 请求。"""
+        self._handle_burst_req()
+
+    def do_POST(self) -> None:
+        """处理 POST 请求。"""
+        self._handle_burst_req()
+
+
+class Test290FrameBurstStress(unittest.TestCase):
+    """290 帧高频突发压测规格与对账门禁单元测试套件。"""
+
+    def test_generate_290_burst_plan_covers_16bit_seq_boundary(self) -> None:
+        """验证 290 帧突发计划完整覆盖 seq=1..290，且每帧 CRC16 与 16位小端序列号编码准确。"""
+        plan = generate_290_burst_plan()
+        self.assertEqual(len(plan), 290)
+        self.assertEqual(plan[0]["seq"], 1)
+        self.assertEqual(plan[254]["seq"], 255)
+        self.assertEqual(plan[255]["seq"], 256)
+        self.assertEqual(plan[289]["seq"], 290)
+
+        frame_256 = bytes.fromhex(str(plan[255]["wire_hex"]))
+        self.assertEqual(frame_256[8], 0x00)
+        self.assertEqual(frame_256[9], 0x01)
+        self.assertEqual(minimc_crc16(frame_256[:-2]), struct.unpack("<H", frame_256[-2:])[0])
+
+        frame_290 = bytes.fromhex(str(plan[289]["wire_hex"]))
+        self.assertEqual(frame_290[8], 0x22)
+        self.assertEqual(frame_290[9], 0x01)
