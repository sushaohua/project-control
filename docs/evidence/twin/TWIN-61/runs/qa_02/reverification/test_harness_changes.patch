+                f"feed=1500 homed_mask=0x07 motion_state=IDLE"
+            )
+        mc_lines.append(f"[MC-DBG] ts={ts_ms + 2} dir=TX node=MC seq={seq} cmd=0x{cmd:02X} status=ACK ok=1")
+    return mc_lines, th_lines
