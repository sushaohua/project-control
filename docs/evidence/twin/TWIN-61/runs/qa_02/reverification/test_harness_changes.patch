+def run_live_composite_sequences(
+    http_base: str, mc_log_path: Optional[Path] = None
+) -> Tuple[bool, Dict[str, object]]:
+    """
+    针对目标 HTTP 网关端到端执行 SEQ-01 ~ SEQ-05 五类复合业务序列并汇总四方对账结果。
+
+    :param http_base: 网关基础地址，如 `http://192.168.77.134:8080`
+    :param mc_log_path: MC 调试日志文件路径
+    :return: (是否全部通过, 序列执行报告字典)
+    """
+    seq01_ok, seq02_ok = _drive_seq01_and_seq02_http(http_base, mc_log_path)
+    seq03_ok, seq04_ok, seq05_ok = _drive_seq03_seq04_seq05_http(http_base)
+    passed = bool(seq01_ok and seq02_ok and seq03_ok and seq04_ok and seq05_ok)
+    return passed, {
+        "SEQ-01": seq01_ok,
+        "SEQ-02": seq02_ok,
+        "SEQ-03": seq03_ok,
+        "SEQ-04": seq04_ok,
+        "SEQ-05": seq05_ok,
+        "passed": passed,
+    }
+
+
+class _CompositeMockGatewayHandler(http.server.BaseHTTPRequestHandler):
+    """用于 `--self-test` 端到端验证 `run_live_composite_sequences` 的本地 HTTP 网关模拟处理器。"""
+
+    mc_log_file: Optional[Path] = None
+
+    def log_message(self, format_str: str, *args: object) -> None:
+        """静默标准错误日志。"""
+        return
+
+    def _send_json(self, status_code: int, payload: Dict[str, object]) -> None:
+        """发送带精确 Content-Length 的 JSON 响应。"""
+        raw = json.dumps(payload, separators=(",", ":")).encode("utf-8")
+        self.send_response(status_code)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(raw)))
+        self.send_header("Connection", "close")
+        self.end_headers()
+        self.wfile.write(raw)
+
+    def do_GET(self) -> None:
+        """处理复合序列 GET 请求。"""
+        if self.path.startswith("/api/v1/system/versions"):
+            after = "after_reset=1" in self.path
+            self._send_json(200, {"mc_boot_id": 0x11223345 if after else 0x11223344, "th_boot_id": 0x55667789 if after else 0x55667788})
+        elif self.path == "/api/v1/state":
+            self._send_json(200, {"system_status": "READY", "device_state": "READY"})
+        elif self.path.startswith("/api/v1/temperature/snapshot"):
+            if "simulate_offline_ms=3200" in self.path:
+                self._send_json(
+                    200,
+                    {
+                        "system_status": "OFFLINE",
+                        "device_state": "OFFLINE",
+                        "bed": {"temperature_millic": AISOC_TEMP_MILLIC_OFFLINE, "raw_adc": 4095, "quality": "FAULT"},
+                        "tool": {"temperature_millic": AISOC_TEMP_MILLIC_OFFLINE, "raw_adc": 4095, "quality": "FAULT"},
+                    },
+                )
+            else:
+                self._send_json(
+                    200,
+                    {
+                        "system_status": "READY",
+                        "device_state": "READY",
+                        "bed": {"temperature_millic": 60000, "raw_adc": 3120, "quality": "FRESH"},
+                        "tool": {"temperature_millic": 200000, "raw_adc": 1850, "quality": "FRESH"},
+                    },
+                )
+        elif self.path in ("/api/v1/calibration/status", "/api/v1/motion/position"):
+            self._send_json(200, {"ok": True})
+        else:
+            self._send_json(404, {"error": 404, "message": "Not Found"})
+
+    def do_POST(self) -> None:
+        """处理复合序列 POST 请求并按路由执行契约校验与日志追加。"""
+        length = int(self.headers.get("Content-Length", "0"))
+        raw_body = self.rfile.read(length).decode("utf-8", errors="replace") if length > 0 else "{}"
+        payload = json.loads(raw_body) if raw_body else {}
+        if self.path == "/api/v1/filament/slots":
+            code, msg = validate_seq03_filament_slots_contract(payload)
+            self._send_json(code, {"message": msg})
+        elif self.path == "/api/v1/jobs/upload":
+            code, state, msg = validate_seq04_gcode_upload_and_two_stage_job(payload, explicit_start_clicked=False)
+            self._send_json(code, {"job_state": state, "message": msg})
+        elif self.path == "/api/v1/jobs/start":
+            self._send_json(200, {"job_state": "PRINTING"})
+        elif self.path in ("/api/v1/motion/home", "/api/v1/calibration/start", "/api/v1/motion/jog", "/api/v1/system/estop"):
+            if self.path == "/api/v1/motion/jog" and self.mc_log_file:
+                self.mc_log_file.write_text(
+                    "[MC-DBG] ts=1000 dir=STATE node=MC seq=10 cmd=0x11 status=OK op=HOME axes_mask=0x07 x_mm_x100=0 y_mm_x100=0 z_mm_x100=0 feed=1500 homed_mask=0x07 motion_state=IDLE\r\n"
+                    "[MC-DBG] ts=1050 dir=TX node=MC seq=11 cmd=0x1A status=ACK op=LEVEL_TRIGGER grid_valid=1 status=DONE\r\n"
+                    "[MC-DBG] ts=1100 dir=STATE node=MC seq=12 cmd=0x18 status=OK op=GRID_READ probe_idx=7 z_offset_um=-42 grid_valid=1 status=DONE\r\n"
+                    "[MC-DBG] ts=1150 dir=STATE node=MC seq=13 cmd=0x12 status=OK op=MOVE axes_mask=0x07 x_mm_x100=12500 y_mm_x100=8525 z_mm_x100=1000 feed=2400 homed_mask=0x07 motion_state=MOVING\r\n"
+                    "[MC-DBG] ts=1200 dir=STATE node=MC seq=14 cmd=0x16 status=OK op=POS_QUERY axes_mask=0x07 x_mm_x100=12500 y_mm_x100=8525 z_mm_x100=1000 feed=2400 homed_mask=0x07 motion_state=IDLE\r\n",
+                    encoding="utf-8",
+                )
+            self._send_json(200, {"ok": True})
+        else:
+            self._send_json(404, {"error": 404, "message": "Not Found"})
+
