+        const uint8_t *src = (const uint8_t *)(high | (uintptr_t)DMA1_CHANNEL4->maddr);
+        const uint16_t n = (s_dma_ch4_len <= sizeof(s_usart1_last_tx))
+                               ? s_dma_ch4_len
+                               : (uint16_t)sizeof(s_usart1_last_tx);
