+#!/bin/sh
+# TWIN-64 TH App (mcu-p3/color-engine-mcu) 自动化测试与门禁校验脚本
+set -eu
+
+SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
+TH_ROOT="$(cd "$SCRIPT_DIR/../io_toggle" && pwd)"
+BUILD_DIR="/tmp/twin64_th_tests_$$"
+mkdir -p "$BUILD_DIR"
+trap 'rm -rf "$BUILD_DIR"' EXIT
+
+TH_CFLAGS="-std=c11 -O2 -Wall -Wextra -Werror -no-pie -fno-pie -DAT32F423CCT7 -DUSE_STDPERIPH_DRIVER -DAT_START_F423_V1 -I$TH_ROOT/inc -I$TH_ROOT/inc/temperature_control -I$TH_ROOT/at32f423_board -I$TH_ROOT/src -I$TH_ROOT/src/app -I$TH_ROOT/libraries/cmsis/cm4/core_support -I$TH_ROOT/libraries/cmsis/cm4/device_support -I$TH_ROOT/libraries/drivers/inc"
+
+echo "=== [1/3] Run TWIN-45/48/60 TH regression suite (test_twin45_th_debug.c) ==="
+gcc -DMINIMC_MAX_PAYLOAD_SIZE=64U $TH_CFLAGS \
+    "$TH_ROOT/src/bsp/usart.c" \
+    "$TH_ROOT/src/app/minimc_proto.c" \
+    "$TH_ROOT/src/user/test_twin45_th_debug.c" \
+    -o "$BUILD_DIR/test_twin45_th_debug"
+"$BUILD_DIR/test_twin45_th_debug"
+
+echo "=== [2/3] Run TWIN-64 TH OTA 0x1D magic (0x20008000 UPGD), 534B & boot_id suite ==="
+gcc -DHOST_UNIT_TEST=1 $TH_CFLAGS \
+    "$TH_ROOT/src/bsp/usart.c" \
+    "$TH_ROOT/src/app/minimc_proto.c" \
+    "$SCRIPT_DIR/test_th_ota_and_bootid.c" \
+    -o "$BUILD_DIR/test_th_ota_and_bootid"
+"$BUILD_DIR/test_th_ota_and_bootid"
+
+echo "=== [3/3] Verify TH AT32F423xC_FLASH.ld (LENGTH = 236K), zero M997 send_quick & S04 gates ==="
+python3 - "$TH_ROOT" "$SCRIPT_DIR/test_th_ota_and_bootid.c" <<'PY'
+import re, sys
+
+th_root = sys.argv[1]
+test_c = sys.argv[2]
+
+ld_path = f"{th_root}/libraries/cmsis/cm4/device_support/startup/gcc/linker/AT32F423xC_FLASH.ld"
+ld_text = open(ld_path, encoding="utf-8").read()
+assert "ORIGIN = 0x08004000, LENGTH = 236K" in ld_text, "AT32F423xC_FLASH.ld must set LENGTH = 236K"
+
+mycontrol_text = open(f"{th_root}/src/app/mycontrol.c", encoding="utf-8", errors="ignore").read()
+assert "M997 SYSTEM RESET" not in mycontrol_text, "mycontrol.c must not send M997 SYSTEM RESET string"
+
+def check_c_file(path):
+    text = open(path, encoding="utf-8").read()
+    assert "中文说明：模块辅助逻辑与状态说明" not in text, f"Forbidden template comment in {path}"
+    lines = text.splitlines()
+    i = 0
+    n = len(lines)
+    while i < n:
+        line = lines[i].strip()
+        if (
+            not line
+            or line.startswith("#")
+            or line.startswith("//")
+            or line.startswith("/*")
+            or line.startswith("*")
+            or line.startswith("typedef")
+            or ";" in line
+        ):
+            i += 1
+            continue
+        sig_lines = [lines[i]]
+        j = i
+        while "{" not in sig_lines[-1] and j + 1 < n and ";" not in sig_lines[-1]:
+            j += 1
+            sig_lines.append(lines[j])
+        sig = " ".join(s.strip() for s in sig_lines)
+        m = re.match(r"^(?:static\s+)?(?:inline\s+)?[A-Za-z_][\w\s\*]*?\b([A-Za-z_]\w*)\s*\(([^)]*)\)\s*\{", sig)
+        if m and m.group(1) not in ("if", "for", "while", "switch"):
+            fname = m.group(1)
+            params_raw = m.group(2).strip()
+            params = [] if params_raw in ("", "void") else [p.strip() for p in params_raw.split(",")]
+            brace = 0
+            k = i
+            started = False
+            while k < n:
+                for ch in lines[k]:
+                    if ch == "{":
+                        brace += 1
+                        started = True
+                    elif ch == "}":
+                        brace -= 1
+                if started and brace == 0:
+                    break
+                k += 1
+            func_lines = k - j + 1
+            if func_lines > 50 or len(params) > 4:
+                print(f"[FAIL] {path}:{fname} lines={func_lines} params={len(params)}")
+                sys.exit(1)
+            i = k + 1
+        else:
+            i += 1
+
+for p in [
+    f"{th_root}/src/app/minimc_proto.c",
+    test_c,
+]:
+    check_c_file(p)
+print("[PASS] TH AT32F423xC_FLASH.ld (236K), zero M997 residue and S04 function/comment gates verified!")
+PY
