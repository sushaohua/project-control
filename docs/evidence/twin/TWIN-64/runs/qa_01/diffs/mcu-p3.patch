+void dma_channel_enable(dma_channel_type *dma_channel, confirm_state new_state)
+{
+    if ((dma_channel == DMA1_CHANNEL2) && (new_state == TRUE))
+    {
+        const uint16_t len = (uint16_t)DMA1_CHANNEL2->dtcnt;
+        const uintptr_t high = ((uintptr_t)s_last_ap_tx) & ~(uintptr_t)0xFFFFFFFFULL;
+        const uint8_t *src = (const uint8_t *)(high | (uintptr_t)DMA1_CHANNEL2->maddr);
+        if ((src != NULL) && (len > 0U) && (len <= sizeof(s_last_ap_tx)))
+        {
