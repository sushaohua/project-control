+}
+uint8_t forward_uart_rx_poll(void) { return (s_mock_th_rx_len > 0U) ? 1U : 0U; }
+uint16_t forward_uart_proto_rx_read(uint8_t *buf, uint16_t max_len)
+{
+    if ((buf == NULL) || (s_mock_th_rx_len == 0U)) { return 0U; }
+    const uint16_t n = (s_mock_th_rx_len > max_len) ? max_len : s_mock_th_rx_len;
+    memcpy(buf, s_mock_th_rx, n);
+    s_mock_th_rx_len = 0U;
