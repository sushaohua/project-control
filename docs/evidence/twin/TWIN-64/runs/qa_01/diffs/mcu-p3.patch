+ */
+static FRESULT f_mount(FATFS *fs, const char *path, uint8_t opt) { (void)fs; (void)path; (void)opt; return FR_OK; }
+static FRESULT f_stat(const char *path, FILINFO *fno)
+{
+    if (!s_udisk_file_exists || (strcmp(path, s_udisk_file_name) != 0)) { return FR_NO_FILE; }
+    if (fno != NULL) { fno->fsize = s_udisk_file_size; }
+    return FR_OK;
+}
+static FRESULT f_open(FIL *fp, const char *path, uint8_t mode)
+{
+    (void)mode;
+    if (!s_udisk_file_exists || (strcmp(path, s_udisk_file_name) != 0)) { return FR_NO_FILE; }
+    fp->offset = 0U;
+    fp->size = s_udisk_file_size;
+    return FR_OK;
+}
+static FRESULT f_lseek(FIL *fp, FSIZE_t ofs)
+{
+    if (ofs > fp->size) { return FR_DISK_ERR; }
+    fp->offset = ofs;
+    return FR_OK;
+}
+static FRESULT f_read(FIL *fp, void *buff, UINT btr, UINT *br)
+{
+    const uint32_t avail = (fp->offset < fp->size) ? (fp->size - fp->offset) : 0U;
+    const uint32_t n = (btr < avail) ? btr : avail;
+    if (n > 0U) { memcpy(buff, &s_udisk_file_buf[fp->offset], n); fp->offset += n; }
+    *br = (UINT)n;
+    return FR_OK;
+}
+static FRESULT f_close(FIL *fp) { (void)fp; return FR_OK; }
+static FSIZE_t f_size(const FIL *fp) { return (fp != NULL) ? fp->size : 0U; }
+static FRESULT f_unlink(const char *path) { (void)path; return FR_OK; }
+static FRESULT f_rename(const char *old_p, const char *new_p)
+{
+    (void)old_p;
+    snprintf(s_udisk_file_name, sizeof(s_udisk_file_name), "%s", new_p);
+    return FR_OK;
+}
+#define FA_READ 0x01U
+
+#include "../project/marlin/marlin_module/th_upgrade_mgr.c"
+
+/**
+ * @brief 组装并向 MC USART2 注入一帧 AP 请求报文
+ */
+static void send_ap_frame(uint8_t dst, uint8_t flags, uint8_t cmd, const void *pay)
+{
+    uint16_t plen = 0U;
+    if ((cmd == MINIMC_CMD_SET_TEMP) || (cmd == MINIMC_CMD_SYSTEM_CONTROL) || (cmd == MINIMC_CMD_FILAMENT_CONTROL)) { plen = 4U; }
+    else if (cmd == MINIMC_CMD_OTA_START) { plen = 144U; }
+    else if (cmd == MINIMC_CMD_OTA_DATA) { plen = 520U; }
+    else if (cmd == MINIMC_CMD_OTA_FINISH) { plen = 8U; }
+    static uint16_t s_seq = 1U;
+    const uint16_t seq = s_seq++;
+    uint8_t frame[MINIMC_MAX_FRAME_SIZE];
+    frame[0] = MINIMC_SOF_1;
+    frame[1] = MINIMC_SOF_2;
+    frame[2] = MINIMC_NODE_AP;
+    frame[3] = dst;
+    frame[4] = flags;
+    frame[5] = cmd;
+    frame[6] = 4U;
+    frame[7] = 0U;
+    frame[8] = (uint8_t)(seq & 0xFFU);
+    frame[9] = (uint8_t)((seq >> 8U) & 0xFFU);
+    frame[10] = (uint8_t)(plen & 0xFFU);
+    frame[11] = (uint8_t)((plen >> 8U) & 0xFFU);
+    if ((plen > 0U) && (pay != NULL)) { memcpy(&frame[12], pay, plen); }
+    const uint16_t crc = minimc_crc16(frame, (uint16_t)(12U + plen));
+    frame[12U + plen] = (uint8_t)(crc & 0xFFU);
+    frame[13U + plen] = (uint8_t)((crc >> 8U) & 0xFFU);
+    s_last_ap_tx_len = 0U;
+    s_last_th_tx_len = 0U;
+    minimc_proto_push_ap_rx(frame, (uint16_t)(14U + plen));
+    minimc_proto_poll();
+}
+
+/**
+ * @brief 模拟 TH 通过 USART6 返回响应帧
+ */
+static void inject_th_resp(uint8_t dst, uint8_t cmd, uint16_t seq, uint16_t plen)
+{
+    s_mock_th_rx[0] = MINIMC_SOF_1;
+    s_mock_th_rx[1] = MINIMC_SOF_2;
+    s_mock_th_rx[2] = MINIMC_NODE_TH;
+    s_mock_th_rx[3] = dst;
+    s_mock_th_rx[4] = (uint8_t)(MINIMC_FLAG_IS_RESPONSE | MINIMC_FLAG_PROTO_V2);
+    s_mock_th_rx[5] = cmd;
+    s_mock_th_rx[6] = 4U;
+    s_mock_th_rx[7] = 0U;
+    s_mock_th_rx[8] = (uint8_t)(seq & 0xFFU);
+    s_mock_th_rx[9] = (uint8_t)((seq >> 8U) & 0xFFU);
+    s_mock_th_rx[10] = (uint8_t)(plen & 0xFFU);
+    s_mock_th_rx[11] = (uint8_t)((plen >> 8U) & 0xFFU);
+    memset(&s_mock_th_rx[12], 0, plen);
+    if (cmd == MINIMC_CMD_VERSION_REPORT && plen == 16U)
+    {
+        const uint32_t cap = 0xE0080423UL;
+        memcpy(&s_mock_th_rx[24], &cap, 4U);
+    }
+    const uint16_t crc = minimc_crc16(s_mock_th_rx, (uint16_t)(12U + plen));
+    s_mock_th_rx[12U + plen] = (uint8_t)(crc & 0xFFU);
+    s_mock_th_rx[13U + plen] = (uint8_t)((crc >> 8U) & 0xFFU);
+    s_mock_th_rx_len = (uint16_t)(14U + plen);
+}
+
+/**
+ * @brief 验证 Rev 2.0.4 常量、520B/600B 缓冲扩容与 0x17 单播/广播急停契约
+ */
+static void test_rev204_constants_and_estop(void)
+{
+    require_true(MINIMC_MAX_PAYLOAD_SIZE == 520U && MINIMC_MAX_FRAME_SIZE == 534U, "520B/534B frame size");
+    require_true(FORWARD_UART_TX_BUF_SIZE == 600 && FORWARD_UART_RX_BUF_SIZE == 600, "600B UART6 buffers");
+    require_true(MC_BOOT_UPGRADE_FLAG_ADDR == 0x2005FFF0UL && MC_BOOT_UPGRADE_MAGIC == 0x55504732UL, "UPG2 magic addr");
+    require_true(TH_FLASH_MAX_APP_SIZE == (236U * 1024U), "TH 236KB max app size");
+
+    minimc_proto_init();
+    /* 单播 0x17 EMERGENCY_STOP (DST=0x02, Flags=0x05) -> 回 18B (4B payload) 0x00 CMD_ACK */
+    send_ap_frame(MINIMC_NODE_MC, 0x05U, MINIMC_CMD_EMERGENCY_STOP, NULL);
+    require_true(s_last_ap_tx_len == 18U && s_last_ap_tx[5] == MINIMC_CMD_ACK, "unicast 0x17 returns 4B CMD_ACK");
+
+    /* 广播 0x17 EMERGENCY_STOP (DST=0xFF, Flags=0x14, WANTS_ACK=0) -> 不回 AP ACK，级联转发 TH */
+    send_ap_frame(MINIMC_NODE_BROADCAST, 0x14U, MINIMC_CMD_EMERGENCY_STOP, NULL);
+    require_true(s_last_ap_tx_len == 0U, "broadcast 0x17 must NOT send ACK to AP");
+    require_true(s_last_th_tx_len == 14U && s_last_th_tx[5] == MINIMC_CMD_EMERGENCY_STOP &&
+                 s_last_th_tx[6] == 3U && s_last_th_tx[7] == MINIMC_ROUTE_IS_ROUTED, "broadcast 0x17 relayed to TH");
+}
+
+/**
+ * @brief 验证 0x1D CMD_SYSTEM_CONTROL 非空闲安全拦截 (NACK 0x05) 与空闲安全进 Boot (写 0x2005FFF0 UPG2 + 4B ACK + 复位)
+ */
+static void test_mc_sys_ctrl_0x1d_gate_and_magic(void)
+{
+    minimc_proto_init();
+    s_mc_magic_word = 0U;
+    s_mc_reset_count = 0U;
+    const minimc_sys_ctrl_req_t boot_req = { 2U, 1U, 50U };
+
+    /* 1. 运动队列非空 (movesplanned > 0) -> 拒绝回 NACK 0x05，零魔数写入，零复位 */
+    s_mock_moves = 2U;
+    send_ap_frame(MINIMC_NODE_MC, 0x05U, MINIMC_CMD_SYSTEM_CONTROL, &boot_req);
+    require_true(s_last_ap_tx[5] == MINIMC_CMD_NACK && s_last_ap_tx[12] == MINIMC_ERR_DEVICE_BUSY, "busy motion -> NACK 0x05");
+    require_true(s_mc_magic_word == 0U && s_mc_reset_count == 0U, "no magic or reset when busy");
+    s_mock_moves = 0U;
+
+    /* 2. 加热目标温度 > 0 -> 拒绝回 NACK 0x05 */
+    const minimc_set_temp_req_t hot_req = { 2000, 600 };
+    send_ap_frame(MINIMC_NODE_MC, 0x05U, MINIMC_CMD_SET_TEMP, &hot_req);
+    s_mock_tick_ms += 300U;
+    minimc_proto_poll();
+    send_ap_frame(MINIMC_NODE_MC, 0x05U, MINIMC_CMD_SYSTEM_CONTROL, &boot_req);
+    require_true(s_last_ap_tx[5] == MINIMC_CMD_NACK && s_last_ap_tx[12] == MINIMC_ERR_DEVICE_BUSY, "heating active -> NACK 0x05");
+
+    /* 3. 降温至 0 后空闲安全态发送 0x1D (action=2) -> 回 18B (4B payload) 0x00 CMD_ACK + 写 UPG2 + 软复位 */
+    const minimc_set_temp_req_t cool_req = { 0, 0 };
+    send_ap_frame(MINIMC_NODE_MC, 0x05U, MINIMC_CMD_SET_TEMP, &cool_req);
+    s_mock_tick_ms += 300U;
+    minimc_proto_poll();
+    send_ap_frame(MINIMC_NODE_MC, 0x05U, MINIMC_CMD_SYSTEM_CONTROL, &boot_req);
+    require_true(s_last_ap_tx_len == 18U && s_last_ap_tx[5] == MINIMC_CMD_ACK, "0x1D returns 4B CMD_ACK before reset");
+    require_true(s_mc_magic_word == MC_BOOT_UPGRADE_MAGIC && s_mc_reset_count == 1U && s_mc_last_delay_ms == 50U, "UPG2 written & reset");
+}
+
+/**
+ * @brief 验证 MC 维护态 DST=0x03 534B 大帧透明路由、proxy_active 期间业务帧 NACK 0x05、G-code 拦截及 5000ms 超时自动恢复
+ */
+static void test_th_proxy_534b_relay_and_5000ms_recovery(void)
+{
+    minimc_proto_init();
+    uint8_t ota_data_pay[520];
+    for (uint16_t i = 0U; i < sizeof(ota_data_pay); ++i) { ota_data_pay[i] = (uint8_t)(i & 0xFFU); }
+
+    /* 1. 发送 534B (520B payload) 0x21 CMD_OTA_DATA 至 DST=0x03 -> 激活 proxy_active 与 FORWARD_UART_MODE_OTA_ROUTE */
+    send_ap_frame(MINIMC_NODE_TH, 0x05U, MINIMC_CMD_OTA_DATA, ota_data_pay);
+    require_true(minimc_proto_is_th_proxy_active() && forward_uart_mode_get() == FORWARD_UART_MODE_OTA_ROUTE, "proxy_active enabled");
+    require_true(s_last_th_tx_len == 534U && s_last_th_tx[5] == MINIMC_CMD_OTA_DATA &&
+                 s_last_th_tx[6] == 3U && s_last_th_tx[7] == MINIMC_ROUTE_IS_ROUTED, "534B 0x21 relayed intact");
+    const uint16_t rx_seq = (uint16_t)s_last_th_tx[8] | ((uint16_t)s_last_th_tx[9] << 8U);
+
+    /* 2. proxy_active 期间：拦截本地 G-code 行下发，且普通业务帧 (0x10 SET_TEMP) 立即返回 NACK 0x05 (DEVICE_BUSY) */
+    s_last_th_tx_len = 0U;
+    forward_uart_send_line("M104 S200\r\n", 11U);
+    require_true(s_last_th_tx_len == 0U && !minimc_proto_send_th_gcode("G28", 3U, 1U), "G-code blocked during OTA_ROUTE");
+    const minimc_set_temp_req_t temp_req = { 1800, 500 };
+    send_ap_frame(MINIMC_NODE_MC, 0x05U, MINIMC_CMD_SET_TEMP, &temp_req);
+    require_true(s_last_ap_tx[5] == MINIMC_CMD_NACK && s_last_ap_tx[12] == MINIMC_ERR_DEVICE_BUSY, "business cmd NACK 0x05 during proxy");
+
+    /* 3. TH 返回 0x00 CMD_ACK (18B) -> MC 经 534B drain_th_rx 转发回 AP */
+    inject_th_resp(MINIMC_NODE_AP, MINIMC_CMD_ACK, rx_seq, 4U);
+    s_last_ap_tx_len = 0U;
+    minimc_proto_poll();
+    require_true(s_last_ap_tx_len == 18U && s_last_ap_tx[2] == MINIMC_NODE_TH &&
+                 s_last_ap_tx[5] == MINIMC_CMD_ACK && s_last_ap_tx[6] == 3U, "TH 0x00 CMD_ACK relayed to AP");
+
+    /* 4. 推进 5000ms 无活动 -> proxy_active 自动恢复为 false 且串口恢复 FORWARD_UART_MODE_NORMAL */
+    s_mock_tick_ms += 5000U;
+    minimc_proto_poll();
+    require_true(!minimc_proto_is_th_proxy_active() && forward_uart_mode_get() == FORWARD_UART_MODE_NORMAL, "5000ms auto recovery");
+}
+
+/**
+ * @brief 验证 th_upgrade_mgr.c 100% 迁移至 MiniMCProto v2.0（零 M997 / 零 5A A5 帧）与擦除前 Trailer CRC32 校验
+ */
+static void test_th_upgrade_mgr_v2_flow(void)
+{
+    uint8_t raw_app[64];
+    for (uint32_t i = 0U; i < sizeof(raw_app); ++i) { raw_app[i] = (uint8_t)(0x30U + i); }
+    fw_trailer_t tr;
+    memset(&tr, 0, sizeof(tr));
+    tr.magic = TRAILER_MAGIC_ATSG;
+    tr.struct_ver = TRAILER_STRUCT_VER_V1;
+    tr.board_id = BOARD_ID_TH_AT32F423;
+    tr.fw_version = 0x01020300UL;
+    tr.payload_len = sizeof(raw_app);
+    tr.trailer_crc32 = crc32_calculate(0U, (const uint8_t *)&tr, 124U);
+
+    memcpy(s_udisk_file_buf, raw_app, sizeof(raw_app));
+    memcpy(&s_udisk_file_buf[sizeof(raw_app)], &tr, sizeof(tr));
+    s_udisk_file_size = (uint32_t)(sizeof(raw_app) + sizeof(tr));
+    snprintf(s_udisk_file_name, sizeof(s_udisk_file_name), "%s", "0:/fw_th.bin");
+    s_udisk_file_exists = true;
+    g_app_udisk_ready = true;
+
+    th_upgrade_mgr_init();
+    s_mock_tick_ms = 1200U;
+    th_upgrade_mgr_poll(s_mock_tick_ms);
+    require_true(s_state == TH_UPG_STATE_SCAN_UDISK, "IDLE -> SCAN_UDISK");
+    th_upgrade_mgr_poll(s_mock_tick_ms);
+    require_true(s_state == TH_UPG_STATE_SEND_SYS_CTRL, "valid trailer enters SEND_SYS_CTRL");
+
+    /* SEND_SYS_CTRL: 发送 0x1D (action=2)，严禁含 M997 或 5A A5 */
+    inject_th_resp(MINIMC_NODE_MC, MINIMC_CMD_ACK, 0x0801U, 4U);
+    th_upgrade_mgr_poll(s_mock_tick_ms);
+    require_true(s_last_th_tx[0] == 0x55U && s_last_th_tx[1] == 0xAAU && s_last_th_tx[5] == MINIMC_CMD_SYSTEM_CONTROL, "0x1D v2 frame");
+    require_true(s_state == TH_UPG_STATE_WAIT_BOOT_VER, "transitions to WAIT_BOOT_VER");
+
+    /* WAIT_BOOT_VER -> START_HANDSHAKE (0x20, 144B) -> STREAM_CHUNKS (0x21) -> FINISH (0x22) -> SUCCESS */
+    inject_th_resp(MINIMC_NODE_MC, MINIMC_CMD_VERSION_REPORT, 0x0802U, 16U);
+    th_upgrade_mgr_poll(s_mock_tick_ms);
+    require_true(s_state == TH_UPG_STATE_START_HANDSHAKE, "BOOT_MODE verified -> START_HANDSHAKE");
+    inject_th_resp(MINIMC_NODE_MC, MINIMC_CMD_ACK, 0x0803U, 4U);
+    th_upgrade_mgr_poll(s_mock_tick_ms);
+    require_true(s_last_th_tx_len == 158U && s_last_th_tx[5] == MINIMC_CMD_OTA_START && s_state == TH_UPG_STATE_STREAM_CHUNKS, "0x20 144B sent");
+    inject_th_resp(MINIMC_NODE_MC, MINIMC_CMD_ACK, 0x0804U, 4U);
+    th_upgrade_mgr_poll(s_mock_tick_ms);
+    require_true(s_last_th_tx[5] == MINIMC_CMD_OTA_DATA && s_state == TH_UPG_STATE_STREAM_CHUNKS, "0x21 chunk 0 sent");
+    th_upgrade_mgr_poll(s_mock_tick_ms);
+    require_true(s_state == TH_UPG_STATE_FINISH, "all chunks streamed -> FINISH");
+    inject_th_resp(MINIMC_NODE_MC, MINIMC_CMD_ACK, 0x0805U, 4U);
+    th_upgrade_mgr_poll(s_mock_tick_ms);
+    require_true(s_last_th_tx[5] == MINIMC_CMD_OTA_FINISH && s_state == TH_UPG_STATE_SUCCESS, "0x22 sent -> SUCCESS");
+}
