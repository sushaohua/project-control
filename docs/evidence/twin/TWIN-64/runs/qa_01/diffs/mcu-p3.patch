+/**
+ * @brief 测试主入口
+ */
+int main(void)
+{
+    void *p = mmap((void *)0x40020000, 0x10000, PROT_READ | PROT_WRITE,
+                   MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0);
+    require_true(p != MAP_FAILED, "mmap peripheral space 0x40020000");
+    test_rev204_constants_and_estop();
+    test_mc_sys_ctrl_0x1d_gate_and_magic();
+    test_th_proxy_534b_relay_and_5000ms_recovery();
+    test_th_upgrade_mgr_v2_flow();
+    printf("[PASS] test_mc_ota_and_relay: all TWIN-64 MC App OTA & 534B relay tests passed!\n");
+    return 0;
+}
