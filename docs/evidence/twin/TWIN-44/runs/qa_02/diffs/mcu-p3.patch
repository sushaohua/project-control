+static void main_init_usarts_and_periph(void)
+{
+    static const char k_boot_banner[] =
+        "\r\n[MC_APP] === Marlin Motion Controller Started (Base: 0x08020000) ===\r\n";
+
+    wk_usart1_init();
+    printf("[MC_APP][TEST] printf float test: %f, %4.2f, %g\r\n", 123.456f, 78.9f, 0.00123);
+
+    wk_usart2_init();
+    wk_dma1_channel6_init();
+    minimc_proto_init();
+    (void)mc_debug_write(k_boot_banner, (uint16_t)(sizeof(k_boot_banner) - 1U));
+    mc_debug_poll_drain();
+
+    wk_usb_otgfs1_init();
+    usbh_init(&otg_core_struct, USB_FULL_SPEED_CORE_ID, USB_ID,
+              &uhost_msc_class_handler, &usbh_user_handle);
+    th_upgrade_mgr_init();
+
+    wk_spi2_init();
+    wk_i2c2_init();
+    wk_adc1_init();
+    wk_exint_config();
+    wk_sdio1_init();
+    wk_gpio_config();
+    wk_tmr2_init();
+    wk_tmr3_init();
+    wk_tmr4_init();
+    wk_tmr5_init();
+    wk_tmr7_init();
+}
+
+static void main_init_marlin_modules(void)
+{
+    tmr_counter_enable(TMR3, TRUE);
+    tmr_counter_enable(TMR4, TRUE);
+    tmr_period_value_set(TMR5, 1999);
+
+    lcd_t300spro_init();
+    eeprom_Init();
+    para_reset(true);
+    Board_init();
+    Fans_Init();
+    UI_Data_Init();
+    Heater_reset(&Extruder_One, EX1);
+    CoolingFan_reset(&Extruder_One.Fan);
+    Heater_reset(&Platform, HBP);
+    setup();
+    poweroff_startup();
+    Set_Fan_Power(0, 0);
+    Led_Power_On();
+    BottomBox_Fans_On();
+}
+
+static void main_poll_debug_and_perf(void)
+{
+    static const char k_hb_msg[] = "[MC_APP] Heartbeat alive (Marlin Loop OK)\r\n";
+    static uint32_t s_last_mc_hb = 0U;
+    const uint32_t now_ms = wk_timebase_get();
+
+    if ((uint32_t)(now_ms - s_last_mc_hb) >= 2000U)
+    {
+        s_last_mc_hb = now_ms;
+        (void)mc_debug_write(k_hb_msg, (uint16_t)(sizeof(k_hb_msg) - 1U));
+    }
+    mc_debug_poll_drain();
+
+    if (usart_flag_get(USART1, USART_RDBF_FLAG) != RESET)
+    {
+        uint8_t ch = (uint8_t)usart_data_receive(USART1);
+        if (ch == (uint8_t)'T')
+        {
+            mc_th_usart_perf_test(500U);
+        }
+    }
+}
+
+static void main_loop_step(void)
+{
+    usbh_loop_handler(&otg_core_struct.host);
+    th_upgrade_mgr_poll(wk_timebase_get());
+    minimc_proto_poll();
+    mc_debug_poll_drain();
+
+    poweroff_setup_handler();
+    runBoardSlice();
+    StopPrintHandle();
+    loop();
+
+    if (UI_Page_info.Current_Page_Id != PAGE_TIPS_SUSPEND_PRINT_ID)
+    {
+        UI_Data_handle();
+    }
+    if (UI_Page_info.print_pause_flag == 1)
+    {
+        UI_Page_info.print_pause_flag = 0;
+        Printing_pause_control();
+    }
+    Panel_LED_Display();
+    main_poll_debug_and_perf();
 }
