+    test_tx_fail_suppresses_false_ack();
+    test_relay_and_negative_error_cases();
+    printf("------------------------------------------------------------------------\n");
+    printf("All 6 TWIN-44 test suites PASSED!\n");
+    printf("========================================================================\n");
+    return 0;
+}
