+}
+
+uint32_t mc_debug_get_trunc_count(void)
+{
+    return s_mc_dbg_trunc_count;
+}
+
+bool mc_debug_write(const char *buf, uint16_t len)
+{
+    if ((buf == NULL) || (len == 0U) || (!s_mc_dbg_enabled))
+    {
+        return false;
+    }
+    const bool is_truncated = (len > MC_DBG_LINE_MAX_LEN);
+    const uint16_t write_len = is_truncated ? MC_DBG_LINE_MAX_LEN : len;
+    if (mc_dbg_ring_free_space() < write_len)
+    {
+        s_mc_dbg_drop_count++;
+        return false;
+    }
+    if (is_truncated)
+    {
+        s_mc_dbg_trunc_count++;
+        mc_dbg_ring_push_bytes(buf, (uint16_t)(MC_DBG_LINE_MAX_LEN - 5U));
+        mc_dbg_ring_push_bytes("...\r\n", 5U);
+        return true;
+    }
+    mc_dbg_ring_push_bytes(buf, len);
+    return true;
+}
