+static void main_init_clocks_and_dma(void)
+{
+    SCB->VTOR = 0x08020000U;
+    __DSB();
+    __ISB();
+
+    wk_system_clock_config();
+    wk_periph_clock_config();
+    wk_nvic_config();
+    wk_timebase_init();
+    __enable_irq();
+
+    wk_dma1_channel2_init();
