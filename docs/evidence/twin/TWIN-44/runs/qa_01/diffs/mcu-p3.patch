+static void mc_dbg_format_temp_kv(char *out_kv, size_t cap)
+{
+    if ((out_kv == NULL) || (cap == 0U))
+    {
+        return;
+    }
+    (void)snprintf(
+        out_kv,
+        cap,
+        "nozzle_ddC=%d nozzle_set_ddC=%d bed_ddC=%d bed_set_ddC=%d heater_fault=%u",
+        (int)s_dbg_state.nozzle_ddC,
+        (int)s_dbg_state.nozzle_set_ddC,
+        (int)s_dbg_state.bed_ddC,
+        (int)s_dbg_state.bed_set_ddC,
+        (unsigned int)s_dbg_state.heater_fault);
+}
+
+static void mc_dbg_format_motion_kv(const char *op_str, char *out_kv, size_t cap)
+{
+    if ((op_str == NULL) || (out_kv == NULL) || (cap == 0U))
+    {
+        return;
+    }
+    const int32_t x_x100 = pos_mm_to_um(current_position[X_AXIS]) / 10;
+    const int32_t y_x100 = pos_mm_to_um(current_position[Y_AXIS]) / 10;
+    const int32_t z_x100 = pos_mm_to_um(current_position[Z_AXIS]) / 10;
+    const uint8_t h_mask = query_homed_mask();
+    const char *m_state = mc_dbg_motion_state_str(query_motion_state());
+    (void)snprintf(
+        out_kv,
+        cap,
+        "op=%s axes_mask=0x%02X x_mm_x100=%ld y_mm_x100=%ld z_mm_x100=%ld feed=%u homed_mask=0x%02X motion_state=%s",
+        op_str,
+        (unsigned int)s_dbg_state.axes_mask,
+        (long)x_x100,
+        (long)y_x100,
+        (long)z_x100,
+        (unsigned int)s_dbg_state.feed,
+        (unsigned int)h_mask,
+        m_state);
+}
+
+static void mc_dbg_format_level_kv(const char *op_str, uint8_t probe_idx, char *out_kv, size_t cap)
+{
+    if ((op_str == NULL) || (out_kv == NULL) || (cap == 0U))
+    {
+        return;
+    }
+    const uint8_t safe_idx = (probe_idx < MINIMC_LEVEL_GRID_POINTS_NUM) ? probe_idx : 0U;
+    const uint8_t gx = (uint8_t)(safe_idx % MINIMC_LEVEL_GRID_POINTS_X);
+    const uint8_t gy = (uint8_t)(safe_idx / MINIMC_LEVEL_GRID_POINTS_X);
+    const int32_t z_um = (int32_t)level_mm_to_um(bed_level[gx][gy]);
+    (void)snprintf(
+        out_kv,
+        cap,
+        "op=%s probe_idx=%u z_offset_um=%ld grid_valid=1 status=DONE",
+        op_str,
+        (unsigned int)safe_idx,
+        (long)z_um);
+}
+
+static void mc_dbg_format_filament_kv(const char *op_str, uint8_t slot, const char *step_str, char *out_kv)
+{
+    if ((op_str == NULL) || (step_str == NULL) || (out_kv == NULL))
+    {
+        return;
+    }
+    (void)snprintf(
+        out_kv,
+        128U,
+        "op=%s slot=%u active_slot=%u filament_present_mask=0x%02X step_state=%s",
+        op_str,
+        (unsigned int)slot,
+        (unsigned int)s_dbg_state.active_slot,
+        (unsigned int)s_dbg_state.filament_mask,
+        step_str);
+}
+
+static void mc_dbg_format_job_kv(char *out_kv, size_t cap)
+{
+    if ((out_kv == NULL) || (cap == 0U))
+    {
+        return;
+    }
+    const char *j_str = mc_dbg_job_state_str(s_dbg_state.job_state_id);
+    (void)snprintf(
+        out_kv,
+        cap,
+        "job_state=%s progress_permille=%u ack_seq=%u",
+        j_str,
+        (unsigned int)s_dbg_state.progress_permille,
+        (unsigned int)s_dbg_state.ack_seq);
