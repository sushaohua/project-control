+
+static void mc_dbg_emit(const mc_dbg_meta_t *meta, const char *kv_str)
+{
+    if ((meta == NULL) || (!s_mc_dbg_enabled))
+    {
+        return;
+    }
+    char line_buf[256];
+    const uint32_t ts_ms = wk_timebase_get();
+    const char *extra = (kv_str != NULL) ? kv_str : "";
+    const char *sep = (extra[0] != '\0') ? " " : "";
+    const int n = snprintf(
+        line_buf,
+        sizeof(line_buf),
+        "[MC-DBG] ts=%lu dir=%s node=%s seq=%u cmd=0x%02X status=%s %s%sdrop=%lu trunc=%lu\r\n",
+        (unsigned long)ts_ms,
+        meta->dir,
+        meta->node,
+        (unsigned int)meta->seq,
+        (unsigned int)meta->cmd,
+        meta->status,
+        extra,
+        sep,
+        (unsigned long)s_mc_dbg_drop_count,
+        (unsigned long)s_mc_dbg_trunc_count);
+    if (n > 0)
+    {
+        (void)mc_debug_write(line_buf, (uint16_t)n);
+    }
+}
+
+static const char *mc_dbg_node_name(uint8_t node_id)
+{
+    if (node_id == MINIMC_NODE_AP)
+    {
+        return "AP";
+    }
+    if (node_id == MINIMC_NODE_TH)
+    {
+        return "TH";
+    }
+    return "MC";
+}
+
+static const char *mc_dbg_motion_state_str(uint8_t state)
+{
+    if (state == MINIMC_MOTION_STATE_HOMING)
+    {
+        return "HOMING";
+    }
+    if (state == MINIMC_MOTION_STATE_MOVING)
+    {
+        return "MOVING";
+    }
+    if (state == MINIMC_MOTION_STATE_FAULT)
+    {
+        return "ERR";
+    }
+    return "IDLE";
+}
+
+static const char *mc_dbg_job_state_str(uint8_t state_id)
+{
+    if (is_paused != 0U)
+    {
+        return "PAUSED";
+    }
+    if (state_id == 1U)
+    {
+        return "PREPARING";
+    }
+    if (state_id == 2U)
+    {
+        return "PRINTING";
+    }
+    if (state_id == 3U)
+    {
+        return "PAUSED";
+    }
+    if (state_id == 4U)
+    {
+        return "COMPLETED";
+    }
+    if (state_id == 5U)
+    {
+        return "ABORTED";
+    }
+    if (state_id == 6U)
+    {
+        return "FAULT";
+    }
+    return "IDLE";
+}
