+static uint16_t mc_dbg_ring_free_space(void)
+{
+    uint16_t used;
+    if (s_mc_dbg_head >= s_mc_dbg_tail)
+    {
+        used = (uint16_t)(s_mc_dbg_head - s_mc_dbg_tail);
+    }
+    else
+    {
+        used = (uint16_t)((MC_DBG_RING_CAPACITY - s_mc_dbg_tail) + s_mc_dbg_head);
+    }
+    return (uint16_t)((MC_DBG_RING_CAPACITY - 1U) - used);
+}
+
+static void mc_dbg_ring_push_bytes(const char *src, uint16_t count)
+{
+    if ((src == NULL) || (count == 0U))
+    {
+        return;
+    }
+    for (uint16_t i = 0U; i < count; ++i)
+    {
+        s_mc_dbg_ring[s_mc_dbg_head] = (uint8_t)src[i];
+        s_mc_dbg_head = (uint16_t)((s_mc_dbg_head + 1U) % MC_DBG_RING_CAPACITY);
+    }
+}
