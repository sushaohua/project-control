+def _configure_serial_port(fd: int, baud: int) -> None:
+    """使用 termios 将串口文件描述符配置为 8N1 原始模式 (raw mode) 与指定波特率。"""
+    # 映射标准波特率常量并关闭回显、规范模式及软件流控，确保二进制帧透明传输
+    baud_map = {
+        9600: termios.B9600,
+        115200: termios.B115200,
+        230400: termios.B230400,
+        460800: getattr(termios, "B460800", termios.B115200),
+        921600: getattr(termios, "B921600", termios.B115200),
+    }
+    b_const = baud_map.get(baud, getattr(termios, "B921600", termios.B115200))
+    attrs = termios.tcgetattr(fd)
+    attrs[0] = 0
+    attrs[1] = 0
+    attrs[2] = termios.CS8 | termios.CREAD | termios.CLOCAL | b_const
+    attrs[3] = 0
+    attrs[4] = b_const
+    attrs[5] = b_const
+    termios.tcsetattr(fd, termios.TCSANOW, attrs)
+
+
+class SerialOtaTarget:
+    """基于操作系统真实串口/PTY 文件描述符的 MiniMCProto v2.0 硬件通信靶机。"""
+
+    def __init__(self, port: str, baud: int = 921600, timeout_s: float = 1.2) -> None:
+        """打开目标串口设备并配置 termios 8N1 原始帧传输参数。"""
+        # 保存串口路径、波特率与超时配置，以非阻塞读写模式打开设备并应用 termios 配置
+        self.port = port
+        self.baud = baud
+        self.timeout_s = timeout_s
+        self.fd = os.open(port, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
+        _configure_serial_port(self.fd, baud)
+
+    def close(self) -> None:
+        """关闭已打开的串口文件描述符。"""
+        # 确保底层文件描述符仅关闭一次并置为 -1
+        if self.fd >= 0:
+            os.close(self.fd)
+            self.fd = -1
+
+    def _read_until_len(self, buf: bytearray, target_len: int, deadline: float) -> bool:
+        """在截止时间前从串口循环读取字节直至缓冲区达到 target_len。"""
+        # 通过 select 监听可读事件并拼接字节流，避免忙轮询
+        while len(buf) < target_len:
+            rem = deadline - time.monotonic()
+            if rem <= 0:
+                return False
+            rlist, _, _ = select.select([self.fd], [], [], rem)
+            if not rlist:
+                return False
+            chunk = os.read(self.fd, target_len - len(buf))
+            if not chunk:
+                return False
+            buf.extend(chunk)
+        return True
+
+    def exchange_frame(self, raw_req: bytes) -> bytes:
+        """向串口写入 MiniMCProto v2.0 请求帧并按 12B 帧头定界读取完整响应帧。"""
+        # 先将请求帧完整写入串口 fd，再按 0x55 0xAA 同步头与 payload_len 读取完整响应帧
+        deadline = time.monotonic() + self.timeout_s
+        mv = memoryview(raw_req)
+        sent = 0
+        while sent < len(raw_req):
+            rem = deadline - time.monotonic()
+            if rem <= 0:
+                return b""
+            _, wlist, _ = select.select([], [self.fd], [], rem)
+            if not wlist:
+                return b""
+            sent += os.write(self.fd, mv[sent:])
+        rx_buf = bytearray()
+        while time.monotonic() < deadline:
+            if not self._read_until_len(rx_buf, 2, deadline):
+                return b""
+            if rx_buf[0] == SOF_0 and rx_buf[1] == SOF_1:
+                break
+            del rx_buf[0]
+        if not self._read_until_len(rx_buf, 12, deadline):
+            return b""
+        plen = struct.unpack("<H", rx_buf[10:12])[0]
+        if plen > 1024 or not self._read_until_len(rx_buf, 14 + plen, deadline):
+            return b""
+        return bytes(rx_buf[: 14 + plen])
+
