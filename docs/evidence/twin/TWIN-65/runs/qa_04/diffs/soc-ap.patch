+/**
+ * @brief 测试 3：验证四条件安全准入门禁与 UPGRADING_MAINTENANCE 期间 1.5s/3.0s 衰退抑制
+ */
+static void test_safety_gate_and_maintenance_decay_suppression(void) {
+    std::printf("[RUN ] test_safety_gate_and_maintenance_decay_suppression\n");
+    device_manager_state_t dev = {};
+    init_valid_dev_temps(&dev);
+
+    dev_admission_res_t adm_res = {};
+    dev_ota_safety_ctx_t safe_ctx = { 1U, 0U, 0, 0, 0U, 0U, false };
+    assert(dev_state_check_ota_admission(&dev, &safe_ctx, &adm_res) == AISOC_DEV_ERR_NOT_SAFE_FOR_OTA);
+    safe_ctx = { 0U, 1U, 0, 0, 0U, 0U, false };
+    assert(dev_state_check_ota_admission(&dev, &safe_ctx, &adm_res) == AISOC_DEV_ERR_NOT_SAFE_FOR_OTA);
+    safe_ctx = { 0U, 0U, 600, 0, 0U, 0U, false };
+    assert(dev_state_check_ota_admission(&dev, &safe_ctx, &adm_res) == AISOC_DEV_ERR_NOT_SAFE_FOR_OTA);
+    safe_ctx = { 0U, 0U, 0, 0, 0U, 50U, false };
+    assert(dev_state_check_ota_admission(&dev, &safe_ctx, &adm_res) == AISOC_DEV_ERR_NOT_SAFE_FOR_OTA);
+    safe_ctx = { 0U, 0U, 0, 0, 0U, 0U, false };
+    assert(dev_state_check_ota_admission(&dev, &safe_ctx, &adm_res) == AISOC_DEV_OK);
+
+    assert(dev_state_enter_maintenance(&dev) == AISOC_DEV_OK);
+
+    /* 推进 +10s（远超 3.0s）：维护态下严禁误判 OFFLINE 或打入 2147483646 哨兵 */
+    (void)dev_state_eval_freshness(&dev, 11000000000ULL);
+    assert(dev.snapshot.bed_temp_millic == 60000);
+    assert(dev.snapshot.tool_temp_millic == 210000);
+    (void)dev_state_check_admission(&dev, "UI_GATEWAY", &adm_res);
+    assert(!adm_res.accepted);
+
+    char snap[2048] = {0};
+    (void)dev_state_get_snapshot_json(&dev, snap, sizeof(snap));
+    assert(std::strstr(snap, "\"device_state\":\"UPGRADING_MAINTENANCE\"") != nullptr);
+    assert(std::strstr(snap, "\"quality\":\"MAINTENANCE_HOLD\"") != nullptr);
+    std::printf("[PASS] test_safety_gate_and_maintenance_decay_suppression\n");
+}
