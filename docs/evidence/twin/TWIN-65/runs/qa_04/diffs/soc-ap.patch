+    }
+    if (safety->mc_state != 0U) {
+        strncpy(out_res->reason, "OTA_REJECTED_MOTION_MOVING", sizeof(out_res->reason) - 1U);
+        return AISOC_DEV_ERR_NOT_SAFE_FOR_OTA;
+    }
+    const bool heater_off = !state->is_heating &&
+        (safety->target_bed_deci_c <= 0) && (safety->target_tool_deci_c <= 0) &&
+        (safety->bed_heater_duty == 0U) && (safety->tool_heater_duty == 0U);
+    if (!heater_off) {
+        strncpy(out_res->reason, "OTA_REJECTED_HEATER_ACTIVE", sizeof(out_res->reason) - 1U);
+        return AISOC_DEV_ERR_NOT_SAFE_FOR_OTA;
+    }
+    if (!safety->recovery_mode) {
+        const bool temp_valid =
+            (state->snapshot.bed_temp_millic != AISOC_TEMP_MILLIC_FAULT) &&
+            (state->snapshot.bed_temp_millic != AISOC_TEMP_MILLIC_OFFLINE) &&
+            (state->snapshot.tool_temp_millic != AISOC_TEMP_MILLIC_FAULT) &&
+            (state->snapshot.tool_temp_millic != AISOC_TEMP_MILLIC_OFFLINE) &&
+            (state->snapshot.bed_sensor_status == (uint32_t)AISOC_SENSOR_OK) &&
+            (state->snapshot.tool_sensor_status == (uint32_t)AISOC_SENSOR_OK);
+        if (!temp_valid) {
+            strncpy(out_res->reason, "OTA_REJECTED_TEMP_SENSOR_INVALID", sizeof(out_res->reason) - 1U);
+            return AISOC_DEV_ERR_NOT_SAFE_FOR_OTA;
+        }
+    }
+    out_res->accepted = true;
+    strncpy(out_res->reason, "SAFE_FOR_OTA", sizeof(out_res->reason) - 1U);
+    return AISOC_DEV_OK;
+}
+
+/**
+ * @brief 进入 UPGRADING_MAINTENANCE 固件升级维护锁定态，暂停常规 1.5s/3.0s 遥测超时衰退
+ */
+aisoc_dev_status_t dev_state_enter_maintenance(device_manager_state_t* state) {
+    if (state == nullptr) {
+        return AISOC_DEV_ERR_NULL_PTR;
+    }
+    state->is_maintenance = true;
+    state->ota_recovery_pending = false;
+    state->is_fault = false;
+    strncpy(state->device_state, "UPGRADING_MAINTENANCE", sizeof(state->device_state) - 1U);
+    strncpy(state->snapshot.system_status_desc, "UPGRADING_MAINTENANCE", sizeof(state->snapshot.system_status_desc) - 1U);
+    return AISOC_DEV_OK;
+}
+
+/**
+ * @brief 退出 UPGRADING_MAINTENANCE 维护态（支持标记 OTA_RECOVERY_PENDING 待重连恢复）
+ */
+aisoc_dev_status_t dev_state_exit_maintenance(
+    device_manager_state_t* state,
+    bool recovery_pending
+) {
+    if (state == nullptr) {
+        return AISOC_DEV_ERR_NULL_PTR;
+    }
+    state->is_maintenance = false;
+    state->ota_recovery_pending = recovery_pending;
+    if (recovery_pending) {
+        strncpy(state->device_state, "OTA_RECOVERY_PENDING", sizeof(state->device_state) - 1U);
+        strncpy(state->snapshot.system_status_desc, "OTA_RECOVERY_PENDING", sizeof(state->snapshot.system_status_desc) - 1U);
+    } else {
+        strncpy(state->device_state, "IDLE", sizeof(state->device_state) - 1U);
+        update_system_status_desc(state);
+    }
+    return AISOC_DEV_OK;
+}
