+/**
+ * @brief 测试 2：验证 128B ATSG Trailer 离线预检对错 board_id、坏 SHA-256、坏 trailer_crc32 与 241,665B 超限的拒绝
+ */
+static void test_offline_precheck_negative_cases(void) {
+    std::printf("[RUN ] test_offline_precheck_negative_cases\n");
+    static uint8_t s_big_buf[250000];
+    size_t total_len = 0U;
+    const synth_pkg_cfg_t ok_cfg = { MINIMC_BOARD_ID_TH, 0x02010000UL, 0x6356C05AUL, 1024U };
+    build_valid_atsg_package(&ok_cfg, s_big_buf, &total_len);
+
+    fw_sealed_package_t pkg = {};
+    /* 1. 目标节点与 board_id 不匹配（用 TH 包刷 MC） */
+    assert(fw_updater_verify_buffer(s_big_buf, total_len, MINIMC_NODE_MC, &pkg) == AISOC_DEV_ERR_INVALID_ARG);
+
+    /* 2. 篡改裸镜像 1 字节破坏 SHA-256 */
+    s_big_buf[100] ^= 0xFFU;
+    assert(fw_updater_verify_buffer(s_big_buf, total_len, MINIMC_NODE_TH, &pkg) == AISOC_DEV_ERR_INVALID_ARG);
+    s_big_buf[100] ^= 0xFFU;
+
+    /* 3. 篡改 trailer_crc32 */
+    s_big_buf[total_len - 1U] ^= 0xAAU;
+    assert(fw_updater_verify_buffer(s_big_buf, total_len, MINIMC_NODE_TH, &pkg) == AISOC_DEV_ERR_INVALID_ARG);
+
+    /* 4. TH 镜像达到 241,665B（超过 236KB = 241,664B 上限）必须拒绝 */
+    const synth_pkg_cfg_t over_cfg = { MINIMC_BOARD_ID_TH, 0x02010000UL, 0x6356C05AUL, 241665U };
+    build_valid_atsg_package(&over_cfg, s_big_buf, &total_len);
+    assert(fw_updater_verify_buffer(s_big_buf, total_len, MINIMC_NODE_TH, &pkg) == AISOC_DEV_ERR_INVALID_ARG);
+    std::printf("[PASS] test_offline_precheck_negative_cases\n");
+}
