+/**
+ * @brief 发送 OTA 请求帧并在指定超时与最大重试次数内等待响应（在持有 uart_mutex 下调用）
+ */
+static aisoc_fwd_status_t send_ota_with_retry_locked(
+    forward_service_state_t* state,
+    const fwd_frame_buf_t* tx_frame,
+    const fwd_ctrl_expect_t* expect,
+    fwd_ctrl_rx_t* out_rx
+) {
+    if (state == nullptr || tx_frame == nullptr || expect == nullptr || out_rx == nullptr) {
+        return AISOC_FWD_ERR_NULL_PTR;
+    }
+    if (!state->serial_ctx.is_open) {
+        fwd_uart_open(state);
+    }
+    if (!state->serial_ctx.is_open) {
+        record_fault_context(state, expect, 0U, AISOC_FWD_ERR_SERIAL_OPEN);
+        return AISOC_FWD_ERR_SERIAL_OPEN;
+    }
+    const uint8_t max_tries = 3U;
+    aisoc_fwd_status_t rx_st = AISOC_FWD_ERR_TIMEOUT;
+    for (uint8_t attempt = 0U; attempt < max_tries; ++attempt) {
+        const aisoc_fwd_status_t tx_st = fwd_uart_send_frame(state, tx_frame->data, tx_frame->length);
+        if (tx_st != AISOC_FWD_OK) {
+            record_fault_context(state, expect, 0U, tx_st);
+            return tx_st;
+        }
+        rx_st = fwd_uart_wait_ctrl_response(state, expect, out_rx);
+        const bool is_crc_nack = (rx_st == AISOC_FWD_ERR_NACK) &&
+            (out_rx->payload_len >= 2U) && (out_rx->payload[1] == MINIMC_ERR_OTA_CRC_MISMATCH);
+        if ((rx_st != AISOC_FWD_ERR_TIMEOUT && !is_crc_nack) || (attempt + 1U) >= max_tries) {
+            break;
+        }
+        usleep(10000);
+    }
+    if (rx_st != AISOC_FWD_OK) {
+        record_fault_context(state, expect, out_rx->elapsed_ms, rx_st);
+        return rx_st;
+    }
+    std::memset(&state->last_fault, 0, sizeof(state->last_fault));
+    return AISOC_FWD_OK;
+}
