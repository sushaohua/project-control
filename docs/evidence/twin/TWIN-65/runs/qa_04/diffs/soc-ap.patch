+/** @brief 模拟双节点升级传输层上下文结构体 */
+typedef struct {
+    bool in_boot[4];
+    uint32_t boot_id[4];
+    uint32_t fw_ver[4];
+    uint32_t git_commit[4];
+    uint32_t bytes_written[4];
+    uint16_t cached_chunk0[4];
+    bool fail_stage4_reboot;
+    uint8_t upgrade_order[4];
+    size_t order_cnt;
+    fw_confirm_stage_t stage_at_0x22_ack;
+    uint8_t progress_at_0x22_ack;
+    char text_at_0x22_ack[64];
+} mock_ota_bus_t;
+
+/** @brief 模拟 0x01->0x02 版本查询回调 */
+static bool mock_query_ver(void* ctx, uint8_t dst, minimc_payload_version_report_t* out_ver) {
+    mock_ota_bus_t* bus = (mock_ota_bus_t*)ctx;
+    out_ver->proto_major = 2U;
+    out_ver->proto_minor = 0U;
+    out_ver->major = (uint8_t)((bus->fw_ver[dst] >> 8U) & 0xFFU);
+    out_ver->minor = (uint8_t)(bus->fw_ver[dst] & 0xFFU);
+    out_ver->boot_id = bus->boot_id[dst];
+    out_ver->git_commit_short = bus->git_commit[dst];
+    out_ver->capability_flags = bus->in_boot[dst] ? MINIMC_CAP_FLAG_BOOT_MODE : 0x07UL;
+    return true;
+}
+
+/** @brief 模拟 0x14->0x15 鲜活温度查询回调 */
+static bool mock_query_temp(void* ctx, uint8_t dst, int16_t* out_temp_deci_c) {
+    const mock_ota_bus_t* bus = (const mock_ota_bus_t*)ctx;
+    if (bus->in_boot[dst]) return false;
+    *out_temp_deci_c = (dst == MINIMC_NODE_TH) ? 2100 : 600;
+    return true;
+}
+
+/** @brief 模拟 0x1D 进入 Bootloader 回调 */
+static bool mock_send_sys_ctrl(void* ctx, uint8_t dst, uint8_t action, uint8_t* out_nack_err) {
+    (void)action;
+    (void)out_nack_err;
+    mock_ota_bus_t* bus = (mock_ota_bus_t*)ctx;
+    bus->in_boot[dst] = true;
+    bus->boot_id[dst] += 0x10U;
+    return true;
+}
+
+/** @brief 模拟 0x20 OTA_START 握手回调 */
+static bool mock_ota_start(void* ctx, uint8_t dst, const minimc_payload_ota_start_t* req, uint8_t* out_nack) {
+    (void)req;
+    (void)out_nack;
+    mock_ota_bus_t* bus = (mock_ota_bus_t*)ctx;
+    bus->bytes_written[dst] = 0U;
+    bus->cached_chunk0[dst] = 0U;
+    bus->upgrade_order[bus->order_cnt++] = dst;
+    return true;
+}
+
+/** @brief 模拟 0x21 OTA_DATA 分块接收回调（chunk_0 缓存在 RAM，后续写入 Flash） */
+static bool mock_ota_chunk(void* ctx, uint8_t dst, uint32_t offset, const uint8_t* data, uint16_t len, uint8_t* out_nack) {
+    (void)data;
+    (void)out_nack;
+    mock_ota_bus_t* bus = (mock_ota_bus_t*)ctx;
+    if (offset == 0U) {
+        bus->cached_chunk0[dst] = len;
+        bus->bytes_written[dst] = 0U;
+    } else {
+        bus->bytes_written[dst] += len;
+    }
+    return true;
+}
+
+/** @brief 模拟 0x23 OTA_STATUS 查询回调 */
+static bool mock_ota_status(void* ctx, uint8_t dst, minimc_payload_ota_status_t* out_st) {
+    const mock_ota_bus_t* bus = (const mock_ota_bus_t*)ctx;
+    out_st->ota_state = 2U;
+    out_st->error_code = 0U;
+    out_st->cached_chunk0_bytes = bus->cached_chunk0[dst];
+    out_st->bytes_written = bus->bytes_written[dst];
+    return true;
+}
+
+/** @brief 模拟 0x22 OTA_FINISH 终验提交回调 */
+static bool mock_ota_finish(void* ctx, uint8_t dst, uint32_t size, uint32_t crc32, uint8_t* out_nack) {
+    (void)size;
+    (void)crc32;
+    (void)out_nack;
+    mock_ota_bus_t* bus = (mock_ota_bus_t*)ctx;
+    if (!bus->fail_stage4_reboot) {
+        bus->in_boot[dst] = false;
+        bus->boot_id[dst] += 0x1000U;
+        bus->fw_ver[dst] = (dst == MINIMC_NODE_TH) ? 0x0202UL : 0x0203UL;
+        bus->git_commit[dst] = (dst == MINIMC_NODE_TH) ? 0xAABBCCDDUL : 0x11223344UL;
+    }
+    return true;
+}
+
+/** @brief 捕获 Stage 3 转换瞬间的快照以证明 0x22 ACK 时绝不越级宣称 100% SUCCEEDED */
+static void on_stage_cb(void* ctx, const fw_updater_status_t* snap) {
+    mock_ota_bus_t* bus = (mock_ota_bus_t*)ctx;
+    if (snap->confirm_stage == FW_CONFIRM_STAGE_3_IMAGE_VERIFIED_COMMITTED) {
+        bus->stage_at_0x22_ack = snap->confirm_stage;
+        bus->progress_at_0x22_ack = snap->progress_pct;
+        std::snprintf(bus->text_at_0x22_ack, sizeof(bus->text_at_0x22_ack), "%s", snap->status_text);
+    }
+}
+
+/**
+ * @brief 测试 4：验证先 TH (0x03) 后 MC (0x02) 串行升级、Stage 1~4 硬隔离以及 Stage 4 失败转入 OTA_RECOVERY_PENDING
+ */
+static void test_serial_th_then_mc_and_stage4_hard_isolation(void) {
+    std::printf("[RUN ] test_serial_th_then_mc_and_stage4_hard_isolation\n");
+    uint8_t th_raw[2048], mc_raw[2048];
+    size_t th_len = 0U, mc_len = 0U;
+    const synth_pkg_cfg_t th_c = { MINIMC_BOARD_ID_TH, 0x0202UL, 0xAABBCCDDUL, 1024U };
+    const synth_pkg_cfg_t mc_c = { MINIMC_BOARD_ID_MC, 0x0203UL, 0x11223344UL, 1024U };
+    build_valid_atsg_package(&th_c, th_raw, &th_len);
+    build_valid_atsg_package(&mc_c, mc_raw, &mc_len);
+
+    fw_sealed_package_t th_pkg = {}, mc_pkg = {};
+    assert(fw_updater_verify_buffer(th_raw, th_len, MINIMC_NODE_TH, &th_pkg) == AISOC_DEV_OK);
+    assert(fw_updater_verify_buffer(mc_raw, mc_len, MINIMC_NODE_MC, &mc_pkg) == AISOC_DEV_OK);
+
+    mock_ota_bus_t bus = {};
+    bus.boot_id[MINIMC_NODE_TH] = 0x10U;
+    bus.boot_id[MINIMC_NODE_MC] = 0x20U;
+    fw_ota_transport_t tr = {
+        &bus, mock_query_ver, mock_query_temp, mock_send_sys_ctrl,
+        mock_ota_start, mock_ota_chunk, mock_ota_status, mock_ota_finish, on_stage_cb
+    };
+    device_manager_state_t dev = {};
+    init_valid_dev_temps(&dev);
+
+    dev_ota_safety_ctx_t safe = { 0U, 0U, 0, 0, 0U, 0U, false };
+    fw_upgrade_exec_cfg_t exec_cfg = { &dev, &safe, &tr, false, 3U };
+    fw_updater_status_t st = {};
+
+    assert(fw_updater_execute_batch(&exec_cfg, &th_pkg, &mc_pkg, &st) == AISOC_DEV_OK);
+    assert(bus.order_cnt == 2U && bus.upgrade_order[0] == MINIMC_NODE_TH && bus.upgrade_order[1] == MINIMC_NODE_MC);
+    assert(bus.stage_at_0x22_ack == FW_CONFIRM_STAGE_3_IMAGE_VERIFIED_COMMITTED);
+    assert(bus.progress_at_0x22_ack == 95U);
+    assert(std::strcmp(bus.text_at_0x22_ack, "IMAGE_VERIFIED_COMMITTED") == 0);
+    assert(st.confirm_stage == FW_CONFIRM_STAGE_4_NEW_APP_ONLINE_VERIFIED);
+    assert(st.progress_pct == 100U && std::strcmp(st.status_text, "SUCCEEDED") == 0);
+    assert(!dev.is_maintenance && !dev.ota_recovery_pending);
+
+    /* Stage 4 负例：0x22 ACK 后节点卡在 Bootloader 未跳回 App，必须转入 OTA_RECOVERY_PENDING */
+    bus.fail_stage4_reboot = true;
+    assert(fw_updater_execute_node(&exec_cfg, &th_pkg, &st) == AISOC_DEV_ERR_TIMEOUT);
+    assert(st.confirm_stage == FW_CONFIRM_STAGE_3_IMAGE_VERIFIED_COMMITTED);
+    assert(st.lifecycle_stage == FW_STAGE_OTA_RECOVERY_PENDING);
+    assert(std::strcmp(st.status_text, "OTA_RECOVERY_PENDING") == 0);
+    assert(dev.ota_recovery_pending == true);
+    std::printf("[PASS] test_serial_th_then_mc_and_stage4_hard_isolation\n");
+}
+
+int main(void) {
+    std::printf("=================================================================\n");
+    std::printf("Running TWIN-65 FirmwareUpdater & 4-Stage Confirmation Test Suite\n");
+    std::printf("=================================================================\n");
+    test_incoming_scanner_and_readonly_sealing();
+    test_offline_precheck_negative_cases();
+    test_safety_gate_and_maintenance_decay_suppression();
+    test_serial_th_then_mc_and_stage4_hard_isolation();
+    std::printf("=================================================================\n");
+    std::printf("All TWIN-65 FirmwareUpdater test suites PASSED!\n");
+    std::printf("=================================================================\n");
+    return 0;
+}
