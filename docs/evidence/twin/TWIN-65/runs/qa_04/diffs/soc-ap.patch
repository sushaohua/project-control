+ * @param path 请求路径字符串
+ * @return bool 属于受控路由返回 true
+ */
+static bool is_maintenance_locked_route(const char* path) {
+    if (path == nullptr) return false;
+    const char* locked[] = {
+        "/api/v1/temperature/set", "/api/v1/filament/slots", "/api/v1/gcode/execute",
+        "/api/v1/jobs/start", "/api/v1/jobs/pause", "/api/v1/jobs/resume",
+        "/api/v1/jobs/cancel", "/api/v1/motion/jog", "/api/v1/motion/home",
+        "/api/v1/leveling/trigger"
+    };
+    for (size_t i = 0U; i < sizeof(locked) / sizeof(locked[0]); ++i) {
+        if (std::strcmp(path, locked[i]) == 0) return true;
+    }
+    return false;
+}
+
+/**
+ * @brief 处理 GET /api/v1/ota/status 与 POST /api/v1/ota/trigger 固件升级状态及确认路由
+ * @param server 服务端实例指针
+ * @param client 客户端连接槽指针
+ * @param req 解析后的 HTTP 请求结构体只读指针
+ * @return bool 命中 OTA 路由返回 true
+ */
+static bool dispatch_ota_route(
+    ui_gw_server_t* server,
+    client_conn_t* client,
+    const http_request_t* req
+) {
+    if (server == nullptr || client == nullptr || req == nullptr) return false;
+    if (std::strcmp(req->path, "/api/v1/ota/status") == 0) {
+        const char* body = (server->ota_status_json[0] != '\0')
+            ? server->ota_status_json
+            : "{\"stage\":\"IDLE\",\"confirm_stage\":0,\"progress_pct\":0,\"is_maintenance\":false}";
+        send_json_and_close(client, 200, body);
+        return true;
+    }
+    if (std::strcmp(req->path, "/api/v1/ota/trigger") == 0) {
+        if (server->is_maintenance) {
+            send_409_maintenance(client, "UPGRADING_MAINTENANCE: upgrade already in progress");
+        } else {
+            send_json_and_close(client, 200, "{\"status\":\"ok\",\"message\":\"OTA upgrade confirmed\"}");
+        }
+        return true;
+    }
+    return false;
+}
