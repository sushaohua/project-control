+/**
+ * @brief 执行 0x23 (CMD_OTA_STATUS) 8字节固件升级写入进度查询停等闭环
+ */
+aisoc_fwd_status_t forward_service_ota_query_status(
+    forward_service_state_t* state,
+    uint8_t dst_id,
+    minimc_payload_ota_status_t* out_status
+) {
+    if (state == nullptr || out_status == nullptr) {
+        return AISOC_FWD_ERR_NULL_PTR;
+    }
+    pthread_mutex_lock(&state->uart_mutex);
+    uint8_t buf[64] = {0};
+    fwd_frame_buf_t fbuf = { buf, sizeof(buf), 0U };
+    const uint16_t seq = (uint16_t)(++state->next_seq);
+    const aisoc_fwd_status_t b_st = fwd_proto_build_ota_status_frame(dst_id, seq, &fbuf);
+    if (b_st != AISOC_FWD_OK) {
+        pthread_mutex_unlock(&state->uart_mutex);
+        return b_st;
+    }
+    const uint32_t tmo_ms = (dst_id == MINIMC_DEV_SCM_TH) ? 500U : 300U;
+    fwd_ctrl_expect_t expect = {
+        dst_id, seq, MINIMC_CMD_OTA_STATUS, MINIMC_CMD_OTA_STATUS,
+        MINIMC_OTA_STATUS_RESP_SIZE, tmo_ms
+    };
+    fwd_ctrl_rx_t rx = {};
+    const aisoc_fwd_status_t st = send_ota_with_retry_locked(state, &fbuf, &expect, &rx);
+    if (st == AISOC_FWD_OK) {
+        std::memcpy(out_status, rx.payload, sizeof(minimc_payload_ota_status_t));
+    }
+    pthread_mutex_unlock(&state->uart_mutex);
+    return st;
+}
+
+/**
+ * @brief 执行 0x22 (CMD_OTA_FINISH) 8字节全片 CRC32 校验与提交激活停等闭环
+ */
+aisoc_fwd_status_t forward_service_ota_finish(
+    forward_service_state_t* state,
+    uint8_t dst_id,
+    const minimc_payload_ota_finish_t* req
+) {
+    if (state == nullptr || req == nullptr) {
+        return AISOC_FWD_ERR_NULL_PTR;
+    }
+    pthread_mutex_lock(&state->uart_mutex);
+    uint8_t buf[64] = {0};
+    fwd_frame_buf_t fbuf = { buf, sizeof(buf), 0U };
+    const uint16_t seq = (uint16_t)(++state->next_seq);
+    const aisoc_fwd_status_t b_st = fwd_proto_build_ota_finish_frame(dst_id, req, seq, &fbuf);
+    if (b_st != AISOC_FWD_OK) {
+        pthread_mutex_unlock(&state->uart_mutex);
+        return b_st;
+    }
+    const uint32_t tmo_ms = (dst_id == MINIMC_DEV_SCM_TH) ? 4000U : 3000U;
+    fwd_ctrl_expect_t expect = { dst_id, seq, MINIMC_CMD_ACK, MINIMC_CMD_ACK, 0U, tmo_ms };
+    fwd_ctrl_rx_t rx = {};
+    const aisoc_fwd_status_t st = send_ota_with_retry_locked(state, &fbuf, &expect, &rx);
+    pthread_mutex_unlock(&state->uart_mutex);
+    return st;
+}
