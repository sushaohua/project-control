diff --git a/services/device_manager/firmware_updater.cpp b/services/device_manager/firmware_updater.cpp
new file mode 100644
index 0000000..46d2510
--- /dev/null
+++ b/services/device_manager/firmware_updater.cpp
@@ -0,0 +1,554 @@
+/**
+ * @file firmware_updater.cpp
+ * @brief SoC AP 统一固件升级编排器实现（TWIN-65：暂存扫描、只读封存、128B ATSG 预检与四阶段确认闭环）
+ * @details 遵循 project-control/.agents/rules/c_cpp_coding_standard.md 与 code_documentation_standard.md。
+ */
+
+#include "firmware_updater.h"
+#include <cstdio>
+#include <cstring>
+#include <dirent.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+/** @brief 静态双槽封存镜像缓存（槽 0 供 MC 0x02，槽 1 供 TH 0x03，零动态堆分配） */
+static uint8_t s_sealed_file_buf[2][920000];
+
+/** @brief SHA-256 64 轮常数表 */
+static const uint32_t k_sha256_k[64] = {
+    0x428a2f98UL, 0x71374491UL, 0xb5c0fbcfUL, 0xe9b5dba5UL,
+    0x3956c25bUL, 0x59f111f1UL, 0x923f82a4UL, 0xab1c5ed5UL,
+    0xd807aa98UL, 0x12835b01UL, 0x243185beUL, 0x550c7dc3UL,
+    0x72be5d74UL, 0x80deb1feUL, 0x9bdc06a7UL, 0xc19bf174UL,
+    0xe49b69c1UL, 0xefbe4786UL, 0x0fc19dc6UL, 0x240ca1ccUL,
+    0x2de92c6fUL, 0x4a7484aaUL, 0x5cb0a9dcUL, 0x76f988daUL,
+    0x983e5152UL, 0xa831c66dUL, 0xb00327c8UL, 0xbf597fc7UL,
+    0xc6e00bf3UL, 0xd5a79147UL, 0x06ca6351UL, 0x14292967UL,
+    0x27b70a85UL, 0x2e1b2138UL, 0x4d2c6dfcUL, 0x53380d13UL,
+    0x650a7354UL, 0x766a0abbUL, 0x81c2c92eUL, 0x92722c85UL,
+    0xa2bfe8a1UL, 0xa81a664bUL, 0xc24b8b70UL, 0xc76c51a3UL,
+    0xd192e819UL, 0xd6990624UL, 0xf40e3585UL, 0x106aa070UL,
+    0x19a4c116UL, 0x1e376c08UL, 0x2748774cUL, 0x34b0bcb5UL,
+    0x391c0cb3UL, 0x4ed8aa4aUL, 0x5b9cca4fUL, 0x682e6ff3UL,
+    0x748f82eeUL, 0x78a5636fUL, 0x84c87814UL, 0x8cc70208UL,
+    0x90befffaUL, 0xa4506cebUL, 0xbef9a3f7UL, 0xc67178f2UL
+};
+
+/**
+ * @brief 32 位无符号整数循环右移辅助函数
+ * @param x 待移位数值
+ * @param n 右移位数
+ * @return uint32_t 循环右移结果
+ */
+static uint32_t rotr32(uint32_t x, uint32_t n) {
+    return (x >> n) | (x << (32U - n));
+}
+
+/**
+ * @brief 执行单个 64 字节数据块的 SHA-256 压缩变换
+ * @param state 8 个 32 位哈希状态寄存器数组
+ * @param block 64 字节输入块指针
+ */
+static void sha256_transform_block(uint32_t state[8], const uint8_t block[64]) {
+    uint32_t w[64];
+    for (size_t i = 0U; i < 16U; ++i) {
+        const size_t j = i * 4U;
+        w[i] = ((uint32_t)block[j] << 24U) | ((uint32_t)block[j + 1U] << 16U) |
+               ((uint32_t)block[j + 2U] << 8U) | (uint32_t)block[j + 3U];
+    }
+    for (size_t i = 16U; i < 64U; ++i) {
+        const uint32_t s0 = rotr32(w[i - 15U], 7U) ^ rotr32(w[i - 15U], 18U) ^ (w[i - 15U] >> 3U);
+        const uint32_t s1 = rotr32(w[i - 2U], 17U) ^ rotr32(w[i - 2U], 19U) ^ (w[i - 2U] >> 10U);
+        w[i] = w[i - 16U] + s0 + w[i - 7U] + s1;
+    }
+    uint32_t v[8];
+    for (size_t i = 0U; i < 8U; ++i) v[i] = state[i];
+    for (size_t i = 0U; i < 64U; ++i) {
+        const uint32_t s1 = rotr32(v[4], 6U) ^ rotr32(v[4], 11U) ^ rotr32(v[4], 25U);
+        const uint32_t ch = (v[4] & v[5]) ^ ((~v[4]) & v[6]);
+        const uint32_t t1 = v[7] + s1 + ch + k_sha256_k[i] + w[i];
+        const uint32_t s0 = rotr32(v[0], 2U) ^ rotr32(v[0], 13U) ^ rotr32(v[0], 22U);
+        const uint32_t maj = (v[0] & v[1]) ^ (v[0] & v[2]) ^ (v[1] & v[2]);
+        const uint32_t t2 = s0 + maj;
+        v[7] = v[6]; v[6] = v[5]; v[5] = v[4]; v[4] = v[3] + t1;
+        v[3] = v[2]; v[2] = v[1]; v[1] = v[0]; v[0] = t1 + t2;
+    }
+    for (size_t i = 0U; i < 8U; ++i) state[i] += v[i];
+}
+
+/**
+ * @brief 计算字节缓冲区的 IEEE 802.3 CRC32 校验值（多项式 0xEDB88320）
+ * @param data 输入字节流只读指针
+ * @param len 字节长度
+ * @return uint32_t CRC32 计算结果
+ */
+uint32_t fw_updater_crc32(const uint8_t* data, size_t len) {
+    if (data == nullptr && len > 0U) {
+        return 0U;
+    }
+    uint32_t crc = 0xFFFFFFFFUL;
+    for (size_t i = 0U; i < len; ++i) {
+        crc ^= (uint32_t)data[i];
+        for (uint8_t b = 0U; b < 8U; ++b) {
+            const uint32_t mask = (uint32_t)(-(int32_t)(crc & 1UL));
+            crc = (crc >> 1U) ^ (0xEDB88320UL & mask);
+        }
+    }
+    return ~crc;
+}
+
+/**
+ * @brief 计算字节缓冲区的标准 FIPS 180-4 SHA-256 摘要
+ * @param data 输入字节流只读指针
+ * @param len 字节长度
+ * @param out_hash 32 字节摘要输出数组（非空）
+ * @return aisoc_dev_status_t 成功返回 AISOC_DEV_OK
+ */
+aisoc_dev_status_t fw_updater_sha256(
+    const uint8_t* data,
+    size_t len,
+    uint8_t out_hash[32]
+) {
+    if (out_hash == nullptr || (data == nullptr && len > 0U)) {
+        return AISOC_DEV_ERR_NULL_PTR;
+    }
+    uint32_t state[8] = {
+        0x6a09e667UL, 0xbb67ae85UL, 0x3c6ef372UL, 0xa54ff53aUL,
+        0x510e527fUL, 0x9b05688cUL, 0x1f83d9abUL, 0x5be0cd19UL
+    };
+    size_t offset = 0U;
+    while (offset + 64U <= len) {
+        sha256_transform_block(state, data + offset);
+        offset += 64U;
+    }
+    uint8_t tail[128];
+    std::memset(tail, 0, sizeof(tail));
+    const size_t rem = len - offset;
+    if (rem > 0U) std::memcpy(tail, data + offset, rem);
+    tail[rem] = 0x80U;
+    const size_t pad_blocks = (rem < 56U) ? 1U : 2U;
+    const uint64_t bit_len = (uint64_t)len * 8ULL;
+    for (size_t b = 0U; b < 8U; ++b) {
+        tail[pad_blocks * 64U - 1U - b] = (uint8_t)((bit_len >> (b * 8U)) & 0xFFU);
+    }
+    for (size_t blk = 0U; blk < pad_blocks; ++blk) {
+        sha256_transform_block(state, tail + blk * 64U);
+    }
+    for (size_t i = 0U; i < 8U; ++i) {
+        out_hash[i * 4U]      = (uint8_t)((state[i] >> 24U) & 0xFFU);
+        out_hash[i * 4U + 1U] = (uint8_t)((state[i] >> 16U) & 0xFFU);
+        out_hash[i * 4U + 2U] = (uint8_t)((state[i] >> 8U) & 0xFFU);
+        out_hash[i * 4U + 3U] = (uint8_t)(state[i] & 0xFFU);
+    }
+    return AISOC_DEV_OK;
+}
+
+/**
+ * @brief 检查文件名是否为完整的 .bin 固件文件（忽略 .part 未完成文件）
+ * @param name 文件名字符串
+ * @return bool 是完整 .bin 返回 true，否则返回 false
+ */
+static bool is_complete_bin_filename(const char* name) {
+    if (name == nullptr) return false;
+    const size_t len = std::strlen(name);
+    if (len < 5U) return false;
+    if (std::strstr(name, ".part") != nullptr) return false;
+    return (std::strcmp(name + len - 4U, ".bin") == 0);
+}
+
+/**
+ * @brief 扫描 incoming 目录：忽略 .part 文件，发现完整 .bin 时进入 PACKAGE_STAGED_PENDING_CONFIRM
+ * @param incoming_dir 暂存目录路径（非空）
+ * @param status 升级器状态结构体指针（非空）
+ * @return aisoc_dev_status_t 成功返回 AISOC_DEV_OK
+ */
+aisoc_dev_status_t fw_updater_scan_incoming(
+    const char* incoming_dir,
+    fw_updater_status_t* status
+) {
+    if (incoming_dir == nullptr || status == nullptr) {
+        return AISOC_DEV_ERR_NULL_PTR;
+    }
+    DIR* dir = opendir(incoming_dir);
+    if (dir == nullptr) {
+        return AISOC_DEV_ERR_INVALID_ARG;
+    }
+    status->staged_mc_file[0] = '\0';
+    status->staged_th_file[0] = '\0';
+    bool found_any = false;
+    struct dirent* ent = nullptr;
+    while ((ent = readdir(dir)) != nullptr) {
+        if (!is_complete_bin_filename(ent->d_name)) continue;
+        found_any = true;
+        if (std::strstr(ent->d_name, "th") != nullptr || std::strstr(ent->d_name, "TH") != nullptr) {
+            std::snprintf(status->staged_th_file, sizeof(status->staged_th_file), "%.120s", ent->d_name);
+        } else {
+            std::snprintf(status->staged_mc_file, sizeof(status->staged_mc_file), "%.120s", ent->d_name);
+        }
+    }
+    closedir(dir);
+    if (found_any) {
+        status->lifecycle_stage = FW_STAGE_PACKAGE_STAGED_PENDING_CONFIRM;
+        std::snprintf(status->status_text, sizeof(status->status_text), "PACKAGE_STAGED_PENDING_CONFIRM");
+    } else {
+        status->lifecycle_stage = FW_STAGE_IDLE;
+        std::snprintf(status->status_text, sizeof(status->status_text), "IDLE");
+    }
+    return AISOC_DEV_OK;
+}
+
+/**
+ * @brief 校验 128B ATSG 尾块的魔数、结构版本、目标 board_id、镜像尺寸上限及 trailer_crc32
+ * @param tr 128B 尾块结构体只读指针
+ * @param target_node 期望目标节点（0x02=MC, 0x03=TH）
+ * @return bool 校验通过返回 true
+ */
+static bool verify_trailer_header_and_limits(const minimc_fw_trailer_t* tr, uint8_t target_node) {
+    if (tr == nullptr) return false;
+    if (tr->magic != MINIMC_FW_TRAILER_MAGIC || tr->struct_version != MINIMC_FW_STRUCT_VER) {
+        return false;
+    }
+    const uint32_t expected_board = (target_node == MINIMC_NODE_TH)
+        ? MINIMC_BOARD_ID_TH : MINIMC_BOARD_ID_MC;
+    const uint32_t max_bytes = (target_node == MINIMC_NODE_TH)
+        ? MINIMC_TH_MAX_APP_BYTES : MINIMC_MC_MAX_APP_BYTES;
+    if (tr->board_id != expected_board || tr->payload_len == 0U || tr->payload_len > max_bytes) {
+        return false;
+    }
+    const uint32_t calc_tr_crc = fw_updater_crc32((const uint8_t*)tr, sizeof(minimc_fw_trailer_t) - 4U);
+    return (calc_tr_crc == tr->trailer_crc32);
+}
+
+/**
+ * @brief 对内存中的固件字节流（裸镜像 + 128B ATSG Trailer）执行离线预检并填充 0x20 请求
+ * @param raw_file_bytes 完整固件文件字节流指针（非空）
+ * @param total_file_len 完整固件文件总字节数
+ * @param target_node 期望目标节点 ID（0x02=MC, 0x03=TH）
+ * @param out_pkg 输出固件包描述符指针（非空）
+ * @return aisoc_dev_status_t 校验通过返回 AISOC_DEV_OK
+ */
+aisoc_dev_status_t fw_updater_verify_buffer(
+    const uint8_t* raw_file_bytes,
+    size_t total_file_len,
+    uint8_t target_node,
+    fw_sealed_package_t* out_pkg
+) {
+    if (raw_file_bytes == nullptr || out_pkg == nullptr) {
+        return AISOC_DEV_ERR_NULL_PTR;
+    }
+    if (total_file_len <= sizeof(minimc_fw_trailer_t)) {
+        return AISOC_DEV_ERR_INVALID_ARG;
+    }
+    const size_t payload_len = total_file_len - sizeof(minimc_fw_trailer_t);
+    minimc_fw_trailer_t tr;
+    std::memcpy(&tr, raw_file_bytes + payload_len, sizeof(tr));
+    if (tr.payload_len != (uint32_t)payload_len || !verify_trailer_header_and_limits(&tr, target_node)) {
+        return AISOC_DEV_ERR_INVALID_ARG;
+    }
+    uint8_t calc_sha[32];
+    if (fw_updater_sha256(raw_file_bytes, payload_len, calc_sha) != AISOC_DEV_OK ||
+        std::memcmp(calc_sha, tr.payload_sha256, 32U) != 0) {
+        return AISOC_DEV_ERR_INVALID_ARG;
+    }
+    out_pkg->target_node = target_node;
+    out_pkg->payload_len = (uint32_t)payload_len;
+    out_pkg->fw_crc32 = fw_updater_crc32(raw_file_bytes, payload_len);
+    out_pkg->trailer = tr;
+    out_pkg->payload_buf = raw_file_bytes;
+    out_pkg->start_req.target_device = target_node;
+    out_pkg->start_req.target_component = 1U;
+    out_pkg->start_req.force_flag = 0U;
+    out_pkg->start_req.reserved = 0U;
+    out_pkg->start_req.fw_size_bytes = out_pkg->payload_len;
+    out_pkg->start_req.fw_crc32 = out_pkg->fw_crc32;
+    out_pkg->start_req.fw_version_code = tr.version_code;
+    out_pkg->start_req.trailer = tr;
+    return AISOC_DEV_OK;
+}
+
+/**
+ * @brief 将源文件内容复制到封存目录并设置 0444 只读权限，同时加载至静态缓冲区
+ * @param src_path 源文件路径
+ * @param dst_path 目标封存文件路径
+ * @param buf 静态缓冲指针
+ * @param out_len 输出文件总长度指针
+ * @return bool 成功返回 true
+ */
+static bool copy_and_seal_readonly(
+    const char* src_path,
+    const char* dst_path,
+    uint8_t* buf,
+    size_t* out_len
+) {
+    if (src_path == nullptr || dst_path == nullptr || buf == nullptr || out_len == nullptr) return false;
+    FILE* fp_in = std::fopen(src_path, "rb");
+    if (fp_in == nullptr) return false;
+    const size_t n = std::fread(buf, 1U, sizeof(s_sealed_file_buf[0]), fp_in);
+    const int extra = std::fgetc(fp_in);
+    std::fclose(fp_in);
+    if (n <= sizeof(minimc_fw_trailer_t) || extra != EOF) return false;
+
+    (void)unlink(dst_path);
+    FILE* fp_out = std::fopen(dst_path, "wb");
+    if (fp_out == nullptr) return false;
+    const size_t written = std::fwrite(buf, 1U, n, fp_out);
+    std::fclose(fp_out);
+    if (written != n || chmod(dst_path, 0444) != 0) return false;
+    *out_len = n;
+    return true;
+}
+
+/**
+ * @brief 将暂存镜像复制封存至只读目录（0444）并执行 128B ATSG 尾块、SHA-256 与尺寸上限离线预检
+ * @param src_path 源固件文件路径（非空）
+ * @param sealed_dir 封存目标目录路径（非空）
+ * @param target_node 期望目标节点 ID（0x02=MC, 0x03=TH）
+ * @param out_pkg 输出封存并校验通过的固件包描述符指针（非空）
+ * @return aisoc_dev_status_t 校验通过返回 AISOC_DEV_OK
+ */
+aisoc_dev_status_t fw_updater_seal_and_verify_file(
+    const char* src_path,
+    const char* sealed_dir,
+    uint8_t target_node,
+    fw_sealed_package_t* out_pkg
+) {
+    if (src_path == nullptr || sealed_dir == nullptr || out_pkg == nullptr) {
+        return AISOC_DEV_ERR_NULL_PTR;
+    }
+    (void)mkdir(sealed_dir, 0755);
+    const char* base = std::strrchr(src_path, '/');
+    const char* fname = (base != nullptr) ? (base + 1) : src_path;
+    std::memset(out_pkg, 0, sizeof(*out_pkg));
+    std::snprintf(out_pkg->sealed_path, sizeof(out_pkg->sealed_path), "%s/%s", sealed_dir, fname);
+
+    const size_t slot = (target_node == MINIMC_NODE_TH) ? 1U : 0U;
+    size_t total_len = 0U;
+    if (!copy_and_seal_readonly(src_path, out_pkg->sealed_path, s_sealed_file_buf[slot], &total_len)) {
+        return AISOC_DEV_ERR_INVALID_ARG;
+    }
+    return fw_updater_verify_buffer(s_sealed_file_buf[slot], total_len, target_node, out_pkg);
+}
+
+/**
+ * @brief 更新升级状态快照并触发可选的阶段变更回调钩子
+ * @param tr 传输层接口指针
+ * @param st 状态快照指针
+ * @param stage 四阶段确认等级
+ * @param text 状态文本字符串
+ */
+static void update_confirm_stage(
+    const fw_ota_transport_t* tr,
+    fw_updater_status_t* st,
+    fw_confirm_stage_t stage,
+    const char* text
+) {
+    if (st == nullptr || text == nullptr) return;
+    st->confirm_stage = stage;
+    std::snprintf(st->status_text, sizeof(st->status_text), "%s", text);
+    if (tr != nullptr && tr->on_stage_transition != nullptr) {
+        tr->on_stage_transition(tr->user_ctx, st);
+    }
+}
+
+/**
+ * @brief 阶段 A：查询升级前 boot_id，若节点处于 APP_MODE 则发送 0x1D 进入 BOOT_MODE 并核实重枚举
+ * @param tr 传输层接口指针
+ * @param dst 目标节点 ID
+ * @param st 状态快照指针
+ * @return bool 成功进入 BOOT_MODE 返回 true
+ */
+static bool enter_boot_mode_and_verify(
+    const fw_ota_transport_t* tr,
+    uint8_t dst,
+    fw_updater_status_t* st
+) {
+    minimc_payload_version_report_t ver = {0, 0, 0, 0, 0, 0, 0};
+    if (tr->query_version(tr->user_ctx, dst, &ver)) {
+        st->pre_upgrade_boot_id = ver.boot_id;
+        if ((ver.capability_flags & MINIMC_CAP_FLAG_BOOT_MODE) != 0U) {
+            return true;
+        }
+    }
+    uint8_t nack_err = 0U;
+    if (!tr->send_sys_ctrl(tr->user_ctx, dst, MINIMC_SYS_CTRL_ACTION_ENTER_BOOT, &nack_err)) {
+        std::snprintf(st->last_error, sizeof(st->last_error), "0x1D rejected err=0x%02X", (unsigned)nack_err);
+        return false;
+    }
+    for (uint8_t i = 0U; i < 5U; ++i) {
+        if (tr->query_version(tr->user_ctx, dst, &ver) &&
+            ((ver.capability_flags & MINIMC_CAP_FLAG_BOOT_MODE) != 0U)) {
+            return true;
+        }
+    }
+    std::snprintf(st->last_error, sizeof(st->last_error), "BOOT_MODE capability_flags verify failed");
+    return false;
+}
+
+/**
+ * @brief 阶段 1 & 2：发送 0x20 握手与 0x21 分块数据流，并通过 0x23 核实 Stage 1 (RAM) 与 Stage 2 (Flash)
+ * @param tr 传输层接口指针
+ * @param pkg 封存固件包描述符指针
+ * @param st 状态快照指针
+ * @return bool 全部分块传输并经 0x23 核实通过返回 true
+ */
+static bool stream_chunks_and_verify_stages_1_2(
+    const fw_ota_transport_t* tr,
+    const fw_sealed_package_t* pkg,
+    fw_updater_status_t* st
+) {
+    uint8_t nack = 0U;
+    if (!tr->ota_start(tr->user_ctx, pkg->target_node, &pkg->start_req, &nack)) {
+        std::snprintf(st->last_error, sizeof(st->last_error), "0x20 OTA_START failed err=0x%02X", (unsigned)nack);
+        return false;
+    }
+    uint32_t offset = 0U;
+    while (offset < pkg->payload_len) {
+        const uint32_t rem = pkg->payload_len - offset;
+        const uint16_t chunk_len = (rem > MINIMC_OTA_DEFAULT_CHUNK_SIZE)
+            ? (uint16_t)MINIMC_OTA_DEFAULT_CHUNK_SIZE : (uint16_t)rem;
+        if (!tr->ota_send_chunk(tr->user_ctx, pkg->target_node, offset, pkg->payload_buf + offset, chunk_len, &nack)) {
+            std::snprintf(st->last_error, sizeof(st->last_error), "0x21 chunk offset=%u failed", (unsigned)offset);
+            return false;
+        }
+        minimc_payload_ota_status_t ota_st = {0, 0, 0, 0};
+        if (tr->ota_query_status != nullptr && tr->ota_query_status(tr->user_ctx, pkg->target_node, &ota_st)) {
+            st->bytes_written = ota_st.bytes_written;
+            st->cached_chunk0_bytes = ota_st.cached_chunk0_bytes;
+        }
+        if (offset == 0U) {
+            st->progress_pct = 15U;
+            update_confirm_stage(tr, st, FW_CONFIRM_STAGE_1_CHUNK0_CACHED_RAM, "CHUNK0_CACHED_RAM");
+        } else {
+            st->progress_pct = (uint8_t)(20U + ((offset + chunk_len) * 70U) / pkg->payload_len);
+            update_confirm_stage(tr, st, FW_CONFIRM_STAGE_2_FLASH_WRITTEN, "FLASH_WRITTEN");
+        }
+        offset += chunk_len;
+    }
+    return true;
+}
+
+/**
+ * @brief 阶段 4：轮询 0x01->0x02 与 0x14->0x15，严格核实 APP_MODE、新 boot_id、目标版本与鲜活温度
+ * @param cfg 升级配置结构体指针
+ * @param pkg 固件包描述符指针
+ * @param st 状态快照指针
+ * @return bool Stage 4 核实全部通过返回 true
+ */
+static bool verify_stage4_new_app_online(
+    const fw_upgrade_exec_cfg_t* cfg,
+    const fw_sealed_package_t* pkg,
+    fw_updater_status_t* st
+) {
+    const fw_ota_transport_t* tr = cfg->transport;
+    const uint8_t max_polls = (cfg->stage4_max_polls > 0U) ? cfg->stage4_max_polls : 5U;
+    for (uint8_t i = 0U; i < max_polls; ++i) {
+        minimc_payload_version_report_t ver = {0, 0, 0, 0, 0, 0, 0};
+        int16_t temp_deci = 0;
+        if (!tr->query_version(tr->user_ctx, pkg->target_node, &ver)) continue;
+        const bool is_app_mode = ((ver.capability_flags & MINIMC_CAP_FLAG_BOOT_MODE) == 0U);
+        const bool new_boot_id = (ver.boot_id != 0U) && (ver.boot_id != st->pre_upgrade_boot_id);
+        const uint32_t rep_ver = ((uint32_t)ver.major << 8U) | (uint32_t)ver.minor;
+        const bool ver_match = (rep_ver == pkg->trailer.version_code);
+        const bool temp_ok = (tr->query_temp_deci_c != nullptr) &&
+                             tr->query_temp_deci_c(tr->user_ctx, pkg->target_node, &temp_deci) &&
+                             (temp_deci >= 50 && temp_deci <= 3000);
+        if (is_app_mode && new_boot_id && ver_match && temp_ok) {
+            st->post_upgrade_boot_id = ver.boot_id;
+            st->progress_pct = 100U;
+            st->lifecycle_stage = FW_STAGE_SUCCEEDED;
+            update_confirm_stage(tr, st, FW_CONFIRM_STAGE_4_NEW_APP_ONLINE_VERIFIED, "SUCCEEDED");
+            return true;
+        }
+    }
+    return false;
+}
+
+/**
+ * @brief 执行单节点四阶段固件升级闭环（含安全门禁、进入维护态、Stage 1~4 硬隔离与恢复态判定）
+ * @param cfg 升级执行配置结构体只读指针（非空）
+ * @param pkg 已预检通过的固件包描述符只读指针（非空）
+ * @param out_status 升级状态快照输出指针（非空）
+ * @return aisoc_dev_status_t Stage 4 核验通过返回 AISOC_DEV_OK
+ */
+aisoc_dev_status_t fw_updater_execute_node(
+    const fw_upgrade_exec_cfg_t* cfg,
+    const fw_sealed_package_t* pkg,
+    fw_updater_status_t* out_status
+) {
+    if (cfg == nullptr || cfg->dev_state == nullptr || cfg->safety == nullptr ||
+        cfg->transport == nullptr || pkg == nullptr || out_status == nullptr) {
+        return AISOC_DEV_ERR_NULL_PTR;
+    }
+    if (!cfg->recovery_mode) {
+        dev_admission_res_t adm_res = {};
+        const aisoc_dev_status_t adm = dev_state_check_ota_admission(cfg->dev_state, cfg->safety, &adm_res);
+        if (adm != AISOC_DEV_OK) {
+            out_status->lifecycle_stage = FW_STAGE_FAILED;
+            std::snprintf(out_status->status_text, sizeof(out_status->status_text), "REJECTED_NOT_SAFE");
+            return adm;
+        }
+    }
+    (void)dev_state_enter_maintenance(cfg->dev_state);
+    out_status->active_node = pkg->target_node;
+    out_status->lifecycle_stage = FW_STAGE_UPGRADING;
+    out_status->confirm_stage = FW_CONFIRM_STAGE_0_NONE;
+    out_status->progress_pct = 5U;
+
+    const fw_ota_transport_t* tr = cfg->transport;
+    uint8_t nack = 0U;
+    if (!enter_boot_mode_and_verify(tr, pkg->target_node, out_status) ||
+        !stream_chunks_and_verify_stages_1_2(tr, pkg, out_status) ||
+        !tr->ota_finish(tr->user_ctx, pkg->target_node, pkg->payload_len, pkg->fw_crc32, &nack)) {
+        out_status->lifecycle_stage = FW_STAGE_OTA_RECOVERY_PENDING;
+        std::snprintf(out_status->status_text, sizeof(out_status->status_text), "OTA_RECOVERY_PENDING");
+        (void)dev_state_exit_maintenance(cfg->dev_state, true);
+        return AISOC_DEV_ERR_TIMEOUT;
+    }
+    /* Stage 3：0x22 ACK 仅代表镜像校验与回填提交完成，进度严禁超过 95%，严禁宣称 SUCCEEDED */
+    out_status->progress_pct = 95U;
+    update_confirm_stage(tr, out_status, FW_CONFIRM_STAGE_3_IMAGE_VERIFIED_COMMITTED, "IMAGE_VERIFIED_COMMITTED");
+
+    if (!verify_stage4_new_app_online(cfg, pkg, out_status)) {
+        out_status->lifecycle_stage = FW_STAGE_OTA_RECOVERY_PENDING;
+        std::snprintf(out_status->status_text, sizeof(out_status->status_text), "OTA_RECOVERY_PENDING");
+        (void)dev_state_exit_maintenance(cfg->dev_state, true);
+        return AISOC_DEV_ERR_TIMEOUT;
+    }
+    (void)dev_state_exit_maintenance(cfg->dev_state, false);
+    return AISOC_DEV_OK;
+}
+
+/**
+ * @brief 按架构规定顺序执行双节点串行升级（常规态：先 TH 0x03 后 MC 0x02；恢复态：先 MC 0x02 后 TH 0x03）
+ * @param cfg 升级执行配置结构体只读指针（非空）
+ * @param th_pkg TH 固件包描述符可空指针
+ * @param mc_pkg MC 固件包描述符可空指针
+ * @param out_status 升级状态快照输出指针（非空）
+ * @return aisoc_dev_status_t 全部成功返回 AISOC_DEV_OK
+ */
+aisoc_dev_status_t fw_updater_execute_batch(
+    const fw_upgrade_exec_cfg_t* cfg,
+    const fw_sealed_package_t* th_pkg,
+    const fw_sealed_package_t* mc_pkg,
+    fw_updater_status_t* out_status
+) {
+    if (cfg == nullptr || out_status == nullptr || (th_pkg == nullptr && mc_pkg == nullptr)) {
+        return AISOC_DEV_ERR_NULL_PTR;
+    }
+    const fw_sealed_package_t* first_pkg = cfg->recovery_mode ? mc_pkg : th_pkg;
+    const fw_sealed_package_t* second_pkg = cfg->recovery_mode ? th_pkg : mc_pkg;
+
+    if (first_pkg != nullptr) {
+        const aisoc_dev_status_t st1 = fw_updater_execute_node(cfg, first_pkg, out_status);
+        if (st1 != AISOC_DEV_OK) {
+            return st1;
+        }
+    }
+    if (second_pkg != nullptr) {
+        const aisoc_dev_status_t st2 = fw_updater_execute_node(cfg, second_pkg, out_status);
+        if (st2 != AISOC_DEV_OK) {
+            return st2;
+        }
+    }
+    return AISOC_DEV_OK;
+}
diff --git a/services/device_manager/firmware_updater.h b/services/device_manager/firmware_updater.h
new file mode 100644
index 0000000..be45877
--- /dev/null
+++ b/services/device_manager/firmware_updater.h
@@ -0,0 +1,183 @@
+/**
+ * @file firmware_updater.h
+ * @brief SoC AP 统一固件升级编排器（TWIN-65：目录扫描、封存、128B ATSG 离线预检与四阶段确认闭环）
+ * @details 遵循 project-control/.agents/rules/c_cpp_coding_standard.md 与 code_documentation_standard.md。
+ */
+
+#ifndef AISOC_DEVICE_MANAGER_FIRMWARE_UPDATER_H
+#define AISOC_DEVICE_MANAGER_FIRMWARE_UPDATER_H
+
+#include "device_manager_state.h"
+#include "telemetry_types.h"
+#include <stddef.h>
+#include <stdint.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** @brief 固件升级任务生命周期主状态枚举 */
+typedef enum {
+    FW_STAGE_IDLE = 0,                           /**< 空闲态（无待升级包） */
+    FW_STAGE_PACKAGE_STAGED_PENDING_CONFIRM = 1, /**< 发现完整 .bin 包，等待人工确认触发 */
+    FW_STAGE_SEALED_PRECHECK_OK = 2,             /**< 已只读封存并通过 128B ATSG Trailer 离线预检 */
+    FW_STAGE_UPGRADING = 3,                      /**< 正在执行串口停等升级 */
+    FW_STAGE_SUCCEEDED = 4,                      /**< Stage 4 新 App 在线核验通过（100%） */
+    FW_STAGE_OTA_RECOVERY_PENDING = 5,           /**< Stage 4 超时或中断，等待恢复重刷 */
+    FW_STAGE_FAILED = 6                          /**< 预检或升级过程拒绝/失败 */
+} fw_lifecycle_stage_t;
+
+/** @brief 四阶段落盘与生效确认等级枚举（严禁 Stage 3 伪报 100% SUCCEEDED） */
+typedef enum {
+    FW_CONFIRM_STAGE_0_NONE = 0,                    /**< 尚未完成首包缓存 */
+    FW_CONFIRM_STAGE_1_CHUNK0_CACHED_RAM = 1,       /**< Stage 1：0x20 ACK + chunk_0 暂存 Boot RAM */
+    FW_CONFIRM_STAGE_2_FLASH_WRITTEN = 2,           /**< Stage 2：后续分块写入 Flash 并经 0x23 核实 */
+    FW_CONFIRM_STAGE_3_IMAGE_VERIFIED_COMMITTED = 3,/**< Stage 3：0x22 ACK 整包 CRC+chunk_0 回填成功（上限 95%） */
+    FW_CONFIRM_STAGE_4_NEW_APP_ONLINE_VERIFIED = 4  /**< Stage 4：0x01/0x02 APP_MODE + 新 boot_id + 鲜活温度（100%） */
+} fw_confirm_stage_t;
+
+/** @brief 单个已封存并预检通过的固件镜像描述符 */
+typedef struct {
+    uint8_t target_node;                 /**< 目标节点 ID（0x02=MC, 0x03=TH） */
+    char sealed_path[256];               /**< 封存只读文件路径 */
+    uint32_t payload_len;                /**< 裸 App 镜像字节长度 */
+    uint32_t fw_crc32;                   /**< 裸 App 镜像 IEEE 802.3 CRC32 */
+    minimc_fw_trailer_t trailer;         /**< 128B ATSG 固件尾块 */
+    minimc_payload_ota_start_t start_req;/**< 144B 0x20 握手请求结构体 */
+    const uint8_t* payload_buf;          /**< 内存中缓存的裸镜像数据只读指针 */
+} fw_sealed_package_t;
+
+/** @brief 固件升级实时进度与状态快照结构体 */
+typedef struct {
+    fw_lifecycle_stage_t lifecycle_stage;/**< 升级主状态 */
+    fw_confirm_stage_t confirm_stage;    /**< 四阶段确认等级（0~4） */
+    uint8_t active_node;                 /**< 当前操作节点（0x02 或 0x03） */
+    uint8_t progress_pct;                /**< 升级进度百分比（Stage 3 封顶 95%，Stage 4 达 100%） */
+    uint32_t bytes_written;              /**< 经 0x23 核实的已写入字节数 */
+    uint16_t cached_chunk0_bytes;        /**< 经 0x23 核实的 chunk_0 RAM 暂存字节数 */
+    uint32_t pre_upgrade_boot_id;        /**< 升级前记录的节点 boot_id */
+    uint32_t post_upgrade_boot_id;       /**< Stage 4 核实的新 App boot_id */
+    char staged_mc_file[128];            /**< 暂存区发现的 MC 固件文件名 */
+    char staged_th_file[128];            /**< 暂存区发现的 TH 固件文件名 */
+    char status_text[64];                /**< 状态文本（如 IMAGE_VERIFIED_COMMITTED / SUCCEEDED） */
+    char last_error[128];                /**< 最近一次错误描述 */
+} fw_updater_status_t;
+
+/** @brief 升级传输层抽象回调接口（支持真实 ForwardService 与确定性单测注入） */
+typedef struct {
+    void* user_ctx; /**< 传输层上下文指针 */
+    bool (*query_version)(void* ctx, uint8_t dst, minimc_payload_version_report_t* out_ver); /**< 0x01->0x02 版本查询 */
+    bool (*query_temp_deci_c)(void* ctx, uint8_t dst, int16_t* out_temp_deci_c);             /**< 0x14->0x15 温度查询 */
+    bool (*send_sys_ctrl)(void* ctx, uint8_t dst, uint8_t action, uint8_t* out_nack_err);    /**< 0x1D 受控进 Boot */
+    bool (*ota_start)(void* ctx, uint8_t dst, const minimc_payload_ota_start_t* req, uint8_t* out_nack_err); /**< 0x20 握手 */
+    bool (*ota_send_chunk)(void* ctx, uint8_t dst, uint32_t offset, const uint8_t* data, uint16_t len, uint8_t* out_nack_err); /**< 0x21 分块 */
+    bool (*ota_query_status)(void* ctx, uint8_t dst, minimc_payload_ota_status_t* out_st);   /**< 0x23 进度查询 */
+    bool (*ota_finish)(void* ctx, uint8_t dst, uint32_t size, uint32_t crc32, uint8_t* out_nack_err); /**< 0x22 终验提交 */
+    void (*on_stage_transition)(void* ctx, const fw_updater_status_t* snap);                 /**< 阶段变更观测钩子（可选） */
+} fw_ota_transport_t;
+
+/** @brief 单节点或双节点升级执行请求参数结构体 */
+typedef struct {
+    device_manager_state_t* dev_state;   /**< 设备状态机指针（非空） */
+    const dev_ota_safety_ctx_t* safety;  /**< 升级前安全互锁状态指针（非空） */
+    const fw_ota_transport_t* transport; /**< 传输层接口指针（非空） */
