+/**
+ * @file test_firmware_updater.cpp
+ * @brief TWIN-65 SoC AP 统一固件升级编排器、128B ATSG 预检、维护态抑制与四阶段确认闭环单测套件
+ * @details 遵循 project-control/.agents/rules/c_cpp_coding_standard.md 与 code_documentation_standard.md。
+ */
+
+#include "firmware_updater.h"
+#include "device_manager_state.h"
+#include <cassert>
+#include <cstdio>
+#include <cstring>
+#include <sys/stat.h>
+#include <unistd.h>
+
+/** @brief 合成测试用合法固件镜像（含裸 payload 与 128B ATSG Trailer）的参数结构体 */
+typedef struct {
+    uint32_t board_id;      /**< 目标板卡 ID */
+    uint32_t fw_version;    /**< 固件版本号 */
+    uint32_t git_commit;    /**< Git 短哈希 */
+    uint32_t payload_len;   /**< 裸镜像字节数 */
+} synth_pkg_cfg_t;
+
+/**
+ * @brief 在给定缓冲区中合成带合法 128B ATSG Trailer（含 SHA-256 与 CRC32）的固件文件字节流
+ * @param cfg 合成配置结构体只读指针
+ * @param out_buf 输出字节缓冲区指针
+ * @param out_total_len 输出总字节长度指针
+ */
+static void build_valid_atsg_package(
+    const synth_pkg_cfg_t* cfg,
+    uint8_t* out_buf,
+    size_t* out_total_len
+) {
+    for (uint32_t i = 0U; i < cfg->payload_len; ++i) {
+        out_buf[i] = (uint8_t)((i * 31U + 7U) & 0xFFU);
+    }
+    minimc_fw_trailer_t tr;
+    std::memset(&tr, 0, sizeof(tr));
+    tr.magic = MINIMC_FW_TRAILER_MAGIC;
+    tr.struct_version = MINIMC_FW_STRUCT_VER;
+    tr.board_id = cfg->board_id;
+    tr.version_code = cfg->fw_version;
+    tr.payload_len = cfg->payload_len;
+    (void)fw_updater_sha256(out_buf, cfg->payload_len, tr.payload_sha256);
+    tr.trailer_crc32 = fw_updater_crc32((const uint8_t*)&tr, sizeof(tr) - 4U);
+    std::memcpy(out_buf + cfg->payload_len, &tr, sizeof(tr));
+    *out_total_len = (size_t)cfg->payload_len + sizeof(tr);
+}
