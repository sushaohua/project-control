  4864	void adjust_delta(float cartesian[3])
  4865	{
  4866	  int half = (AUTO_BED_LEVELING_GRID_POINTS - 1) / 2;
  4867	  float grid_x = max(0.001-half, min(half-0.001, cartesian[X_AXIS] / AUTO_BED_LEVELING_GRID_POINTS));
  4868	  float grid_y = max(0.001-half, min(half-0.001, cartesian[Y_AXIS] / AUTO_BED_LEVELING_GRID_POINTS));
  4869	  int floor_x = floor(grid_x);
  4870	  int floor_y = floor(grid_y);
  4871	  float ratio_x = grid_x - floor_x;
  4872	  float ratio_y = grid_y - floor_y;
  4873	  float z1 = bed_level[floor_x+half][floor_y+half];
  4874	  float z2 = bed_level[floor_x+half][floor_y+half+1];
  4875	  float z3 = bed_level[floor_x+half+1][floor_y+half];
  4876	  float z4 = bed_level[floor_x+half+1][floor_y+half+1];
  4877	  float left = (1-ratio_y)*z1 + ratio_y*z2;
  4878	  float right = (1-ratio_y)*z3 + ratio_y*z4;
  4879	  float offset = (1-ratio_x)*left + ratio_x*right;
  4880	
  4881	  delta[X_AXIS] += offset;
  4882	  delta[Y_AXIS] += offset;
  4883	  delta[Z_AXIS] += offset;
