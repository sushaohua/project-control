+    TEST_CHECK(!state->is_fault && state->snapshot.bed_temp_millic == 130000, "Bed 130.0C valid");
+    dev_state_update_raw_sample(state, &s2);
+    TEST_CHECK(!state->is_fault && state->snapshot.tool_temp_millic == 5000, "Nozzle 5.0C valid");
+    s2.temperature_millic = 300000;
+    dev_state_update_raw_sample(state, &s2);
+    TEST_CHECK(!state->is_fault && state->snapshot.tool_temp_millic == 300000, "Nozzle 300.0C valid");
+    s1.temperature_millic = 300000;
+    s1.host_received_ns = t_base + 1000000ULL;
+    dev_state_update_raw_sample(state, &s1);
+    TEST_CHECK(state->snapshot.bed_temp_millic == AISOC_TEMP_MILLIC_FAULT, "Bed 300C forced to FAULT sentinel");
+    TEST_CHECK(state->snapshot.bed_sensor_status == (uint32_t)AISOC_SENSOR_OPEN, "Bed 300C status forced to OPEN");
+    TEST_CHECK(state->is_fault == true, "Device state is_fault set on bed over-range");
+    return true;
