+            state->snapshot.tool_temp_millic = AISOC_TEMP_MILLIC_OFFLINE;
+            state->snapshot.tool_sensor_status = (uint32_t)AISOC_SENSOR_TIMEOUT;
+            state->snapshot.tool_quality = (uint32_t)AISOC_QUALITY_FAULT;
+            if (vb != nullptr) {
+                vb->th_ver.status = DEV_VER_STATUS_OFFLINE;
+            }
+        }
+    } else if (vb != nullptr) {
+        if (node == 1U && vb->mc_ver.is_valid) {
+            vb->mc_ver.status = DEV_VER_STATUS_ONLINE;
+            vb->mc_ver.last_update_ns = now_ns;
+        } else if (node == 2U && vb->th_ver.is_valid) {
+            vb->th_ver.status = DEV_VER_STATUS_ONLINE;
+            vb->th_ver.last_update_ns = now_ns;
+        }
+    }
+    update_system_status_desc(state);
+    return AISOC_DEV_OK;
