+/**
+ * @brief 处理 POST /api/v1/jobs/upload 路由：校验扩展名、大小及 G/M/T 指令合法性（ISS-008 & ISS-009）
+ * @param client 客户端连接槽指针
+ * @param body 请求 JSON 字符串
+ */
+static void handle_job_upload_route(client_conn_t* client, const char* body) {
+    if (client == nullptr) return;
+    if (body == nullptr || body[0] == '\0') {
+        send_400_bad_request(client, "Empty upload body");
+        return;
+    }
+    char filename[128] = {0};
+    if (!extract_upload_filename(body, filename, sizeof(filename)) || !has_valid_gcode_extension(filename)) {
+        send_400_bad_request(client, "Invalid G-code file extension: only .gcode/.gco/.nc allowed");
+        return;
+    }
+    const bool is_preset = (std::strstr(body, "\"preset\":true") != nullptr) ||
+                           (std::strstr(body, "\"preset\": true") != nullptr);
+    if (!is_preset) {
+        const char* ps = std::strstr(body, "\"size\":");
+        if (ps != nullptr && std::strtol(ps + 7, nullptr, 10) <= 0L) {
+            send_400_bad_request(client, "Invalid G-code file size: empty file rejected");
+            return;
+        }
+        const char* pc = std::strstr(body, "\"content\":\"");
+        const char* check_src = (pc != nullptr) ? (pc + 11) : body;
+        if (!contains_valid_gcode_command(check_src)) {
+            send_400_bad_request(client, "Invalid G-code content: no valid G/M/T commands found");
+            return;
+        }
+    }
+    char json_ok[256] = {0};
+    std::snprintf(json_ok, sizeof(json_ok),
+                  "{\"status\":\"ok\",\"code\":0,\"model\":\"%s\",\"message\":\"Upload staged\"}", filename);
+    send_json_and_close(client, 200, json_ok);
+}
