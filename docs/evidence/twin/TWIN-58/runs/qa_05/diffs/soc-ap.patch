+/**
+ * @brief 检查文件名是否具有合法的 G-code 扩展名（.gcode / .gco / .nc）
+ * @param filename 文件名字符串
+ * @return bool 扩展名合法返回 true，否则返回 false
+ */
+static bool has_valid_gcode_extension(const char* filename) {
+    if (filename == nullptr || filename[0] == '\0') return false;
+    const size_t len = std::strlen(filename);
+    if (len >= 6U && strcasecmp(filename + len - 6U, ".gcode") == 0) return true;
+    if (len >= 4U && strcasecmp(filename + len - 4U, ".gco") == 0) return true;
+    if (len >= 3U && strcasecmp(filename + len - 3U, ".nc") == 0) return true;
+    return false;
+}
+
+/**
+ * @brief 检查文本内容是否包含至少一条合法 G/M/T 指令行
+ * @param text 待检测的 G-code 文本内容
+ * @return bool 包含合法 G/M/T 指令返回 true，否则返回 false
+ */
+static bool contains_valid_gcode_command(const char* text) {
+    if (text == nullptr || text[0] == '\0') return false;
+    const char* tokens[] = {
+        "G0 ", "G0\n", "G0\r", "G1 ", "G1\n", "G1\r", "G28", "G29", "G90", "G91", "G92",
+        "M82", "M83", "M84", "M104", "M106", "M107", "M109", "M140", "M190", "M163", "M164",
+        "T0", "T1", "T2", "T3"
+    };
+    const size_t num_tokens = sizeof(tokens) / sizeof(tokens[0]);
+    for (size_t i = 0U; i < num_tokens; ++i) {
+        if (std::strstr(text, tokens[i]) != nullptr) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/**
+ * @brief 从上传请求 JSON 中提取文件名（支持 "name"、"filename" 或 "model" 字段）
+ * @param body 请求 JSON 字符串
+ * @param out_name 输出文件名缓冲区
+ * @param cap 输出缓冲区容量
+ * @return bool 成功提取非空文件名返回 true
+ */
+static bool extract_upload_filename(const char* body, char* out_name, size_t cap) {
+    if (body == nullptr || out_name == nullptr || cap == 0U) return false;
+    const char* keys[] = { "\"name\":\"", "\"filename\":\"", "\"model\":\"" };
+    for (size_t i = 0U; i < 3U; ++i) {
+        const char* p = std::strstr(body, keys[i]);
+        if (p != nullptr) {
+            const char* start = p + std::strlen(keys[i]);
+            const char* end = std::strchr(start, '\"');
+            if (end != nullptr && end > start && (size_t)(end - start) < cap) {
+                std::memcpy(out_name, start, (size_t)(end - start));
+                out_name[end - start] = '\0';
+                return true;
+            }
+        }
+    }
+    return false;
+}
