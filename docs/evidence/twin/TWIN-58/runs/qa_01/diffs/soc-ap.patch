+ * @brief 发送自定义 JSON 请求体的 HTTP 请求并读取响应
+ * @param port 监听端口
+ * @param method HTTP 方法
+ * @param path 路由路径
+ * @param body 请求体字符串
+ * @param out_rx 响应输出缓冲区 (1024 字节)
+ * @return true 收到响应，false 失败
+ */
+static bool send_http_body(uint16_t port, const char* path, const char* body, char* out_rx) {
+    const int fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (fd < 0) return false;
+    struct sockaddr_in addr;
+    std::memset(&addr, 0, sizeof(addr));
+    addr.sin_family = AF_INET;
+    addr.sin_port = htons(port);
+    inet_pton(AF_INET, "127.0.0.1", &addr.sin_addr);
+    if (connect(fd, (struct sockaddr*)&addr, sizeof(addr)) < 0) {
+        close(fd);
+        return false;
+    }
+    char req[768] = {0};
+    std::snprintf(req, sizeof(req),
+                  "POST %s HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Length: %zu\r\n\r\n%s",
+                  path, std::strlen(body), body);
+    (void)send(fd, req, std::strlen(req), 0);
+    std::memset(out_rx, 0, 1024U);
+    const ssize_t n = recv(fd, out_rx, 1023U, 0);
+    close(fd);
+    return n > 0;
+}
