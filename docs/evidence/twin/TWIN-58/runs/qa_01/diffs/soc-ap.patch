+/**
+ * @brief 从上传请求 JSON 中提取文件名（支持 "name"、"filename" 或 "model" 字段）
+ * @param body 请求 JSON 字符串
+ * @param out_name 输出文件名缓冲区
+ * @param cap 输出缓冲区容量
+ * @return bool 成功提取非空文件名返回 true
+ */
+static bool extract_upload_filename(const char* body, char* out_name, size_t cap) {
+    if (body == nullptr || out_name == nullptr || cap == 0U) return false;
+    const char* keys[] = { "\"name\":\"", "\"filename\":\"", "\"model\":\"" };
+    for (size_t i = 0U; i < 3U; ++i) {
+        const char* p = std::strstr(body, keys[i]);
+        if (p != nullptr) {
+            const char* start = p + std::strlen(keys[i]);
+            const char* end = std::strchr(start, '\"');
+            if (end != nullptr && end > start && (size_t)(end - start) < cap) {
+                std::memcpy(out_name, start, (size_t)(end - start));
+                out_name[end - start] = '\0';
+                return true;
+            }
+        }
+    }
+    return false;
+}
