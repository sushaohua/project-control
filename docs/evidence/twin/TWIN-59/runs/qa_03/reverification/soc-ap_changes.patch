+        # ISS-009: Extract and execute isValidGcodeFile on 4 independent cases
+        fn_match = re.search(r"(function\s+isValidGcodeFile\s*\([^)]*\)\s*\{[\s\S]*?\n    \})", self.js_content)
+        self.assertIsNotNone(fn_match, "isValidGcodeFile definition must exist in app.js")
+        fn_code = fn_match.group(1)
+        self.assertIn(r"/\.(gcode|gco|nc)$/i", fn_code)
+        self.assertIn(r"/^\s*[GMT]\d+/im", fn_code)
+
+        if shutil.which("node"):
+            script = (
+                fn_code + "\n"
+                "console.log(JSON.stringify([\n"
+                "  isValidGcodeFile('bad.txt', 4, 'G28\\n'),\n"
+                "  isValidGcodeFile('empty.gcode', 0, ''),\n"
+                "  isValidGcodeFile('bad_body.gcode', 37, 'hello invalid content\\n; comment only\\n'),\n"
+                "  isValidGcodeFile('ok.gcode', 15, 'G28\\nM104 S200\\n')\n"
+                "]));\n"
+            )
+            out = subprocess.check_output(["node", "-e", script], text=True).strip()
+            self.assertEqual(json.loads(out), [False, False, False, True])
+
         # ISS-011 & ISS-013: bed range 5~130C & OOBE offline guard (!appState.isConnected || !appState.hwOnline)
         self.assertIn("mcNum < 5.0 || mcNum > 130.0", self.js_content, "Must enforce bed 5~130C range in UI")
         self.assertIn("!appState.isConnected || !appState.hwOnline", self.js_content, "Must guard OOBE & runout against !appState.hwOnline")
