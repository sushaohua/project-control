+/**
+ * @brief 验证 >=3.0s 断链打入离线哨兵 2147483646 后注入新鲜遥测的在线与温度恢复（ISS-20261105-014）
+ */
+static void test_disconnect_and_reconnect_recovery_iss014(void) {
+    std::printf("[TEST 4] Verify >=3.0s offline sentinel & fresh telemetry reconnect recovery (ISS-014)...\n");
+    device_manager_state_t st = {};
+    dev_state_init_snapshot(&st);
+    const uint64_t t0 = 1000000000ULL;
+    aisoc_dev_mcu_version_t ver = {};
+    ver.proto_major = 2U;
+    ver.status = DEV_VER_STATUS_ONLINE;
+    dev_state_update_mcu_version(&st, "MC", &ver, t0);
+    dev_state_update_mcu_version(&st, "TH", &ver, t0);
+    aisoc_raw_temp_t b_s = { 1U, 60000, AISOC_SENSOR_OK, 2048U, 100U, t0, 1U };
+    aisoc_raw_temp_t t_s = { 2U, 210000, AISOC_SENSOR_OK, 1920U, 100U, t0, 1U };
+    dev_state_update_raw_sample(&st, &b_s);
+    dev_state_update_raw_sample(&st, &t_s);
+
+    const uint64_t t_off = t0 + 3100000000ULL;
+    dev_state_eval_version_freshness(&st, t_off);
+    dev_state_eval_freshness(&st, t_off);
+    check_cond(st.snapshot.bed_temp_millic == AISOC_TEMP_MILLIC_OFFLINE &&
+               st.snapshot.tool_temp_millic == AISOC_TEMP_MILLIC_OFFLINE &&
+               std::strcmp(st.snapshot.system_status_desc, "OFFLINE") == 0,
+               "Both nodes transition to OFFLINE sentinel 2147483646 after 3.1s");
+
+    const uint64_t t_rec = t_off + 200000000ULL;
+    b_s.temperature_millic = 62500;
+    b_s.host_received_ns = t_rec;
+    t_s.temperature_millic = 215000;
+    t_s.host_received_ns = t_rec;
+    dev_state_update_raw_sample(&st, &b_s);
+    dev_state_update_raw_sample(&st, &t_s);
+    dev_state_eval_freshness(&st, t_rec);
+    aisoc_dev_mcu_version_t mc_out = {}, th_out = {};
+    dev_state_get_mcu_version(&st, "MC", &mc_out);
+    dev_state_get_mcu_version(&st, "TH", &th_out);
+    check_cond(mc_out.status == DEV_VER_STATUS_ONLINE && th_out.status == DEV_VER_STATUS_ONLINE &&
+               st.snapshot.bed_temp_millic == 62500 && st.snapshot.tool_temp_millic == 215000 &&
+               std::strcmp(st.snapshot.system_status_desc, "NORMAL") == 0,
+               "Fresh telemetry recovers mc/th ONLINE status, NORMAL system_status and real temperatures");
+}
