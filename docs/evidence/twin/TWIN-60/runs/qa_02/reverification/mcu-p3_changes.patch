+/**
+ * @brief 验证 0x19 耗材控制动作边界：action=0/1/2 返回 ACK，slot_id=4 或 action=3 返回 NACK 0x03 (ISS-20261105-010)
+ */
+static void verify_filament_action_and_slot_bounds(void)
+{
+    for (uint8_t act = 0U; act <= 2U; ++act)
+    {
+        const minimc_filament_req_t ok_req = { 0U, act, 10U };
+        send_test_frame(MINIMC_NODE_MC, MINIMC_CMD_SLOT_SELECT, (const uint8_t *)&ok_req, sizeof(ok_req));
+        assert(s_last_ap_tx_frame[5] == MINIMC_CMD_SLOT_SELECT);
+    }
+    const minimc_filament_req_t bad_slot_req = { 4U, 0U, 0U };
+    send_test_frame(MINIMC_NODE_MC, MINIMC_CMD_SLOT_SELECT, (const uint8_t *)&bad_slot_req, sizeof(bad_slot_req));
+    assert(s_last_ap_tx_frame[5] == MINIMC_CMD_NACK);
+    assert(s_last_ap_tx_frame[12] == 0x03U);
+
+    const minimc_filament_req_t bad_action_req = { 0U, 3U, 0U };
+    send_test_frame(MINIMC_NODE_MC, MINIMC_CMD_SLOT_SELECT, (const uint8_t *)&bad_action_req, sizeof(bad_action_req));
+    assert(s_last_ap_tx_frame[5] == MINIMC_CMD_NACK);
+    assert(s_last_ap_tx_frame[12] == 0x03U);
+}
