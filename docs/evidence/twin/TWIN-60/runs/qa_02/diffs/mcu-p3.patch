+    minimc_proto_init();
+    send_test_frame(MINIMC_NODE_MC, MINIMC_CMD_GET_VERSION, NULL, 0U);
+    const uint32_t boot_id_2 = (uint32_t)s_last_ap_tx_frame[16] |
+                               ((uint32_t)s_last_ap_tx_frame[17] << 8U) |
+                               ((uint32_t)s_last_ap_tx_frame[18] << 16U) |
