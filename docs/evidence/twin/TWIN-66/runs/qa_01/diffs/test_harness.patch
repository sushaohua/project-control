+def _build_negative_framing_vectors(valid_ping: bytes) -> List[Dict[str, Any]]:
+    """构建 G09~G15 帧头、协议版本、保留标志、路由位、超长 MTU 与坏 CRC 负向向量。"""
+    g09 = valid_ping[:10]
+    g10 = b"\x55\xAB" + valid_ping[2:]
+    h11 = struct.pack("<BBBBBBBBHH", 0x55, 0xAA, 1, 2, 0x09, CMD_PING, 4, 0, 1, 0)
+    g11 = h11 + struct.pack("<H", calc_crc16_ccitt_false(h11))
+    h12 = struct.pack("<BBBBBBBBHH", 0x55, 0xAA, 1, 2, 0x25, CMD_PING, 4, 0, 1, 0)
+    g12 = h12 + struct.pack("<H", calc_crc16_ccitt_false(h12))
+    h13 = struct.pack("<BBBBBBBBHH", 0x55, 0xAA, 1, 2, 0x05, CMD_PING, 4, 0x03, 1, 0)
+    g13 = h13 + struct.pack("<H", calc_crc16_ccitt_false(h13))
+    p14 = bytes(1025)
+    h14 = struct.pack("<BBBBBBBBHH", 0x55, 0xAA, 1, 2, 0x05, CMD_OTA_DATA, 4, 0, 1, 1025)
+    g14 = h14 + p14 + struct.pack("<H", calc_crc16_ccitt_false(h14 + p14))
+    g15 = valid_ping[:-1] + bytes([valid_ping[-1] ^ 0xFF])
+    neg_specs = [
+        ("G09", "ERR_FRAME_TOO_SHORT_10B", g09, "ERR_FRAME_TOO_SHORT"),
+        ("G10", "ERR_BAD_SOF_55AB", g10, "ERR_BAD_SOF"),
+        ("G11", "ERR_BAD_PROTO_VERSION", g11, "ERR_BAD_VERSION"),
+        ("G12", "ERR_BAD_FLAGS_RESERVED", g12, "ERR_BAD_FLAGS_RESERVED"),
+        ("G13", "ERR_BAD_ROUTE_CTRL_CONFLICT", g13, "ERR_BAD_ROUTE_CTRL"),
+        ("G14", "ERR_MTU_EXCEEDED_1025B", g14, "ERR_MTU_EXCEEDED"),
+        ("G15", "ERR_CRC_MISMATCH_FLIPPED", g15, "ERR_CRC_MISMATCH"),
+    ]
+    return [
+        {
+            "id": vid,
+            "name": name,
+            "cmd_id": CMD_PING if vid != "G14" else CMD_OTA_DATA,
+            "payload_len": max(0, len(raw) - 14),
+            "frame_len": len(raw),
+            "frame_hex": raw.hex().upper(),
+            "expected_valid": False,
+            "expected_status": status,
+        }
+        for vid, name, raw, status in neg_specs
+    ]
