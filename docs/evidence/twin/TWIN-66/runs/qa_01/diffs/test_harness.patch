+        and not rig_m5.state[NODE_TH]["anchor_valid"]
+    )
+    rig_m5.exchange_frame(encode_minimc_frame(NODE_TH, CMD_OTA_STATUS, 5, struct.pack("<B3s", 1, b"\x00\x00\x00")))
+    m7_ok = rig_m5.state[NODE_TH]["ota_state"] == 0
+    return m5_ok, m6_ok, m7_ok
