+    """对 VirtualDualMcuOtaTarget 发送 N01~N04 四类非法 0x20 请求并验证零擦除拦截。"""
+    bad_magic_tr = b"ATSH" + info["trailer"][4:]
+    p_n01 = struct.pack("<BBBBIII", NODE_TH, 1, 0, 0, 1024, info["fw_crc32"], 0x0201) + bad_magic_tr
+    _, r_n01 = decode_minimc_frame(rig.exchange_frame(encode_minimc_frame(NODE_TH, CMD_OTA_START, 2, p_n01)))
+    p_n02 = struct.pack("<BBBBIII", NODE_TH, 1, 0, 0, 1024, mc_info["fw_crc32"], 0x0201) + mc_info["trailer"]
+    _, r_n02 = decode_minimc_frame(rig.exchange_frame(encode_minimc_frame(NODE_TH, CMD_OTA_START, 3, p_n02)))
+    bad_crc_tr = info["trailer"][:124] + struct.pack("<I", info["trailer_crc32"] ^ 0xFFFFFFFF)
+    p_n03 = struct.pack("<BBBBIII", NODE_TH, 1, 0, 0, 1024, info["fw_crc32"], 0x0201) + bad_crc_tr
+    _, r_n03 = decode_minimc_frame(rig.exchange_frame(encode_minimc_frame(NODE_TH, CMD_OTA_START, 4, p_n03)))
+    p_n04 = struct.pack("<BBBBIII", NODE_TH, 1, 0, 0, MAX_TH_APP_BYTES + 1, info["fw_crc32"], 0x0201) + info["trailer"]
+    _, r_n04 = decode_minimc_frame(rig.exchange_frame(encode_minimc_frame(NODE_TH, CMD_OTA_START, 5, p_n04)))
+    zero_er = rig.state[NODE_TH]["erase_count"] == 0
+    return (
+        r_n01.get("cmd_id") == CMD_NACK and zero_er,
+        r_n02.get("cmd_id") == CMD_NACK and zero_er,
+        r_n03.get("cmd_id") == CMD_NACK and zero_er,
+        r_n04.get("payload", b"\x00")[0] == 0x14 and zero_er,
+    )
