+def verify_ota_payload_semantics(vec_id: str, info: Dict[str, Any]) -> Tuple[bool, str]:
+    """针对 G16a~G16h 及 G17~G25 深度校验内部 144B OTA_START Trailer 与分片 CRC16。"""
+    cmd_id = info.get("cmd_id", -1)
+    pld: bytes = info.get("payload", b"")
+    if vec_id in ("G16", "G16a"):
+        if cmd_id != 0x20 or len(pld) != 144:
+            return False, f"{vec_id} expected 144B 0x20 payload, got len={len(pld)}"
+        trailer = pld[16:144]
+        magic, s_ver, _, _, t_plen = struct.unpack("<IIIII", trailer[:20])
+        t_crc = struct.unpack("<I", trailer[124:128])[0]
+        calc_tcrc = calc_crc32_ieee(trailer[:124])
+        if magic != TRAILER_MAGIC_ATSG or s_ver != TRAILER_STRUCT_VER or t_crc != calc_tcrc or t_plen <= 0:
+            return False, f"{vec_id} ATSG trailer validation failed"
+    elif vec_id in ("G16b", "G16c", "G16d", "G16e"):
+        if cmd_id != 0x21 or len(pld) < 9:
+            return False, f"{vec_id} invalid 0x21 payload"
+        _, chunk_len, chunk_crc16 = struct.unpack("<IHH", pld[:8])
+        chunk_data = pld[8:]
+        if len(chunk_data) != chunk_len or calc_crc16_ccitt_false(chunk_data) != chunk_crc16:
+            return False, f"{vec_id} 0x21 chunk_crc16 or length mismatch"
+    elif vec_id == "G16f" and (cmd_id != 0x22 or len(pld) != 8):
+        return False, "G16f expected 8B 0x22 payload"
+    elif vec_id == "G16g" and (cmd_id != 0x23 or len(pld) != 8):
+        return False, "G16g expected 8B 0x23 status payload"
+    elif vec_id == "G16h" and (cmd_id != 0x23 or len(pld) != 4):
+        return False, "G16h expected 4B 0x23 abort payload"
+    elif vec_id.startswith("G1") or vec_id.startswith("G2"):
+        if cmd_id == 0x06 and len(pld) != 3:
+            return False, f"{vec_id} expected 3B 0x06 NACK payload"
+    return True, "OK"
