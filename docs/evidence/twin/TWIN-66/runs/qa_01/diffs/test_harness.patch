+def _build_ota_g16_vectors() -> List[Dict[str, Any]]:
+    """构建 G16 (G16a~G16h) 固件升级全套载荷黄金向量（含 144B OTA_START 与 520B OTA_DATA）。"""
+    fw_sample = bytes((i & 0xFF) for i in range(64))
+    fw_crc = calc_crc32_ieee(fw_sample)
+    trailer = build_atsg_trailer(fw_sample, BOARD_ID_TH, 0x00010200)
+    p_start = struct.pack("<BBBBIII", DEV_TH, 1, 0, 0, len(fw_sample), fw_crc, 0x00010200) + trailer
+    g16a = pack_v2_frame((DEV_AP, DEV_TH, 3, ROUTE_IS_ROUTED), (REQ_FLAGS_V2, CMD_OTA_START, 16), p_start)
+    g16b, g16c, g16d, g16e = _build_ota_data_chunk_frames(fw_sample)
+    p_fin = struct.pack("<IB3s", fw_crc, 1, b"\x00\x00\x00")
+    g16f = pack_v2_frame((DEV_AP, DEV_TH, 3, ROUTE_IS_ROUTED), (REQ_FLAGS_V2, CMD_OTA_FINISH, 21), p_fin)
+    p_st = struct.pack("<BBHI", 2, 0, 512, 1024)
+    g16g = pack_v2_frame((DEV_TH, DEV_AP, 3, ROUTE_IS_ROUTED), (RESP_FLAGS_V2, CMD_OTA_STATUS, 22), p_st)
+    p_ab = struct.pack("<B3s", 1, b"\x00\x00\x00")
+    g16h = pack_v2_frame((DEV_AP, DEV_MC, 4, 0x00), (REQ_FLAGS_V2, CMD_OTA_STATUS, 23), p_ab)
+    specs = [
+        ("G16", "CMD_OTA_START_144B_WITH_ATSG_TRAILER", CMD_OTA_START, g16a),
+        ("G16a", "CMD_OTA_START_144B_WITH_ATSG_TRAILER", CMD_OTA_START, g16a),
+        ("G16b", "CMD_OTA_DATA_64B_MIN_REGULAR", CMD_OTA_DATA, g16b),
+        ("G16c", "CMD_OTA_DATA_512B_STANDARD_BOOT", CMD_OTA_DATA, g16c),
+        ("G16d", "CMD_OTA_DATA_37B_SHORT_TAIL", CMD_OTA_DATA, g16d),
+        ("G16e", "CMD_OTA_DATA_1016B_MAX_TRANSPORT", CMD_OTA_DATA, g16e),
+        ("G16f", "CMD_OTA_FINISH_8B_COMMIT", CMD_OTA_FINISH, g16f),
+        ("G16g", "CMD_OTA_STATUS_8B_REPORT", CMD_OTA_STATUS, g16g),
+        ("G16h", "CMD_OTA_ABORT_4B_REQUEST", CMD_OTA_STATUS, g16h),
