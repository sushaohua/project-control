+def _build_ota_data_chunk_frames(fw_sample: bytes) -> Tuple[bytes, bytes, bytes, bytes]:
+    """构建 G16b(64B)、G16c(512B)、G16d(37B 尾块) 与 G16e(1016B 极限块) 的 0x21 数据帧。"""
+    p_d64 = struct.pack("<IHH", 0, 64, calc_crc16_ccitt_false(fw_sample)) + fw_sample
+    g16b = pack_v2_frame((DEV_AP, DEV_TH, 3, ROUTE_IS_ROUTED), (REQ_FLAGS_V2, CMD_OTA_DATA, 17), p_d64)
+    c512 = bytes(((i * 7 + 3) & 0xFF) for i in range(512))
+    p_d512 = struct.pack("<IHH", 0, 512, calc_crc16_ccitt_false(c512)) + c512
+    g16c = pack_v2_frame((DEV_AP, DEV_MC, 4, 0x00), (REQ_FLAGS_V2, CMD_OTA_DATA, 18), p_d512)
+    c37 = bytes((0xA0 + i) & 0xFF for i in range(37))
+    p_d37 = struct.pack("<IHH", 512, 37, calc_crc16_ccitt_false(c37)) + c37
+    g16d = pack_v2_frame((DEV_AP, DEV_MC, 4, 0x00), (REQ_FLAGS_V2, CMD_OTA_DATA, 19), p_d37)
+    c1016 = bytes((i & 0xFF) for i in range(1016))
+    p_d1016 = struct.pack("<IHH", 0, 1016, calc_crc16_ccitt_false(c1016)) + c1016
+    g16e = pack_v2_frame((DEV_AP, DEV_MC, 4, 0x00), (REQ_FLAGS_V2, CMD_OTA_DATA, 20), p_d1016)
+    return g16b, g16c, g16d, g16e
