+def _prepare_writable_soc_ap(tmp_dir: pathlib.Path) -> pathlib.Path:
+    """准备包含 third_party/install 依赖链接的可构建 soc-ap 源码根目录（兼容只读 Docker 沙箱）。"""
+    # 若宿主机工作区已存在 third_party/install 则直接复用，否则在临时目录创建带 /usr/local 链接的副本
+    src_soc = WORKSPACE_ROOT / "soc-ap"
+    if (src_soc / "third_party/install").exists():
+        return src_soc
+    soc_copy = tmp_dir / "soc-ap"
+    if not soc_copy.exists():
+        shutil.copytree(src_soc, soc_copy, ignore=shutil.ignore_patterns(".git", "build*", "runtime", "third_party"))
+        tp_dir = soc_copy / "third_party"
+        tp_dir.mkdir(parents=True, exist_ok=True)
+        install_link = tp_dir / "install"
+        if not install_link.exists():
+            install_link.symlink_to("/usr/local")
+    return soc_copy
+
