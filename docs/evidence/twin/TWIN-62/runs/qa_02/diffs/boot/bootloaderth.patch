+/**
+  **************************************************************************
+  * @file     test_th_boot_ota.c
+  * @brief    TH Bootloader MiniMCProto v2.0 最小升级子集宿主机单元测试
+  **************************************************************************
+  */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "iap.h"
+#include "flash.h"
+#include "usart.h"
+
+typedef enum
+{
+  FLASH_OPERATE_DONE = 0,
+  FLASH_PROGRAM_ERROR = 1
+} flash_status_type;
+
+uint8_t g_sim_flash[FLASH_TOTAL_SIZE];
+static uint32_t s_erase_count = 0U;
+static uint32_t s_prog_count = 0U;
+static uint32_t s_reset_count = 0U;
+static uint32_t s_jump_addr = 0U;
+static uint32_t s_sim_tick_ms = 1234U;
+static uint8_t s_last_tx[64];
+static uint16_t s_last_tx_len = 0U;
+
+/**
+  * @brief  测试断言辅助函数（不受 NDEBUG 影响）
+  */
+static void require_true(bool cond, const char *msg)
+{
+  if (!cond)
+  {
+    fprintf(stderr, "[FAIL] %s\n", (msg != NULL) ? msg : "assertion failed");
+    exit(1);
+  }
+}
+
+/**
+  * @brief  模拟 Flash 解锁接口
+  */
+void flash_unlock(void) {}
+
+/**
+  * @brief  模拟 Flash 上锁接口
+  */
+void flash_lock(void) {}
+
+/**
+  * @brief  模拟 2KB Flash 扇区擦除并将对应区域置为 0xFF
+  */
+flash_status_type flash_sector_erase(uint32_t sector_address)
+{
+  uint32_t off = sector_address - FLASH_BASE_ADDR;
+  (void)memset(&g_sim_flash[off], 0xFF, FLASH_SECTOR_SIZE);
+  s_erase_count++;
+  return FLASH_OPERATE_DONE;
+}
+
+/**
+  * @brief  模拟 Flash 半字编程操作
+  */
+flash_status_type flash_halfword_program(uint32_t address, uint16_t data)
+{
+  uint32_t off = address - FLASH_BASE_ADDR;
+  g_sim_flash[off] = (uint8_t)(g_sim_flash[off] & (uint8_t)(data & 0xFFU));
+  g_sim_flash[off + 1U] = (uint8_t)(g_sim_flash[off + 1U] & (uint8_t)((data >> 8U) & 0xFFU));
+  s_prog_count++;
+  return FLASH_OPERATE_DONE;
+}
+
+/**
+  * @brief  模拟获取系统毫秒计数
+  */
+uint32_t tmr_get_tick(void)
+{
+  return s_sim_tick_ms;
+}
+
+/**
+  * @brief  模拟毫秒延时
+  */
+void tmr_delay_ms(uint32_t ms)
+{
+  s_sim_tick_ms += ms;
+}
+
+/**
+  * @brief  模拟软复位回调计数
+  */
+void host_test_on_system_reset(void)
+{
+  s_reset_count++;
+}
+
+/**
+  * @brief  模拟跳转 App 回调记录
+  */
+void host_test_on_app_load(uint32_t app_addr)
+{
+  s_jump_addr = app_addr;
+}
+
+/**
+  * @brief  模拟串口读取字节（单测直接调用 iap_feed_byte）
+  */
+bool bsp_uart1_read_byte(uint8_t *p_byte)
+{
+  (void)p_byte;
+  return false;
+}
+
+/**
+  * @brief  模拟串口剩余接收缓冲单元数
+  */
+uint8_t bsp_uart1_rx_free_units(void)
+{
+  return 16U;
+}
+
+/**
+  * @brief  捕获 Bootloader 通过 USART1 发送的响应帧
+  */
+bool bsp_uart1_send_data(const uint8_t *p_data, uint16_t len)
+{
+  if (p_data == NULL || len > sizeof(s_last_tx))
+  {
+    return false;
+  }
+  (void)memcpy(s_last_tx, p_data, len);
+  s_last_tx_len = len;
+  return true;
+}
+
+/**
+  * @brief  构造并向状态机喂入一帧完整 MiniMCProto v2.0 请求帧
+  */
+static void send_minimc_req(uint8_t cmd_id, uint16_t seq_id, const void *p_payload, uint16_t len)
+{
+  uint8_t frame[MINIMC_MAX_FRAME_SIZE];
+  frame[0] = MINIMC_SOF_0;
+  frame[1] = MINIMC_SOF_1;
+  frame[2] = MINIMC_NODE_AP;
+  frame[3] = MINIMC_NODE_TH;
+  frame[4] = (uint8_t)(MINIMC_FLAG_VERSION_V2 | MINIMC_FLAG_WANTS_ACK);
+  frame[5] = cmd_id;
+  frame[6] = 3U;
+  frame[7] = MINIMC_ROUTE_IS_ROUTED;
+  frame[8] = (uint8_t)(seq_id & 0xFFU);
+  frame[9] = (uint8_t)((seq_id >> 8U) & 0xFFU);
+  frame[10] = (uint8_t)(len & 0xFFU);
+  frame[11] = (uint8_t)((len >> 8U) & 0xFFU);
+  if (p_payload != NULL && len > 0U)
+  {
+    (void)memcpy(&frame[MINIMC_HEADER_SIZE], p_payload, len);
+  }
+  uint16_t crc = iap_crc16_ccitt(frame, (uint16_t)(MINIMC_HEADER_SIZE + len));
+  frame[MINIMC_HEADER_SIZE + len] = (uint8_t)(crc & 0xFFU);
+  frame[MINIMC_HEADER_SIZE + len + 1U] = (uint8_t)((crc >> 8U) & 0xFFU);
+
+  s_last_tx_len = 0U;
+  for (uint16_t i = 0U; i < (uint16_t)(MINIMC_FRAME_OVERHEAD + len); i++)
+  {
+    iap_feed_byte(frame[i]);
+  }
+}
+
+/**
+  * @brief  构造测试固件镜像与配套 128B ATSG Trailer
+  */
+static void build_test_image_and_trailer(uint8_t *p_img, uint32_t len, fw_trailer_t *p_tr, uint32_t *p_crc)
+{
+  for (uint32_t i = 0U; i < len; i++)
+  {
+    p_img[i] = (uint8_t)((i * 7U + 3U) & 0xFFU);
+  }
+  /* 写入合法栈顶 (0x2000B000) 与复位向量 (0x08004101) */
+  uint32_t msp = 0x2000B000U;
+  uint32_t pc = 0x08004101U;
+  (void)memcpy(&p_img[0], &msp, 4U);
+  (void)memcpy(&p_img[4], &pc, 4U);
+
+  (void)memset(p_tr, 0, sizeof(*p_tr));
+  p_tr->magic = TRAILER_MAGIC;
+  p_tr->struct_ver = TRAILER_STRUCT_VER;
+  p_tr->board_id = BOARD_ID_TH;
+  p_tr->fw_version = 0x00010200U;
+  p_tr->payload_len = len;
+  p_tr->trailer_crc32 = iap_crc32_calc((const uint8_t *)p_tr, 124U);
+  *p_crc = iap_crc32_calc(p_img, len);
+}
+
+/**
+  * @brief  测试 0x01/0x02 版本报告、0x03/0x04 心跳与 0x1D 系统控制及非法帧恢复
+  */
+static void test_identity_ping_and_guard_cases(void)
+{
+  (void)memset(g_sim_flash, 0xFF, sizeof(g_sim_flash));
+  iap_init();
+
+  /* G20: 缺少版本位 (Flags=0x01) 必须静默拒绝 */
+  uint8_t bad_ver[14] = {0x55, 0xAA, 0x01, 0x03, 0x01, 0x01, 0x04, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
+  uint16_t c_bad = iap_crc16_ccitt(bad_ver, 12U);
+  bad_ver[12] = (uint8_t)(c_bad & 0xFFU);
+  bad_ver[13] = (uint8_t)((c_bad >> 8U) & 0xFFU);
+  for (uint8_t i = 0U; i < 14U; i++) { iap_feed_byte(bad_ver[i]); }
+  require_true(s_last_tx_len == 0U, "G20 bad version bit must be ignored");
+
+  /* G19: 1025B 超限帧头必须立即丢弃且不影响后续正常帧 */
+  uint8_t over_hdr[12] = {0x55, 0xAA, 0x01, 0x03, 0x05, 0x21, 0x04, 0x00, 0x03, 0x00, 0x01, 0x04};
+  for (uint8_t i = 0U; i < 12U; i++) { iap_feed_byte(over_hdr[i]); }
+  require_true(s_last_tx_len == 0U, "G19 oversize header must be dropped");
+
+  /* 0x01 -> 0x02 VERSION_REPORT */
+  send_minimc_req(MINIMC_CMD_GET_VERSION, 1U, NULL, 0U);
+  require_true(s_last_tx_len == 30U && s_last_tx[5] == MINIMC_CMD_VERSION_REPORT, "0x02 len and cmd");
+  minimc_payload_version_report_t vrep;
+  (void)memcpy(&vrep, &s_last_tx[12], sizeof(vrep));
+  require_true(vrep.capability_flags == TH_BOOT_CAPABILITY_FLAGS && vrep.boot_id != 0U, "TH boot caps");
+
+  /* 0x03 -> 0x04 PONG */
+  uint32_t tok = 0xCAFEBABEU;
+  send_minimc_req(MINIMC_CMD_PING, 2U, &tok, 4U);
+  require_true(s_last_tx_len == 26U && s_last_tx[5] == MINIMC_CMD_PONG, "0x04 pong");
+
+  /* 0x1D JumpToBootloader 幂等回 0x00 ACK */
+  minimc_payload_sys_ctrl_t sc = {2U, 1U, 10U};
+  send_minimc_req(MINIMC_CMD_SYSTEM_CONTROL, 3U, &sc, sizeof(sc));
+  require_true(s_last_tx_len == 18U && s_last_tx[5] == MINIMC_CMD_ACK, "0x1D ack");
+}
+
+/**
+  * @brief  测试 0x20 擦除前原子准入负例（错板、坏 CRC、241665B 超限全部零擦除）
+  */
+static void test_ota_start_negative_zero_erase(void)
+{
+  uint8_t img[1024];
+  fw_trailer_t tr;
+  uint32_t crc = 0U;
+  build_test_image_and_trailer(img, sizeof(img), &tr, &crc);
+  s_erase_count = 0U;
+
+  minimc_payload_ota_start_t start_req;
+  (void)memset(&start_req, 0, sizeof(start_req));
+  start_req.target_device = MINIMC_NODE_TH;
+  start_req.target_component = 1U;
+  start_req.fw_size_bytes = 241665U;
+  start_req.fw_crc32 = crc;
+  start_req.trailer = tr;
+  start_req.trailer.payload_len = 241665U;
+
+  /* 241,665B (236KB + 1B) 必须返回 NACK 0x14 且零擦除 */
+  send_minimc_req(MINIMC_CMD_OTA_START, 10U, &start_req, sizeof(start_req));
+  require_true(s_last_tx_len == 17U && s_last_tx[5] == MINIMC_CMD_NACK, "241665B NACK");
+  require_true(s_last_tx[12] == MINIMC_ERR_OTA_IMAGE_OVERSIZE && s_erase_count == 0U, "241665B 0x14 zero erase");
+
+  /* 错板 (MC 0x43500001) 必须返回 NACK 0x06 且零擦除 */
+  start_req.fw_size_bytes = sizeof(img);
+  start_req.trailer = tr;
+  start_req.trailer.board_id = 0x43500001U;
+  start_req.trailer.trailer_crc32 = iap_crc32_calc((const uint8_t *)&start_req.trailer, 124U);
+  send_minimc_req(MINIMC_CMD_OTA_START, 11U, &start_req, sizeof(start_req));
+  require_true(s_last_tx[5] == MINIMC_CMD_NACK && s_last_tx[12] == MINIMC_ERR_COMMAND_REJECTED, "wrong board NACK");
+  require_true(s_erase_count == 0U, "wrong board zero erase");
+}
+
+/**
+  * @brief  发送单块 0x21 CMD_OTA_DATA 的测试辅助函数
+  */
+static void send_ota_chunk(uint16_t seq, uint32_t offset, const uint8_t *p_data, uint16_t len)
+{
+  uint8_t buf[MINIMC_MAX_PAYLOAD_SIZE];
+  minimc_payload_ota_data_hdr_t dh;
+  dh.offset = offset;
+  dh.chunk_bytes = len;
+  dh.chunk_crc16 = iap_crc16_ccitt(p_data, len);
+  (void)memcpy(buf, &dh, sizeof(dh));
+  (void)memcpy(&buf[sizeof(dh)], p_data, len);
+  send_minimc_req(MINIMC_CMD_OTA_DATA, seq, buf, (uint16_t)(sizeof(dh) + len));
+}
+
+/**
+  * @brief  测试完整升级闭环、Chunk0 缓存、重传幂等、无 Anchor 防护与两阶段提交
+  */
+static void test_full_ota_commit_and_anchor_guard(void)
+{
+  uint8_t img[1024];
+  fw_trailer_t tr;
+  uint32_t crc = 0U;
+  build_test_image_and_trailer(img, sizeof(img), &tr, &crc);
+
+  /* 验证无 Anchor 回退漏洞已修复：即使 0x08004000 有合法向量，无 Anchor 仍返回 false */
+  (void)memcpy(&g_sim_flash[APP_START_ADDR - FLASH_BASE_ADDR], img, 64U);
+  require_true(!bsp_flash_app_integrity_check(), "raw vector without Anchor must be rejected");
+
+  minimc_payload_ota_start_t start_req = {MINIMC_NODE_TH, 1U, 0U, 0U, sizeof(img), crc, 0x00010200U, tr};
+  send_minimc_req(MINIMC_CMD_OTA_START, 20U, &start_req, sizeof(start_req));
+  require_true(s_last_tx[5] == MINIMC_CMD_ACK && s_erase_count == 2U, "OTA_START ACK and 2 sectors erased");
+
+  /* 发送首块 512B：缓存在 SRAM，bytes_written 仍为 0，Flash 首扇区仍为 0xFF */
+  send_ota_chunk(21U, 0U, &img[0], 512U);
+  require_true(s_last_tx[5] == MINIMC_CMD_ACK, "chunk0 ACK");
+  minimc_payload_ota_status_t st;
+  iap_get_ota_status(&st);
+  require_true(st.ota_state == IAP_STATE_CHUNK0_CACHED_RAM && st.cached_chunk0_bytes == 512U && st.bytes_written == 0U,
+               "chunk0 cached in SRAM with bytes_written == 0");
+  require_true(g_sim_flash[APP_START_ADDR - FLASH_BASE_ADDR] == 0xFFU, "0x08004000 untouched before finish");
+
+  /* 同 offset=0 重传幂等 ACK */
+  send_ota_chunk(21U, 0U, &img[0], 512U);
+  require_true(s_last_tx[5] == MINIMC_CMD_ACK, "retransmit chunk0 idempotent ACK");
+
+  /* 发送第二块 512B：写入 Flash 0x08004200，bytes_written == 512 */
+  send_ota_chunk(22U, 512U, &img[512], 512U);
+  require_true(s_last_tx[5] == MINIMC_CMD_ACK, "chunk1 ACK");
+  iap_get_ota_status(&st);
+  require_true(st.ota_state == IAP_STATE_FLASH_WRITING && st.bytes_written == 512U, "chunk1 flash written");
+  require_true(!bsp_flash_app_integrity_check(), "incomplete commit must stay in boot");
+
+  /* 0x22 FINISH 终验通过，两阶段提交 Anchor + Chunk0 */
+  minimc_payload_ota_finish_t fin = {crc, 1U, {0U, 0U, 0U}};
+  send_minimc_req(MINIMC_CMD_OTA_FINISH, 23U, &fin, sizeof(fin));
+  require_true(s_last_tx[5] == MINIMC_CMD_ACK, "OTA_FINISH ACK");
+  require_true(bsp_flash_app_integrity_check(), "committed image + Anchor verified");
+  require_true(s_jump_addr == APP_START_ADDR, "jumped to APP_START_ADDR");
+}
+
+/**
+  * @brief  单元测试主入口
+  */
+int main(void)
+{
+  test_identity_ping_and_guard_cases();
+  test_ota_start_negative_zero_erase();
+  test_full_ota_commit_and_anchor_guard();
+  printf("[PASS] test_th_boot_ota: all TH Bootloader MiniMCProto v2.0 tests passed!\n");
+  return 0;
+}
