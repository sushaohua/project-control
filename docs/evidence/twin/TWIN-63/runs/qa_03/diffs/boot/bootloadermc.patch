+/**
+  * @brief  测试主入口
+  */
+int main(void)
+{
+  test_magic_info_heartbeat_and_dst_filter();
+  test_single_writer_mutex_and_zero_erase_admission();
+  test_full_ota_flow_and_crc_verification();
+  test_usb_host_udisk_upgrade_and_bad_trailer_zero_erase();
+  test_usb_and_uart2_contention_and_recovery();
+  printf("[PASS] test_mc_boot_ota: all MC Bootloader MiniMCProto v2.0 & USB Host tests passed!\n");
+  return 0;
+}
