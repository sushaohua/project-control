diff --git a/Makefile b/Makefile
new file mode 100644
index 0000000..1a553d3
--- /dev/null
+++ b/Makefile
@@ -0,0 +1,97 @@
+# Makefile for AT32F435VGT7 MC Bootloader (TWIN-63)
+CC      := arm-none-eabi-gcc
+OBJCOPY := arm-none-eabi-objcopy
+SIZE    := arm-none-eabi-size
+
+BUILD_DIR := build
+TARGET    := $(BUILD_DIR)/bootloader
+
+CPU_FLAGS := -mcpu=cortex-m4 -mthumb -mfpu=fpv4-sp-d16 -mfloat-abi=hard
+CFLAGS    := $(CPU_FLAGS) -Os -g3 -Wall -Wextra -Werror \
+             -Wno-unused-parameter \
+             -fdata-sections -ffunction-sections \
+             -DAT32F435VGT7 -DUSE_STDPERIPH_DRIVER \
+             -DBOOT_UART_OTA_STANDALONE_OBJECT=1
+
+INCLUDES := -I$(BUILD_DIR) \
+            -Ibootloader/inc \
+            -Ilibraries/cmsis/cm4/core_support \
+            -Ilibraries/cmsis/cm4/device_support \
+            -Ilibraries/drivers/inc \
+            -Ilibraries/middlewares/usb_drivers/inc \
+            -Ilibraries/middlewares/usbh_class/usbh_msc \
+            -Ilibraries/middlewares/3rd_party/fatfs/source
+
+LDFLAGS := $(CPU_FLAGS) \
+           -Tcmake/linker/at32f435_bootloader.ld \
+           -Wl,--gc-sections \
+           -Wl,-Map=$(TARGET).map,--cref \
+           --specs=nano.specs --specs=nosys.specs
+
+C_SRCS := \
+    libraries/cmsis/cm4/device_support/system_at32f435_437.c \
+    libraries/drivers/src/at32f435_437_crm.c \
+    libraries/drivers/src/at32f435_437_gpio.c \
+    libraries/drivers/src/at32f435_437_misc.c \
+    libraries/drivers/src/at32f435_437_pwc.c \
+    libraries/drivers/src/at32f435_437_flash.c \
+    libraries/drivers/src/at32f435_437_usart.c \
+    libraries/drivers/src/at32f435_437_crc.c \
+    libraries/drivers/src/at32f435_437_i2c.c \
+    libraries/drivers/src/at32f435_437_usb.c \
+    libraries/middlewares/usb_drivers/src/usb_core.c \
+    libraries/middlewares/usb_drivers/src/usbh_core.c \
+    libraries/middlewares/usb_drivers/src/usbh_ctrl.c \
+    libraries/middlewares/usb_drivers/src/usbh_int.c \
+    libraries/middlewares/usbh_class/usbh_msc/usbh_msc_class.c \
+    libraries/middlewares/usbh_class/usbh_msc/usbh_msc_bot_scsi.c \
+    libraries/middlewares/3rd_party/fatfs/source/ff.c \
+    libraries/middlewares/3rd_party/fatfs/source/ffsystem.c \
+    bootloader/src/main.c \
+    bootloader/src/at32f435_437_clock.c \
+    bootloader/src/at32f435_437_int.c \
+    bootloader/src/bsp_uart.c \
+    bootloader/src/boot_uart_ota.c \
+    bootloader/src/usbh_msc_diskio.c \
+    bootloader/src/usbh_user.c \
+    bootloader/src/bsp_eeprom.c
+
+ASM_SRCS := libraries/cmsis/cm4/device_support/startup/gcc/startup_at32f435_437.s
+
+OBJS := $(patsubst %.c,$(BUILD_DIR)/%.o,$(C_SRCS)) \
+        $(patsubst %.s,$(BUILD_DIR)/%.o,$(ASM_SRCS))
+
+.PHONY: all clean headers
+
+all: $(TARGET).elf $(TARGET).bin $(TARGET).hex
+	$(SIZE) --format=berkeley $(TARGET).elf
+
+headers:
+	@mkdir -p $(BUILD_DIR)
+	@echo "#ifndef BOOTLOADER_TIMESTAMP_H" > $(BUILD_DIR)/bootloader_timestamp.h
+	@echo "#define BOOTLOADER_TIMESTAMP_H" >> $(BUILD_DIR)/bootloader_timestamp.h
+	@echo "#endif" >> $(BUILD_DIR)/bootloader_timestamp.h
+	@echo "#ifndef BOOTLOADER_BUILD_INFO_H" > $(BUILD_DIR)/bootloader_build_info.h
+	@echo "#define BOOTLOADER_BUILD_INFO_H" >> $(BUILD_DIR)/bootloader_build_info.h
+	@echo "#define BOOTLOADER_BUILD_NUMBER (1UL)" >> $(BUILD_DIR)/bootloader_build_info.h
+	@echo "#endif" >> $(BUILD_DIR)/bootloader_build_info.h
+
+$(BUILD_DIR)/%.o: %.c | headers
+	@mkdir -p $(dir $@)
+	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@
+
+$(BUILD_DIR)/%.o: %.s | headers
+	@mkdir -p $(dir $@)
+	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@
+
+$(TARGET).elf: $(OBJS)
+	$(CC) $(OBJS) $(LDFLAGS) -o $@
+
+$(TARGET).bin: $(TARGET).elf
+	$(OBJCOPY) -O binary -S $< $@
+
+$(TARGET).hex: $(TARGET).elf
+	$(OBJCOPY) -O ihex $< $@
+
+clean:
+	rm -rf $(BUILD_DIR)
