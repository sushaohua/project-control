+static FRESULT f_read(FIL *fp, void *buff, UINT btr, UINT *br)
+{
+  uint32_t avail = (fp->offset < fp->size) ? (fp->size - fp->offset) : 0U;
+  uint32_t n = (btr < avail) ? btr : avail;
+  if (n > 0U)
+  {
+    memcpy(buff, &s_udisk_data[fp->offset], n);
+    fp->offset += n;
+  }
+  *br = (UINT)n;
+  return FR_OK;
