diff --git a/bootloader/inc/boot_uart_ota.h b/bootloader/inc/boot_uart_ota.h
new file mode 100644
index 0000000..3d47fbe
--- /dev/null
+++ b/bootloader/inc/boot_uart_ota.h
@@ -0,0 +1,342 @@
+/**
+  **************************************************************************
+  * @file     boot_uart_ota.h
+  * @brief    MC Bootloader (AT32F435) USART2 MiniMCProto v2.0 (Rev 2.0.4) OTA 与单写者仲裁头文件
+  **************************************************************************
+  */
+#ifndef __BOOT_UART_OTA_H
+#define __BOOT_UART_OTA_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include "firmware_trailer.h"
+
+/* ================= MiniMCProto v2.0 (Rev 2.0.4) 帧头、节点与能力常量 ================= */
+#define MINIMC_SOF_0                    (0x55U)
+#define MINIMC_SOF_1                    (0xAAU)
+#define MINIMC_HEADER_SIZE              (12U)
+#define MINIMC_CRC_SIZE                 (2U)
+#define MINIMC_FRAME_OVERHEAD           (14U)
+#define MINIMC_MAX_PAYLOAD_SIZE         (520U)
+#define MINIMC_MAX_FRAME_SIZE           (534U)
+#define MINIMC_DEFAULT_HOP_LIMIT        (4U)
+
+#define MINIMC_NODE_AP                  (0x01U)
+#define MINIMC_NODE_MC                  (0x02U)
+#define MINIMC_NODE_TH                  (0x03U)
+#define MINIMC_NODE_BROADCAST           (0xFFU)
+
+#define MINIMC_FLAG_WANTS_ACK           (0x01U)
+#define MINIMC_FLAG_IS_RESPONSE         (0x02U)
+#define MINIMC_FLAG_VERSION_V2          (0x04U)
+#define MINIMC_FLAG_PRIORITY            (0x10U)
+#define MINIMC_ROUTE_IS_ROUTED          (0x04U)
+
+/* ================= MiniMCProto v2.0 (Rev 2.0.4) 统一命令字定义 ================= */
+#define MINIMC_CMD_ACK                  (0x00U)
+#define MINIMC_CMD_GET_VERSION          (0x01U)
+#define MINIMC_CMD_VERSION_REPORT       (0x02U)
+#define MINIMC_CMD_PING                 (0x03U)
+#define MINIMC_CMD_PONG                 (0x04U)
+#define MINIMC_CMD_NACK                 (0x06U)
+#define MINIMC_CMD_SET_TEMP             (0x10U)
+#define MINIMC_CMD_MOTION_HOME          (0x11U)
+#define MINIMC_CMD_MOTION_MOVE          (0x12U)
+#define MINIMC_CMD_JOB_CONTROL          (0x13U)
+#define MINIMC_CMD_TEMP_QUERY           (0x14U)
+#define MINIMC_CMD_GET_TEMP             (0x14U)
+#define MINIMC_CMD_TEMP_REPORT          (0x15U)
+#define MINIMC_CMD_TEMP_REPORT_V2       (0x15U)
+#define MINIMC_CMD_POS_QUERY            (0x16U)
+#define MINIMC_CMD_GET_POS              (0x16U)
+#define MINIMC_CMD_EMERGENCY_STOP       (0x17U)
+#define MINIMC_CMD_MOTION_STOP          (0x17U)
+#define MINIMC_CMD_POS_REPORT           (0x18U)
+#define MINIMC_CMD_LEVEL_GRID_QUERY     (0x18U)
+#define MINIMC_CMD_SLOT_SELECT          (0x19U)
+#define MINIMC_CMD_FILAMENT_CONTROL     (0x19U)
+#define MINIMC_CMD_FILAMENT_STATUS      (0x1AU)
+#define MINIMC_CMD_LEVEL_TRIGGER        (0x1AU)
+#define MINIMC_CMD_FILAMENT_LEGACY      (0x1BU)
+#define MINIMC_CMD_GCODE_LINE           (0x1CU)
+#define MINIMC_CMD_GCODE_EXEC           (0x1CU)
+#define MINIMC_CMD_SYSTEM_CONTROL       (0x1DU)
+#define MINIMC_CMD_OTA_START            (0x20U)
+#define MINIMC_CMD_OTA_DATA             (0x21U)
+#define MINIMC_CMD_OTA_FINISH           (0x22U)
+#define MINIMC_CMD_OTA_STATUS           (0x23U)
+
+/* ================= MiniMCProto v2.0 (Rev 2.0.4) 标准错误码定义 ================= */
+#define MINIMC_ERR_CRC_FAIL             (0x01U)
+#define MINIMC_ERR_MTU_EXCEEDED         (0x02U)
+#define MINIMC_ERR_SEQ_OUT_OF_WINDOW    (0x03U)
+#define MINIMC_ERR_UNKNOWN_CMD          (0x04U)
+#define MINIMC_ERR_DEVICE_BUSY          (0x05U)
+#define MINIMC_ERR_COMMAND_REJECTED     (0x06U)
+#define MINIMC_ERR_OTA_ERASE_FAIL       (0x10U)
+#define MINIMC_ERR_OTA_WRITE_FAIL       (0x11U)
+#define MINIMC_ERR_OTA_CRC_MISMATCH     (0x12U)
+#define MINIMC_ERR_OTA_INVALID_OFFSET   (0x13U)
+#define MINIMC_ERR_OTA_IMAGE_OVERSIZE   (0x14U)
+
+/* ================= MC Bootloader 硬件与分区常量 ================= */
+#define MC_MAX_APP_SIZE                 (896U * 1024U)  /* 917,504 Bytes */
+#define MC_FLASH_SECTOR_SIZE            (2048U)         /* 2KB 扇区 */
+#define MC_BOOT_CAPABILITY_FLAGS        (0xC0080435UL)  /* Bit31=Boot, Bit30=ATSG, Bit19=520B, 0x0435 */
+#define MC_FW_GIT_COMMIT_SHORT          (0x4FC171EAUL)
+#define BOOT_MC_UPGRADE_MAGIC_ADDR      (0x2005FFF0UL)  /* SRAM 顶部保留魔数地址 */
+#define BOOT_MC_UPGRADE_MAGIC_VAL       (0x55504732UL)  /* "UPG2" 驻留魔数 */
+#define BOOT_UART2_BAUDRATE             (921600U)
+#define BOOT_UART2_RX_RING_SIZE         (1024U)
+#define CHUNK_MAX_SIZE                  (512U)
+
+/**
+  * @brief  单写者互斥锁持有方枚举 (USB U盘 vs USART2 串口升级)
+  */
+typedef enum
+{
+  BOOT_WRITER_NONE  = 0U,
+  BOOT_WRITER_USB   = 1U,
+  BOOT_WRITER_UART2 = 2U
+} boot_writer_t;
+
+/**
+  * @brief  MC 串口 OTA 状态枚举 (对齐 0x23 CMD_OTA_STATUS.ota_state)
+  */
+typedef enum
+{
+  MC_OTA_STATE_IDLE               = 0U,
+  MC_OTA_STATE_ERASED_READY       = 1U,
+  MC_OTA_STATE_FLASH_WRITING      = 3U,
+  MC_OTA_STATE_VERIFIED_COMMITTED = 4U,
+  MC_OTA_STATE_ERROR              = 5U
+} mc_ota_state_t;
+
+#pragma pack(push, 1)
+
+/**
+  * @brief  MiniMCProto v2.0 12 字节帧头结构体
+  */
+typedef struct
+{
+  uint8_t  sof0;
+  uint8_t  sof1;
+  uint8_t  src_id;
+  uint8_t  dst_id;
+  uint8_t  flags;
+  uint8_t  cmd_id;
+  uint8_t  hop_limit;
+  uint8_t  route_ctrl;
+  uint16_t seq_id;
+  uint16_t payload_len;
+} minimc_frame_hdr_t;
+
+/**
+  * @brief  0x00 CMD_ACK 4 字节标准应答载荷
+  */
+typedef struct
+{
+  uint8_t  planner_buf_free;
+  uint8_t  rx_fifo_free_units;
+  uint16_t reserved;
+} minimc_payload_ack_t;
+
+/**
+  * @brief  0x06 CMD_NACK 3 字节否定应答载荷
+  */
+typedef struct
+{
+  uint8_t  error_code;
+  uint16_t expected_seq;
+} minimc_payload_nack_t;
+
+/**
+  * @brief  0x02 CMD_VERSION_REPORT 16 字节载荷
+  */
+typedef struct
+{
+  uint8_t  proto_major;
+  uint8_t  proto_minor;
+  uint8_t  fw_major;
+  uint8_t  fw_minor;
+  uint32_t boot_id;
+  uint32_t git_commit_short;
+  uint32_t capability_flags;
+} minimc_payload_version_report_t;
+
+/**
+  * @brief  0x04 CMD_PONG 12 字节载荷
+  */
+typedef struct
+{
+  uint32_t echo_token;
+  uint32_t uptime_ms;
+  uint16_t rx_ok_count;
+  uint16_t rx_crc_err_count;
+} minimc_payload_pong_t;
+
+/**
+  * @brief  0x1D CMD_SYSTEM_CONTROL 4 字节载荷 (action: 1=Reboot, 2=JumpToBootloader)
+  */
+typedef struct
+{
+  uint8_t  action;
+  uint8_t  target_component;
+  uint16_t delay_ms;
+} minimc_payload_sys_ctrl_t;
+
+/**
+  * @brief  0x20 CMD_OTA_START 144 字节原子准入载荷 (16B 标准头 + 128B ATSG Trailer)
+  */
+typedef struct
+{
+  uint8_t      target_device;
+  uint8_t      target_component;
+  uint8_t      force_flag;
+  uint8_t      reserved;
+  uint32_t     fw_size_bytes;
+  uint32_t     fw_crc32;
+  uint32_t     new_version_raw;
+  fw_trailer_t trailer;
+} minimc_payload_ota_start_t;
+
+/**
+  * @brief  0x21 CMD_OTA_DATA 8 字节数据块头部
+  */
+typedef struct
+{
+  uint32_t offset;
+  uint16_t chunk_bytes;
+  uint16_t chunk_crc16;
+} minimc_payload_ota_data_hdr_t;
+
+/**
+  * @brief  0x22 CMD_OTA_FINISH 8 字节终验载荷
+  */
+typedef struct
+{
+  uint32_t fw_crc32;
+  uint8_t  action_after_verify;
+  uint8_t  reserved[3];
+} minimc_payload_ota_finish_t;
+
+/**
+  * @brief  0x23 CMD_OTA_STATUS 8 字节状态报告载荷
+  */
+typedef struct
+{
+  uint8_t  ota_state;
+  uint8_t  error_code;
+  uint16_t cached_chunk0_bytes;
+  uint32_t bytes_written;
+} minimc_payload_ota_status_t;
+
+#pragma pack(pop)
+
+#if defined(__STDC_VERSION__) && (__STDC_VERSION__ >= 201112L)
+_Static_assert(sizeof(minimc_frame_hdr_t) == 12U, "minimc_frame_hdr_t must be 12 bytes");
+_Static_assert(sizeof(minimc_payload_ota_start_t) == 144U, "minimc_payload_ota_start_t must be 144 bytes");
+_Static_assert(sizeof(minimc_payload_ota_data_hdr_t) == 8U, "minimc_payload_ota_data_hdr_t must be 8 bytes");
+_Static_assert(sizeof(minimc_payload_ota_finish_t) == 8U, "minimc_payload_ota_finish_t must be 8 bytes");
+_Static_assert(sizeof(minimc_payload_ota_status_t) == 8U, "minimc_payload_ota_status_t must be 8 bytes");
+_Static_assert(sizeof(fw_trailer_t) == 128U, "fw_trailer_t must be 128 bytes");
+#endif
+
+/**
+  * @brief  MC Bootloader 串口 OTA 上下文结构体
+  */
+typedef struct
+{
+  mc_ota_state_t state;
+  uint8_t        last_error;
+  uint16_t       rx_ok_count;
+  uint16_t       rx_crc_err_count;
+  uint32_t       expected_size;
+  uint32_t       expected_crc32;
+  uint32_t       next_offset;
+  uint32_t       erased_end_addr;
+  uint32_t       boot_id;
+  uint8_t        stay_in_boot;
+  uint8_t        pending_jump;
+  uint8_t        pending_reboot;
+} mc_ota_ctx_t;
+
+/**
+  * @brief  计算标准 IEEE 802.3 CRC32
+  */
+uint32_t boot_crc32_ieee(const uint8_t *p_data, uint32_t length);
+
+/**
+  * @brief  计算 CRC16-CCITT (Poly=0x1021, Init=0xFFFF)
+  */
+uint16_t boot_crc16_ccitt(const uint8_t *p_data, uint32_t length);
+
+/**
+  * @brief  校验 128 字节 ATSG Trailer 结构体合法性 (含 struct_ver、board_id、尺寸与 trailer_crc32)
+  * @retval 0 合法，负数表示非法
+  */
+int boot_verify_trailer_struct(const fw_trailer_t *p_trailer,
+                               uint32_t expected_board_id,
+                               uint32_t max_payload_len);
+
+/**
+  * @brief  尝试获取单写者互斥锁 (USB Host vs USART2)
+  * @retval 1 获取成功，0 已被另一通道占用
+  */
+uint8_t boot_ota_acquire_writer(boot_writer_t writer);
+
+/**
+  * @brief  释放单写者互斥锁
+  */
+void boot_ota_release_writer(boot_writer_t writer);
+
+/**
+  * @brief  查询当前持有单写者互斥锁的通道
+  */
+boot_writer_t boot_ota_get_active_writer(void);
+
+/**
+  * @brief  初始化 USART2 (PA2/PA3 @ 921600 8N1) 及 OTA 引擎，并检测 UPG2 驻留魔数
+  */
+void boot_uart_ota_init(void);
+
+/**
+  * @brief  排空并复位关闭 USART2 外设 (跳转 App 前调用)
+  */
+void boot_uart_ota_deinit(void);
+
+/**
+  * @brief  USART2 接收中断单字节推入环形队列
+  */
+void boot_uart_ota_rx_byte_isr(uint8_t byte);
+
+/**
+  * @brief  主循环轮询解析 USART2 MiniMCProto v2.0 升级帧
+  */
+void boot_uart_ota_poll(void);
+
+/**
+  * @brief  查询是否应驻留 Bootloader (收到 UPG2 魔数、0x1D 或 0x20 升级会话)
+  */
+uint8_t boot_uart_ota_should_stay_in_boot(void);
+
+/**
+  * @brief  获取当前上电周期动态生成的 boot_id
+  */
+uint32_t boot_uart_ota_get_boot_id(void);
+
+/**
+  * @brief  获取当前串口 OTA 上下文只读指针 (供单元测试与诊断使用)
+  */
+const mc_ota_ctx_t *boot_uart_ota_get_ctx(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __BOOT_UART_OTA_H */
diff --git a/bootloader/src/boot_uart_ota.c b/bootloader/src/boot_uart_ota.c
new file mode 100644
index 0000000..61bf8fc
--- /dev/null
+++ b/bootloader/src/boot_uart_ota.c
@@ -0,0 +1,828 @@
+/**
+  **************************************************************************
+  * @file     boot_uart_ota.c
+  * @brief    MC Bootloader (AT32F435) USART2 MiniMCProto v2.0 (Rev 2.0.4) OTA 与单写者仲裁实现
+  **************************************************************************
+  */
+#ifndef BOOT_UART_OTA_C_INCLUDED
+#define BOOT_UART_OTA_C_INCLUDED
+
+#include "boot_uart_ota.h"
+#include "usbh_user.h"
+#include <string.h>
+#include <stdio.h>
+
+#ifndef HOST_UNIT_TEST
+#include "at32f435_437.h"
+#include "at32f435_437_clock.h"
+#include "at32f435_437_flash.h"
+#include "at32f435_437_usart.h"
+#include "at32f435_437_gpio.h"
+#include "at32f435_437_crm.h"
+#include "at32f435_437_misc.h"
+#else
+/* Host 单元测试模拟桩声明 */
+extern uint32_t host_mock_get_systick_ms(void);
+extern int host_mock_flash_erase_sector(uint32_t sector_addr);
+extern int host_mock_flash_write_bytes(uint32_t addr, const uint8_t *p_data, uint32_t len);
+extern const uint8_t *host_mock_flash_ptr(uint32_t addr);
+extern void host_mock_uart2_send_bytes(const uint8_t *p_data, uint16_t len);
+extern uint32_t host_mock_read_magic(void);
+extern void host_mock_write_magic(uint32_t val);
+extern void host_mock_system_reset(void);
+extern void host_mock_jump_to_app(uint32_t addr);
+#endif
+
+#define UART2_TX_TIMEOUT_LOOPS          (200000U)
+
+/* 单写者互斥锁与串口环形队列静态存储 */
+static volatile boot_writer_t s_active_writer = BOOT_WRITER_NONE;
+static volatile uint8_t s_rx_ring[BOOT_UART2_RX_RING_SIZE];
+static volatile uint16_t s_rx_head = 0U;
+static volatile uint16_t s_rx_tail = 0U;
+
+/* 帧解析与发送静态缓冲 */
+static uint8_t s_frame_buf[MINIMC_MAX_FRAME_SIZE];
+static uint16_t s_frame_idx = 0U;
+static uint16_t s_expected_frame_len = 0U;
+static uint8_t s_tx_buf[MINIMC_MAX_FRAME_SIZE];
+static uint32_t s_boot_salt = 0U;
+static mc_ota_ctx_t s_ota;
+
+/**
+  * @brief  计算标准 IEEE 802.3 CRC32 (Poly=0xEDB88320, Init=0xFFFFFFFF)
+  */
+uint32_t boot_crc32_ieee(const uint8_t *p_data, uint32_t length)
+{
+  if (p_data == NULL && length > 0U)
+  {
+    return 0U;
+  }
+
+  uint32_t crc = 0xFFFFFFFFUL;
+  for (uint32_t i = 0U; i < length; i++)
+  {
+    crc ^= (uint32_t)p_data[i];
+    for (uint8_t bit = 0U; bit < 8U; bit++)
+    {
+      if ((crc & 1UL) != 0UL)
+      {
+        crc = (crc >> 1U) ^ 0xEDB88320UL;
+      }
+      else
+      {
+        crc >>= 1U;
+      }
+    }
+  }
+  return ~crc;
+}
+
+/**
+  * @brief  计算 CRC16-CCITT (Poly=0x1021, Init=0xFFFF)
+  */
+uint16_t boot_crc16_ccitt(const uint8_t *p_data, uint32_t length)
+{
+  if (p_data == NULL && length > 0U)
+  {
+    return 0U;
+  }
+
+  uint16_t crc = 0xFFFFU;
+  for (uint32_t i = 0U; i < length; i++)
+  {
+    crc ^= (uint16_t)((uint16_t)p_data[i] << 8U);
+    for (uint8_t bit = 0U; bit < 8U; bit++)
+    {
+      if ((crc & 0x8000U) != 0U)
+      {
+        crc = (uint16_t)((crc << 1U) ^ 0x1021U);
+      }
+      else
+      {
+        crc = (uint16_t)(crc << 1U);
+      }
+    }
+  }
+  return crc;
+}
+
+/**
+  * @brief  校验 128 字节 ATSG Trailer 结构体合法性 (魔数、版本、Board ID、净荷上限与自身 CRC32)
+  */
+int boot_verify_trailer_struct(const fw_trailer_t *p_trailer,
+                               uint32_t expected_board_id,
+                               uint32_t max_payload_len)
+{
+  if (p_trailer == NULL)
+  {
+    return -1;
+  }
+  if (p_trailer->magic != TRAILER_MAGIC_ATSG)
+  {
+    return -2;
+  }
+  if (p_trailer->struct_ver != TRAILER_STRUCT_VER_V1)
+  {
+    return -3;
+  }
+  if (p_trailer->board_id != expected_board_id)
+  {
+    return -4;
+  }
+  if (p_trailer->payload_len == 0U || p_trailer->payload_len > max_payload_len)
+  {
+    return -5;
+  }
+
+  uint32_t calc_crc = boot_crc32_ieee((const uint8_t *)p_trailer, TRAILER_HEADER_CRC_SIZE);
+  if (calc_crc != p_trailer->trailer_crc32)
+  {
+    return -6;
+  }
+  return 0;
+}
+
+/**
+  * @brief  尝试获取单写者互斥锁 (USB U盘升级 vs USART2 串口升级)
+  */
+uint8_t boot_ota_acquire_writer(boot_writer_t writer)
+{
+  if (writer == BOOT_WRITER_NONE)
+  {
+    return 0U;
+  }
+  if (s_active_writer == BOOT_WRITER_NONE || s_active_writer == writer)
+  {
+    s_active_writer = writer;
+    return 1U;
+  }
+  return 0U;
+}
+
+/**
+  * @brief  释放单写者互斥锁
+  */
+void boot_ota_release_writer(boot_writer_t writer)
+{
+  if (s_active_writer == writer)
+  {
+    s_active_writer = BOOT_WRITER_NONE;
+  }
+}
+
+/**
+  * @brief  查询当前持有单写者互斥锁的通道
+  */
+boot_writer_t boot_ota_get_active_writer(void)
+{
+  return s_active_writer;
+}
+
+/**
+  * @brief  生成动态非零 boot_id (基于 UID 寄存器与上电盐值)
+  */
+static uint32_t derive_dynamic_boot_id(void)
+{
+  s_boot_salt += 0x9E3779B9UL;
+#ifndef HOST_UNIT_TEST
+  uint32_t uid0 = *(volatile uint32_t *)0x1FFFF7E8UL;
+  uint32_t uid1 = *(volatile uint32_t *)0x1FFFF7ECUL;
+  uint32_t uid2 = *(volatile uint32_t *)0x1FFFF7F0UL;
+  uint32_t rst = CRM->ctrlsts;
+  uint32_t id = uid0 ^ ((uid1 << 7U) | (uid1 >> 25U)) ^ uid2 ^ rst ^ s_boot_salt;
+#else
+  uint32_t id = 0x4350A55AUL ^ s_boot_salt;
+#endif
+  if (id == 0UL)
+  {
+    id = 0x43500001UL;
+  }
+  return id;
+}
+
+/**
+  * @brief  通过 USART2 发送指定长度字节流 (带超时保护)
+  */
+static void uart2_send_raw(const uint8_t *p_buf, uint16_t len)
+{
+  if (p_buf == NULL || len == 0U)
+  {
+    return;
+  }
+#ifndef HOST_UNIT_TEST
+  for (uint16_t i = 0U; i < len; i++)
+  {
+    uint32_t timeout = UART2_TX_TIMEOUT_LOOPS;
+    while (usart_flag_get(USART2, USART_TDBE_FLAG) == RESET && timeout > 0U)
+    {
+      timeout--;
+    }
+    usart_data_transmit(USART2, (uint16_t)p_buf[i]);
+  }
+  uint32_t tdc_timeout = UART2_TX_TIMEOUT_LOOPS;
+  while (usart_flag_get(USART2, USART_TDC_FLAG) == RESET && tdc_timeout > 0U)
+  {
+    tdc_timeout--;
+  }
+#else
+  host_mock_uart2_send_bytes(p_buf, len);
+#endif
+}
+
+/**
+  * @brief  组装并通过 USART2 发送一帧 MiniMCProto v2.0 响应 (MC -> AP)
+  */
+static void send_minimc_response(const minimc_frame_hdr_t *p_req,
+                                 uint8_t rsp_cmd,
+                                 const uint8_t *p_payload,
+                                 uint16_t payload_len)
+{
+  if (p_req == NULL || payload_len > MINIMC_MAX_PAYLOAD_SIZE)
+  {
+    return;
+  }
+
+  minimc_frame_hdr_t hdr;
+  hdr.sof0 = MINIMC_SOF_0;
+  hdr.sof1 = MINIMC_SOF_1;
+  hdr.src_id = MINIMC_NODE_MC;
+  hdr.dst_id = p_req->src_id;
+  hdr.flags = (uint8_t)(MINIMC_FLAG_VERSION_V2 | MINIMC_FLAG_IS_RESPONSE);
+  hdr.cmd_id = rsp_cmd;
+  hdr.hop_limit = MINIMC_DEFAULT_HOP_LIMIT;
+  hdr.route_ctrl = 0U;
+  hdr.seq_id = p_req->seq_id;
+  hdr.payload_len = payload_len;
+
+  memcpy(s_tx_buf, &hdr, MINIMC_HEADER_SIZE);
+  if (payload_len > 0U && p_payload != NULL)
+  {
+    memcpy(&s_tx_buf[MINIMC_HEADER_SIZE], p_payload, payload_len);
+  }
+
+  uint16_t crc_pos = (uint16_t)(MINIMC_HEADER_SIZE + payload_len);
+  uint16_t crc = boot_crc16_ccitt(s_tx_buf, crc_pos);
+  s_tx_buf[crc_pos] = (uint8_t)(crc & 0xFFU);
+  s_tx_buf[crc_pos + 1U] = (uint8_t)((crc >> 8U) & 0xFFU);
+
+  uart2_send_raw(s_tx_buf, (uint16_t)(crc_pos + MINIMC_CRC_SIZE));
+}
+
+/**
+  * @brief  发送标准 4 字节 0x00 CMD_ACK 应答帧
+  */
+static void send_ack(const minimc_frame_hdr_t *p_req)
+{
+  minimc_payload_ack_t ack;
+  ack.planner_buf_free = 16U;
+  ack.rx_fifo_free_units = 2U;
+  ack.reserved = 0U;
+  send_minimc_response(p_req, MINIMC_CMD_ACK, (const uint8_t *)&ack, sizeof(ack));
+}
+
+/**
+  * @brief  发送标准 3 字节 0x06 CMD_NACK 错误应答帧
+  */
+static void send_nack(const minimc_frame_hdr_t *p_req, uint8_t err_code)
+{
+  s_ota.last_error = err_code;
+  minimc_payload_nack_t nack;
+  nack.error_code = err_code;
+  nack.expected_seq = p_req->seq_id;
+  send_minimc_response(p_req, MINIMC_CMD_NACK, (const uint8_t *)&nack, sizeof(nack));
+}
+
+/**
+  * @brief  处理 0x01 CMD_GET_VERSION 请求并回复 16B 0x02 CMD_VERSION_REPORT
+  */
+static void handle_cmd_get_version(const minimc_frame_hdr_t *p_req)
+{
+  if (p_req->payload_len != 0U)
+  {
+    send_nack(p_req, MINIMC_ERR_COMMAND_REJECTED);
+    return;
+  }
+  s_ota.stay_in_boot = 1U;
+  minimc_payload_version_report_t rep;
+  rep.proto_major = 2U;
+  rep.proto_minor = 0U;
+  rep.fw_major = 1U;
+  rep.fw_minor = 0U;
+  rep.boot_id = s_ota.boot_id;
+  rep.git_commit_short = MC_FW_GIT_COMMIT_SHORT;
+  rep.capability_flags = MC_BOOT_CAPABILITY_FLAGS;
+  send_minimc_response(p_req, MINIMC_CMD_VERSION_REPORT, (const uint8_t *)&rep, sizeof(rep));
+}
+
+/**
+  * @brief  处理 0x03 CMD_PING 请求并回复 12B 0x04 CMD_PONG
+  */
+static void handle_cmd_ping(const minimc_frame_hdr_t *p_req, const uint8_t *p_payload)
+{
+  if (p_req->payload_len != 4U || p_payload == NULL)
+  {
+    send_nack(p_req, MINIMC_ERR_COMMAND_REJECTED);
+    return;
+  }
+  minimc_payload_pong_t pong;
+  memcpy(&pong.echo_token, p_payload, 4U);
+#ifndef HOST_UNIT_TEST
+  pong.uptime_ms = get_systick_ms();
+#else
+  pong.uptime_ms = host_mock_get_systick_ms();
+#endif
+  pong.rx_ok_count = s_ota.rx_ok_count;
+  pong.rx_crc_err_count = s_ota.rx_crc_err_count;
+  send_minimc_response(p_req, MINIMC_CMD_PONG, (const uint8_t *)&pong, sizeof(pong));
+}
+
+/**
+  * @brief  处理 0x1D CMD_SYSTEM_CONTROL (action: 1=Reboot, 2=JumpToBootloader)
+  */
+static void handle_cmd_system_control(const minimc_frame_hdr_t *p_req,
+                                      const uint8_t *p_payload)
+{
+  if (p_payload == NULL || p_req->payload_len != sizeof(minimc_payload_sys_ctrl_t))
+  {
+    send_nack(p_req, MINIMC_ERR_COMMAND_REJECTED);
+    return;
+  }
+
+  minimc_payload_sys_ctrl_t ctrl;
+  memcpy(&ctrl, p_payload, sizeof(ctrl));
+  if (ctrl.action == 2U)
+  {
+    s_ota.stay_in_boot = 1U;
+    send_ack(p_req);
+  }
+  else if (ctrl.action == 1U)
+  {
+    send_ack(p_req);
+    s_ota.pending_reboot = 1U;
+  }
+  else
+  {
+    send_nack(p_req, MINIMC_ERR_COMMAND_REJECTED);
+  }
+}
+
+/**
+  * @brief  处理 0x20 CMD_OTA_START (144B 擦除前 ATSG 准入校验与单写者加锁)
+  */
+static void handle_cmd_ota_start(const minimc_frame_hdr_t *p_req,
+                                 const uint8_t *p_payload)
+{
+  if (g_upgrade_in_progress != 0U || boot_ota_acquire_writer(BOOT_WRITER_UART2) == 0U)
+  {
+    send_nack(p_req, MINIMC_ERR_DEVICE_BUSY);
+    return;
+  }
+
+  if (p_payload == NULL || p_req->payload_len != sizeof(minimc_payload_ota_start_t))
+  {
+    boot_ota_release_writer(BOOT_WRITER_UART2);
+    send_nack(p_req, MINIMC_ERR_COMMAND_REJECTED);
+    return;
+  }
+
+  minimc_payload_ota_start_t req;
+  memcpy(&req, p_payload, sizeof(req));
+  if (req.fw_size_bytes > MC_MAX_APP_SIZE || req.trailer.payload_len > MC_MAX_APP_SIZE)
+  {
+    boot_ota_release_writer(BOOT_WRITER_UART2);
+    send_nack(p_req, MINIMC_ERR_OTA_IMAGE_OVERSIZE);
+    return;
+  }
+  if (req.target_device != MINIMC_NODE_MC ||
+      req.fw_size_bytes == 0U ||
+      req.fw_size_bytes != req.trailer.payload_len ||
+      boot_verify_trailer_struct(&req.trailer, BOARD_ID_MC_AT32F435, MC_MAX_APP_SIZE) != 0)
+  {
+    boot_ota_release_writer(BOOT_WRITER_UART2);
+    send_nack(p_req, MINIMC_ERR_COMMAND_REJECTED);
+    return;
+  }
+
+  s_ota.stay_in_boot = 1U;
+  s_ota.state = MC_OTA_STATE_ERASED_READY;
+  s_ota.last_error = 0U;
+  s_ota.expected_size = req.fw_size_bytes;
+  s_ota.expected_crc32 = req.fw_crc32;
+  s_ota.next_offset = 0U;
+  s_ota.erased_end_addr = FLASH_APP_ADDR;
+  send_ack(p_req);
+}
+
+/**
+  * @brief  按需擦除 2KB 扇区并向 MC App 分区写入与回读校验数据块
+  */
+static int write_mc_app_flash_chunk(uint32_t offset,
+                                    const uint8_t *p_data,
+                                    uint32_t data_len)
+{
+  uint32_t target_addr = FLASH_APP_ADDR + offset;
+  uint32_t end_addr = target_addr + data_len;
+
+#ifndef HOST_UNIT_TEST
+  flash_unlock();
+  while (s_ota.erased_end_addr < end_addr)
+  {
+    if (flash_sector_erase(s_ota.erased_end_addr) != FLASH_OPERATE_DONE)
+    {
+      flash_lock();
+      return -1;
+    }
+    s_ota.erased_end_addr += MC_FLASH_SECTOR_SIZE;
+  }
+  for (uint32_t i = 0U; i < data_len; i++)
+  {
+    if (flash_byte_program(target_addr + i, p_data[i]) != FLASH_OPERATE_DONE ||
+        *(volatile uint8_t *)(target_addr + i) != p_data[i])
+    {
+      flash_lock();
+      return -2;
+    }
+  }
+  flash_lock();
+  return 0;
+#else
+  while (s_ota.erased_end_addr < end_addr)
+  {
+    if (host_mock_flash_erase_sector(s_ota.erased_end_addr) != 0)
+    {
+      return -1;
+    }
+    s_ota.erased_end_addr += MC_FLASH_SECTOR_SIZE;
+  }
+  return host_mock_flash_write_bytes(target_addr, p_data, data_len);
+#endif
+}
+
+/**
+  * @brief  校验 0x21 CMD_OTA_DATA 的块长度、偏移边界与内层 CRC16
+  */
+static uint8_t validate_ota_data_bounds(const minimc_frame_hdr_t *p_req,
+                                        const uint8_t *p_payload,
+                                        minimc_payload_ota_data_hdr_t *p_dh)
+{
+  if (s_ota.state != MC_OTA_STATE_ERASED_READY && s_ota.state != MC_OTA_STATE_FLASH_WRITING)
+  {
+    return MINIMC_ERR_COMMAND_REJECTED;
+  }
+  if (p_payload == NULL || p_req->payload_len <= sizeof(minimc_payload_ota_data_hdr_t))
+  {
+    return MINIMC_ERR_COMMAND_REJECTED;
+  }
+  memcpy(p_dh, p_payload, sizeof(*p_dh));
+  uint16_t data_len = (uint16_t)(p_req->payload_len - sizeof(*p_dh));
+  if (p_dh->chunk_bytes == 0U || p_dh->chunk_bytes > CHUNK_MAX_SIZE || p_dh->chunk_bytes != data_len)
+  {
+    return MINIMC_ERR_MTU_EXCEEDED;
+  }
+  if (p_dh->offset > s_ota.expected_size || (uint32_t)data_len > (s_ota.expected_size - p_dh->offset))
+  {
+    return MINIMC_ERR_OTA_INVALID_OFFSET;
+  }
+  const uint8_t *p_data = &p_payload[sizeof(*p_dh)];
+  if (boot_crc16_ccitt(p_data, data_len) != p_dh->chunk_crc16)
+  {
+    return MINIMC_ERR_CRC_FAIL;
+  }
+  return 0U;
+}
+
+/**
+  * @brief  处理 0x21 CMD_OTA_DATA (支持重传幂等与按扇区擦写回读校验)
+  */
+static void handle_cmd_ota_data(const minimc_frame_hdr_t *p_req,
+                                const uint8_t *p_payload)
+{
+  minimc_payload_ota_data_hdr_t dh;
+  uint8_t err = validate_ota_data_bounds(p_req, p_payload, &dh);
+  if (err != 0U)
+  {
+    send_nack(p_req, err);
+    return;
+  }
+
+  /* 重传幂等：已写入块重传直接回复 ACK */
+  if (dh.offset < s_ota.next_offset && (dh.offset + dh.chunk_bytes) <= s_ota.next_offset)
+  {
+    send_ack(p_req);
+    return;
+  }
+  if (dh.offset != s_ota.next_offset)
+  {
+    send_nack(p_req, MINIMC_ERR_OTA_INVALID_OFFSET);
+    return;
+  }
+
+  const uint8_t *p_data = &p_payload[sizeof(dh)];
+  int wrc = write_mc_app_flash_chunk(dh.offset, p_data, dh.chunk_bytes);
+  if (wrc != 0)
+  {
+    s_ota.state = MC_OTA_STATE_ERROR;
+    send_nack(p_req, (wrc == -1) ? MINIMC_ERR_OTA_ERASE_FAIL : MINIMC_ERR_OTA_WRITE_FAIL);
+    return;
+  }
+
+  s_ota.state = MC_OTA_STATE_FLASH_WRITING;
+  s_ota.next_offset += dh.chunk_bytes;
+  send_ack(p_req);
+}
+
+/**
+  * @brief  处理 0x23 CMD_OTA_STATUS 请求并回复 8B 进度状态
+  */
+static void handle_cmd_ota_status(const minimc_frame_hdr_t *p_req)
+{
+  if (p_req->payload_len != 0U)
+  {
+    send_nack(p_req, MINIMC_ERR_COMMAND_REJECTED);
+    return;
+  }
+  minimc_payload_ota_status_t rsp;
+  rsp.ota_state = (uint8_t)s_ota.state;
+  rsp.error_code = s_ota.last_error;
+  rsp.cached_chunk0_bytes = 0U;
+  rsp.bytes_written = s_ota.next_offset;
+  send_minimc_response(p_req, MINIMC_CMD_OTA_STATUS, (const uint8_t *)&rsp, sizeof(rsp));
+}
+
+/**
+  * @brief  处理 0x22 CMD_OTA_FINISH (全镜像 IEEE CRC32 校验与安全跳转准备)
+  */
+static void handle_cmd_ota_finish(const minimc_frame_hdr_t *p_req,
+                                  const uint8_t *p_payload)
+{
+  if (p_payload == NULL || p_req->payload_len != sizeof(minimc_payload_ota_finish_t))
+  {
+    send_nack(p_req, MINIMC_ERR_COMMAND_REJECTED);
+    return;
+  }
+  minimc_payload_ota_finish_t fin;
+  memcpy(&fin, p_payload, sizeof(fin));
+
+  if (s_ota.state == MC_OTA_STATE_VERIFIED_COMMITTED && fin.fw_crc32 == s_ota.expected_crc32)
+  {
+    send_ack(p_req);
+    return;
+  }
+  if (s_ota.next_offset != s_ota.expected_size || s_ota.expected_size == 0U)
+  {
+    send_nack(p_req, MINIMC_ERR_OTA_INVALID_OFFSET);
+    return;
+  }
+
+#ifndef HOST_UNIT_TEST
+  const uint8_t *p_flash = (const uint8_t *)FLASH_APP_ADDR;
+#else
+  const uint8_t *p_flash = host_mock_flash_ptr(FLASH_APP_ADDR);
+#endif
+  uint32_t calc_crc = boot_crc32_ieee(p_flash, s_ota.expected_size);
+  if (calc_crc != s_ota.expected_crc32 || calc_crc != fin.fw_crc32 || is_app_valid(FLASH_APP_ADDR) == 0U)
+  {
+    s_ota.state = MC_OTA_STATE_ERROR;
+    send_nack(p_req, MINIMC_ERR_OTA_CRC_MISMATCH);
+    return;
+  }
+
+  s_ota.state = MC_OTA_STATE_VERIFIED_COMMITTED;
+  boot_ota_release_writer(BOOT_WRITER_UART2);
+  send_ack(p_req);
+  if (fin.action_after_verify == 1U)
+  {
+    s_ota.pending_jump = 1U;
+  }
+}
+
+/**
+  * @brief  分发一帧已通过外层 CRC16 校验的 MiniMCProto v2.0 报文
+  */
+static void dispatch_valid_frame(const minimc_frame_hdr_t *p_hdr, const uint8_t *p_payload)
+{
+  /* 严格节点过滤：仅处理发往 MC(0x02) 的 V2 请求帧，绝不响应或转发 DST=0x03(TH) */
+  if (p_hdr->dst_id != MINIMC_NODE_MC)
+  {
+    return;
+  }
+  if ((p_hdr->flags & 0x0CU) != MINIMC_FLAG_VERSION_V2 ||
+      (p_hdr->flags & MINIMC_FLAG_IS_RESPONSE) != 0U)
+  {
+    return;
+  }
+
+  s_ota.rx_ok_count++;
+  switch (p_hdr->cmd_id)
+  {
+    case MINIMC_CMD_GET_VERSION:    handle_cmd_get_version(p_hdr); break;
+    case MINIMC_CMD_PING:           handle_cmd_ping(p_hdr, p_payload); break;
+    case MINIMC_CMD_SYSTEM_CONTROL: handle_cmd_system_control(p_hdr, p_payload); break;
+    case MINIMC_CMD_OTA_START:      handle_cmd_ota_start(p_hdr, p_payload); break;
+    case MINIMC_CMD_OTA_DATA:       handle_cmd_ota_data(p_hdr, p_payload); break;
+    case MINIMC_CMD_OTA_FINISH:     handle_cmd_ota_finish(p_hdr, p_payload); break;
+    case MINIMC_CMD_OTA_STATUS:     handle_cmd_ota_status(p_hdr); break;
+    default:                        send_nack(p_hdr, MINIMC_ERR_UNKNOWN_CMD); break;
+  }
+}
+
+/**
+  * @brief  逐字节喂入 MiniMCProto v2.0 帧同步状态机
+  */
+static void feed_frame_byte(uint8_t byte)
+{
+  if (s_frame_idx == 0U)
+  {
+    if (byte == MINIMC_SOF_0) { s_frame_buf[s_frame_idx++] = byte; }
+    return;
+  }
+  if (s_frame_idx == 1U)
+  {
+    if (byte == MINIMC_SOF_1) { s_frame_buf[s_frame_idx++] = byte; }
+    else { s_frame_idx = (byte == MINIMC_SOF_0) ? 1U : 0U; s_frame_buf[0] = byte; }
+    return;
+  }
+
+  s_frame_buf[s_frame_idx++] = byte;
+  if (s_frame_idx == MINIMC_HEADER_SIZE)
+  {
+    uint16_t payload_len = (uint16_t)s_frame_buf[10] | ((uint16_t)s_frame_buf[11] << 8U);
+    if (payload_len > MINIMC_MAX_PAYLOAD_SIZE) { s_frame_idx = 0U; return; }
+    s_expected_frame_len = (uint16_t)(MINIMC_FRAME_OVERHEAD + payload_len);
+  }
+  else if (s_frame_idx > MINIMC_HEADER_SIZE && s_frame_idx >= s_expected_frame_len)
+  {
+    uint16_t total_len = s_expected_frame_len;
+    s_frame_idx = 0U;
+    s_expected_frame_len = 0U;
+    uint16_t rx_crc = (uint16_t)s_frame_buf[total_len - 2U] |
+                      ((uint16_t)s_frame_buf[total_len - 1U] << 8U);
+    if (boot_crc16_ccitt(s_frame_buf, (uint32_t)(total_len - 2U)) != rx_crc)
+    {
+      s_ota.rx_crc_err_count++;
+      return;
+    }
+    minimc_frame_hdr_t hdr;
+    memcpy(&hdr, s_frame_buf, MINIMC_HEADER_SIZE);
+    dispatch_valid_frame(&hdr, &s_frame_buf[MINIMC_HEADER_SIZE]);
+  }
+}
+
+/**
+  * @brief  初始化 USART2 (PA2/PA3 @ 921600 8N1) 及 OTA 上下文并检测 UPG2 驻留魔数
+  */
+void boot_uart_ota_init(void)
+{
+  memset(&s_ota, 0, sizeof(s_ota));
+  s_active_writer = BOOT_WRITER_NONE;
+  s_rx_head = 0U;
+  s_rx_tail = 0U;
+  s_frame_idx = 0U;
+  s_expected_frame_len = 0U;
+  s_ota.boot_id = derive_dynamic_boot_id();
+
+#ifndef HOST_UNIT_TEST
+  volatile uint32_t *p_magic = (volatile uint32_t *)BOOT_MC_UPGRADE_MAGIC_ADDR;
+  if (*p_magic == BOOT_MC_UPGRADE_MAGIC_VAL)
+  {
+    *p_magic = 0UL;
+    s_ota.stay_in_boot = 1U;
+    printf("[BOOT] UPG2 magic detected at 0x2005FFF0, staying in Bootloader.\r\n");
+  }
+
+  gpio_init_type gpio_cfg;
+  crm_periph_clock_enable(CRM_GPIOA_PERIPH_CLOCK, TRUE);
+  crm_periph_clock_enable(CRM_USART2_PERIPH_CLOCK, TRUE);
+
+  gpio_default_para_init(&gpio_cfg);
+  gpio_cfg.gpio_drive_strength = GPIO_DRIVE_STRENGTH_STRONGER;
+  gpio_cfg.gpio_out_type = GPIO_OUTPUT_PUSH_PULL;
+  gpio_cfg.gpio_mode = GPIO_MODE_MUX;
+  gpio_cfg.gpio_pins = GPIO_PINS_2;
+  gpio_cfg.gpio_pull = GPIO_PULL_NONE;
+  gpio_init(GPIOA, &gpio_cfg);
+  gpio_cfg.gpio_pins = GPIO_PINS_3;
+  gpio_cfg.gpio_pull = GPIO_PULL_UP;
+  gpio_init(GPIOA, &gpio_cfg);
+  gpio_pin_mux_config(GPIOA, GPIO_PINS_SOURCE2, GPIO_MUX_7);
+  gpio_pin_mux_config(GPIOA, GPIO_PINS_SOURCE3, GPIO_MUX_7);
+
+  usart_init(USART2, BOOT_UART2_BAUDRATE, USART_DATA_8BITS, USART_STOP_1_BIT);
+  usart_transmitter_enable(USART2, TRUE);
+  usart_receiver_enable(USART2, TRUE);
+  usart_interrupt_enable(USART2, USART_RDBF_INT, TRUE);
+  nvic_irq_enable(USART2_IRQn, 1, 0);
+  usart_enable(USART2, TRUE);
+#else
+  if (host_mock_read_magic() == BOOT_MC_UPGRADE_MAGIC_VAL)
+  {
+    host_mock_write_magic(0UL);
+    s_ota.stay_in_boot = 1U;
+  }
+#endif
+}
+
+/**
+  * @brief  排空并复位关闭 USART2 外设 (跳转 App 前调用)
+  */
+void boot_uart_ota_deinit(void)
+{
+#ifndef HOST_UNIT_TEST
+  uint32_t timeout = UART2_TX_TIMEOUT_LOOPS;
+  while (usart_flag_get(USART2, USART_TDC_FLAG) == RESET && timeout > 0U)
+  {
+    timeout--;
+  }
+  nvic_irq_disable(USART2_IRQn);
+  usart_enable(USART2, FALSE);
+  crm_periph_reset(CRM_USART2_PERIPH_RESET, TRUE);
+  crm_periph_reset(CRM_USART2_PERIPH_RESET, FALSE);
+  crm_periph_clock_enable(CRM_USART2_PERIPH_CLOCK, FALSE);
+#endif
+}
+
+/**
+  * @brief  USART2 接收中断单字节推入环形队列
+  */
+void boot_uart_ota_rx_byte_isr(uint8_t byte)
+{
+  uint16_t next = (uint16_t)((s_rx_head + 1U) & (BOOT_UART2_RX_RING_SIZE - 1U));
+  if (next != s_rx_tail)
+  {
+    s_rx_ring[s_rx_head] = byte;
+    s_rx_head = next;
+  }
+}
+
+#ifndef HOST_UNIT_TEST
+/**
+  * @brief  USART2 硬件中断服务函数
+  */
+void USART2_IRQHandler(void)
+{
+  if (usart_flag_get(USART2, USART_RDBF_FLAG) != RESET)
+  {
+    uint8_t byte = (uint8_t)usart_data_receive(USART2);
+    boot_uart_ota_rx_byte_isr(byte);
+  }
+}
+#endif
+
+/**
+  * @brief  主循环轮询解析 USART2 环形队列并触发挂起的跳转或复位
+  */
+void boot_uart_ota_poll(void)
+{
+  while (s_rx_tail != s_rx_head)
+  {
+    uint8_t byte = s_rx_ring[s_rx_tail];
+    s_rx_tail = (uint16_t)((s_rx_tail + 1U) & (BOOT_UART2_RX_RING_SIZE - 1U));
+    feed_frame_byte(byte);
+  }
+
+  if (s_ota.pending_reboot != 0U)
+  {
+    s_ota.pending_reboot = 0U;
+#ifndef HOST_UNIT_TEST
+    NVIC_SystemReset();
+#else
+    host_mock_system_reset();
+#endif
+  }
+  if (s_ota.pending_jump != 0U)
+  {
+    s_ota.pending_jump = 0U;
+#ifndef HOST_UNIT_TEST
+    jump_to_app(FLASH_APP_ADDR);
+#else
+    host_mock_jump_to_app(FLASH_APP_ADDR);
+#endif
+  }
+}
+
+/**
+  * @brief  查询是否应驻留 Bootloader (收到 UPG2 魔数、0x1D 或 0x20 升级会话)
+  */
+uint8_t boot_uart_ota_should_stay_in_boot(void)
+{
+  return (s_ota.stay_in_boot != 0U || s_active_writer == BOOT_WRITER_UART2) ? 1U : 0U;
+}
+
+/**
+  * @brief  获取当前上电周期动态生成的 boot_id
+  */
+uint32_t boot_uart_ota_get_boot_id(void)
+{
+  return s_ota.boot_id;
+}
