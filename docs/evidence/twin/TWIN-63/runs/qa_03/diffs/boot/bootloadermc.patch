@@ -0,0 +1,99 @@
+#!/bin/sh
+# TWIN-63 MC Bootloader 交叉编译、打包边界与主机单元测试脚本
+set -eu
+
+echo "=== [1/4] Cross-compile MC Bootloader & verify 128KB Flash budget + zero USART6 coupling ==="
+make clean all
+BIN_SIZE=$(stat -c%s build/bootloader.bin)
+echo "bootloader.bin size: ${BIN_SIZE} bytes (limit: 131072 bytes)"
+test "${BIN_SIZE}" -le 131072
+if arm-none-eabi-nm build/bootloader.elf | grep -v " W " | grep -i "usart6"; then
+  echo "[FAIL] Non-weak USART6 symbol found in MC Bootloader ELF!"
+  exit 1
+fi
+if grep -rn "USART6" bootloader/src/ bootloader/inc/; then
+  echo "[FAIL] USART6 reference found in MC Bootloader source/headers!"
+  exit 1
+fi
+echo "[PASS] Cross-compile <=128KB and zero USART6 coupling verified!"
+
+echo "=== [2/4] Verify scripts/pack_firmware.py MC (896KB=917,504B) & TH (236KB=241,664B) boundary gate ==="
+python3 - <<'PY'
+import subprocess, sys, tempfile
+from pathlib import Path
+
+with tempfile.TemporaryDirectory() as tmp:
+    tdir = Path(tmp)
+    # MC 正例: 917504B (896KB)
+    mc_ok = tdir / "mc_ok.bin"
+    mc_ok.write_bytes(b"\xAA" * 917504)
+    r1 = subprocess.run([sys.executable, "scripts/pack_firmware.py", "-i", str(mc_ok), "-b", "0x43500001", "-o", str(tdir / "fw_mc.bin")])
+    assert r1.returncode == 0 and (tdir / "fw_mc.bin").stat().st_size == 917504 + 128
+
+    # MC 负例: 917505B (896KB + 1B) 必须失败
+    mc_over = tdir / "mc_over.bin"
+    mc_over.write_bytes(b"\xAA" * 917505)
+    r2 = subprocess.run([sys.executable, "scripts/pack_firmware.py", "-i", str(mc_over), "-b", "0x43500001", "-o", str(tdir / "fw_mc_over.bin")])
+    assert r2.returncode != 0
+
+    # TH 正例: 241664B (236KB)
+    th_ok = tdir / "th_ok.bin"
+    th_ok.write_bytes(b"\x55" * 241664)
+    r3 = subprocess.run([sys.executable, "scripts/pack_firmware.py", "-i", str(th_ok), "-b", "0x42300001", "-o", str(tdir / "fw_th.bin")])
+    assert r3.returncode == 0 and (tdir / "fw_th.bin").stat().st_size == 241664 + 128
+
+    # TH 负例: 241665B (236KB + 1B) 必须失败
+    th_over = tdir / "th_over.bin"
+    th_over.write_bytes(b"\x55" * 241665)
+    r4 = subprocess.run([sys.executable, "scripts/pack_firmware.py", "-i", str(th_over), "-b", "0x42300001", "-o", str(tdir / "fw_th_over.bin")])
+    assert r4.returncode != 0
+print("[PASS] scripts/pack_firmware.py MC(896KB) & TH(236KB) boundary checks passed!")
+PY
+
+echo "=== [3/4] Compile & run host unit tests for MC Bootloader MiniMCProto v2.0 OTA ==="
+gcc -O2 -g3 -Wall -Wextra -Werror -DHOST_UNIT_TEST \
+    -Ibootloader/inc \
+    tests/test_mc_boot_ota.c \
+    -o build/test_mc_boot_ota
+./build/test_mc_boot_ota
+
+echo "=== [4/4] Verify C function length (<=50 lines) and parameter count (<=4) gate ==="
+python3 - <<'PY'
+import re, sys
+from pathlib import Path
+
+files = [
+    Path("bootloader/src/boot_uart_ota.c"), Path("bootloader/src/usbh_user.c"),
+    Path("bootloader/src/main.c"),
+    Path("bootloader/src/bsp_uart.c"),
+    Path("tests/test_mc_boot_ota.c"),
+]
+
+func_hdr = re.compile(r'^[A-Za-z_][\w\s\*]*?\b([A-Za-z_]\w*)\s*\(([^;{}]*)\)\s*\{', re.M)
+for p in files:
+    text = p.read_text(encoding="utf-8")
+    for m in func_hdr.finditer(text):
+        name = m.group(1)
+        if name in ("if", "while", "for", "switch"):
+            continue
+        params_raw = m.group(2).strip()
+        params = [] if params_raw in ("", "void") else [x.strip() for x in params_raw.split(",")]
+        brace_start = text.find("{", m.start())
+        depth = 0
+        end_idx = brace_start
+        for idx in range(brace_start, len(text)):
+            if text[idx] == "{":
+                depth += 1
+            elif text[idx] == "}":
+                depth -= 1
+                if depth == 0:
+                    end_idx = idx
+                    break
+        start_line = text.count("\n", 0, m.start()) + 1
+        end_line = text.count("\n", 0, end_idx) + 1
+        n_lines = end_line - start_line + 1
+        if n_lines > 50 or len(params) > 4:
+            print(f"[FAIL] {p}:{name} lines={n_lines} params={len(params)}")
+            sys.exit(1)
+print("[PASS] All checked C functions satisfy <=50 lines and <=4 parameters!")
+PY
