+/**
+  * @brief  测试单写者互斥锁 (USB Host vs USART2) 与 0x20 擦除前零擦除负例门禁及恢复
+  */
+static void test_single_writer_mutex_and_zero_erase_admission(void)
+{
+  uint8_t img[1024];
+  fw_trailer_t tr;
+  uint32_t crc = 0U;
+  build_mc_image_and_trailer(img, sizeof(img), &tr, &crc);
+  boot_uart_ota_init();
+  s_erase_count = 0U;
+
+  minimc_payload_ota_start_t req;
+  memset(&req, 0, sizeof(req));
+  req.target_device = MINIMC_NODE_MC;
+  req.target_component = 1U;
+  req.fw_size_bytes = sizeof(img);
+  req.fw_crc32 = crc;
+  req.trailer = tr;
+
+  /* 1. USB 升级占用时，USART2 0x20 必须返回 NACK 0x05 (DEVICE_BUSY) 且零擦除 */
+  g_upgrade_in_progress = 1U;
+  send_minimc_frame(MINIMC_NODE_MC, MINIMC_CMD_OTA_START, 10U, &req);
+  require_true(s_last_tx[5] == MINIMC_CMD_NACK && s_last_tx[12] == MINIMC_ERR_DEVICE_BUSY, "USB busy -> NACK 0x05");
+  require_true(s_erase_count == 0U, "USB busy zero erase");
+  g_upgrade_in_progress = 0U;
+
+  /* 2. 917,505B (896KB + 1B) 超限必须返回 NACK 0x14 (OTA_IMAGE_OVERSIZE) 且零擦除 */
+  req.fw_size_bytes = MC_MAX_APP_SIZE + 1U;
+  req.trailer = tr;
+  req.trailer.payload_len = MC_MAX_APP_SIZE + 1U;
+  send_minimc_frame(MINIMC_NODE_MC, MINIMC_CMD_OTA_START, 11U, &req);
+  require_true(s_last_tx[5] == MINIMC_CMD_NACK && s_last_tx[12] == MINIMC_ERR_OTA_IMAGE_OVERSIZE && s_erase_count == 0U, "oversize 917505B zero erase");
+
+  /* 3. 错板 (TH 0x42300001) 与坏 trailer_crc32 必须返回 NACK 0x06 且零擦除，且状态保持 IDLE 并可恢复 */
+  req.fw_size_bytes = sizeof(img);
+  req.trailer = tr;
+  req.trailer.board_id = BOARD_ID_TH_AT32F423;
+  req.trailer.trailer_crc32 = boot_crc32_ieee((const uint8_t *)&req.trailer, TRAILER_HEADER_CRC_SIZE);
+  send_minimc_frame(MINIMC_NODE_MC, MINIMC_CMD_OTA_START, 12U, &req);
+  require_true(s_last_tx[5] == MINIMC_CMD_NACK && s_last_tx[12] == MINIMC_ERR_COMMAND_REJECTED && s_erase_count == 0U, "wrong board zero erase");
+
+  req.trailer = tr;
+  req.trailer.trailer_crc32 ^= 0xDEADBEEFUL;
+  send_minimc_frame(MINIMC_NODE_MC, MINIMC_CMD_OTA_START, 13U, &req);
+  require_true(s_last_tx[5] == MINIMC_CMD_NACK && s_last_tx[12] == MINIMC_ERR_COMMAND_REJECTED && s_erase_count == 0U, "bad trailer_crc32 zero erase");
+  send_minimc_frame(MINIMC_NODE_MC, MINIMC_CMD_OTA_STATUS, 14U, NULL);
+  require_true(s_last_tx[5] == MINIMC_CMD_OTA_STATUS && s_last_tx[12] == 0U, "state stays IDLE and recovers");
+}
+
+/**
+  * @brief  测试完整 0x20 -> 0x21 (含重传幂等与错位 0x13) -> 0x23 -> 0x22 升级与校验跳转
+  */
+static void test_full_ota_flow_and_crc_verification(void)
+{
+  uint8_t img[1024];
+  fw_trailer_t tr;
+  uint32_t crc = 0U;
+  build_mc_image_and_trailer(img, sizeof(img), &tr, &crc);
+  memset(s_sim_flash, 0xAA, sizeof(s_sim_flash));
+  boot_uart_ota_init();
+  s_erase_count = 0U;
+  s_jump_count = 0U;
+
+  minimc_payload_ota_start_t req;
+  memset(&req, 0, sizeof(req));
+  req.target_device = MINIMC_NODE_MC;
+  req.target_component = 1U;
+  req.fw_size_bytes = sizeof(img);
+  req.fw_crc32 = crc;
+  req.trailer = tr;
+
+  send_minimc_frame(MINIMC_NODE_MC, MINIMC_CMD_OTA_START, 20U, &req);
+  require_true(s_last_tx[5] == MINIMC_CMD_ACK && s_erase_count == 0U, "0x20 ACK before sector write");
+  require_true(boot_ota_acquire_writer(BOOT_WRITER_USB) == 0U, "USB blocked while UART2 holds writer");
+
+  /* 错位 offset=512 必须返回 NACK 0x13 (OTA_INVALID_OFFSET) */
+  send_ota_data_chunk(21U, 512U, &img[512]);
+  require_true(s_last_tx[5] == MINIMC_CMD_NACK && s_last_tx[12] == MINIMC_ERR_OTA_INVALID_OFFSET, "offset mismatch 0x13");
+
+  /* 写入 Chunk 0 (0..512) -> 触发首个 2KB 扇区擦除，重传 Chunk 0 幂等返回 ACK */
+  send_ota_data_chunk(22U, 0U, &img[0]);
+  require_true(s_last_tx[5] == MINIMC_CMD_ACK && s_erase_count == 1U, "Chunk 0 ACK & 1 sector erased");
+  send_ota_data_chunk(23U, 0U, &img[0]);
+  require_true(s_last_tx[5] == MINIMC_CMD_ACK && s_erase_count == 1U, "Chunk 0 retransmit idempotent");
+
+  /* 写入 Chunk 1 (512..1024) 并查询 0x23 STATUS */
+  send_ota_data_chunk(24U, 512U, &img[512]);
+  require_true(s_last_tx[5] == MINIMC_CMD_ACK, "Chunk 1 ACK");
+  send_minimc_frame(MINIMC_NODE_MC, MINIMC_CMD_OTA_STATUS, 25U, NULL);
+  require_true(s_last_tx[5] == MINIMC_CMD_OTA_STATUS && s_last_tx_len == 22U, "0x23 status 8B payload");
+
+  /* 0x22 CMD_OTA_FINISH 校验通过并触发 jump_to_app(0x08020000) */
+  minimc_payload_ota_finish_t fin_req = {crc, 1U, {0U, 0U, 0U}};
+  send_minimc_frame(MINIMC_NODE_MC, MINIMC_CMD_OTA_FINISH, 26U, &fin_req);
+  require_true(s_last_tx[5] == MINIMC_CMD_ACK && s_jump_count == 1U && s_last_jump_addr == FLASH_APP_ADDR, "0x22 ACK and jump");
+  require_true(memcmp(s_sim_flash, img, sizeof(img)) == 0, "Flash image matches 100%");
+}
+
+/**
+  * @brief  直接驱动 usbh_user_handle.user_application() 验证 USB Host U 盘升级成功与坏 trailer_crc32 零擦除拒绝
+  */
+static void test_usb_host_udisk_upgrade_and_bad_trailer_zero_erase(void)
+{
+  uint8_t img[1024];
+  fw_trailer_t tr;
+  uint32_t crc = 0U;
+  build_mc_image_and_trailer(img, sizeof(img), &tr, &crc);
+
+  /* 1. 坏 trailer_crc32 的 firmwaremc.bin：擦除前预验签失败 -> s_erase_count == 0，重命名为 firmwaremc.err */
+  fw_trailer_t bad_tr = tr;
+  bad_tr.trailer_crc32 ^= 0x55AA55AAUL;
+  memset(s_sim_flash, 0xAA, sizeof(s_sim_flash));
+  boot_uart_ota_init();
+  s_erase_count = 0U;
+  s_jump_count = 0U;
+  mount_sim_udisk_package("firmwaremc.bin", img, sizeof(img), &bad_tr);
+
+  usbh_user_handle.user_application(); /* USER_INIT -> USER_READLIST */
+  usbh_user_handle.user_application(); /* USER_READLIST -> USER_WRITE */
+  usbh_user_handle.user_application(); /* USER_WRITE -> USER_IDEL */
+  usbh_user_handle.user_application(); /* USER_IDEL */
+  require_true(s_erase_count == 0U && s_jump_count == 0U, "USB bad trailer_crc32 must abort before erase");
+  require_true(strcmp(s_udisk_fname, "firmwaremc.err") == 0, "bad USB package renamed to firmwaremc.err");
+  require_true(boot_ota_get_active_writer() == BOOT_WRITER_NONE, "USB writer released after failure");
+
+  /* 2. 合法 firmwaremc.bin：擦写成功 -> 重命名为 firmwaremc.cur -> 释放锁并 jump_to_app(0x08020000) */
+  mount_sim_udisk_package("firmwaremc.bin", img, sizeof(img), &tr);
+  usbh_user_handle.user_application(); /* USER_INIT -> USER_READLIST */
+  usbh_user_handle.user_application(); /* USER_READLIST -> USER_WRITE */
+  usbh_user_handle.user_application(); /* USER_WRITE -> USER_IDEL */
+  usbh_user_handle.user_application(); /* USER_IDEL -> jump_to_app */
+  require_true(s_erase_count == 1U && s_jump_count == 1U && s_last_jump_addr == FLASH_APP_ADDR, "USB upgrade success & jump");
+  require_true(strcmp(s_udisk_fname, "firmwaremc.cur") == 0, "valid USB package renamed to firmwaremc.cur");
+  require_true(memcmp(s_sim_flash, img, sizeof(img)) == 0, "USB Flash image matches 100%");
+}
+
+/**
+  * @brief  验证 USB Host 状态机与 USART2 状态机双向并发竞争互斥拒绝及释放后恢复升级
+  */
+static void test_usb_and_uart2_contention_and_recovery(void)
+{
+  uint8_t img[1024];
+  fw_trailer_t tr;
+  uint32_t crc = 0U;
+  build_mc_image_and_trailer(img, sizeof(img), &tr, &crc);
+  memset(s_sim_flash, 0xAA, sizeof(s_sim_flash));
+  boot_uart_ota_init();
+  s_erase_count = 0U;
+  s_jump_count = 0U;
+  minimc_payload_ota_start_t req;
+  memset(&req, 0, sizeof(req));
+  req.target_device = MINIMC_NODE_MC;
+  req.target_component = 1U;
+  req.fw_size_bytes = sizeof(img);
+  req.fw_crc32 = crc;
+  req.trailer = tr;
+  /* 场景 A：UART2 先通过 0x20 持有锁 -> USB 状态机在 USER_READLIST 被互斥拒绝转入 USER_IDEL -> UART2 完成升级 */
+  send_minimc_frame(MINIMC_NODE_MC, MINIMC_CMD_OTA_START, 30U, &req);
+  require_true(s_last_tx[5] == MINIMC_CMD_ACK, "UART2 acquires writer first");
+  mount_sim_udisk_package("firmwaremc.bin", img, sizeof(img), &tr);
+  usbh_user_handle.user_application();
+  usbh_user_handle.user_application();
+  require_true(s_appstate == USER_IDEL && g_upgrade_in_progress == 0U, "USB deferred while UART2 active");
+  send_ota_data_chunk(31U, 0U, &img[0]);
+  send_ota_data_chunk(32U, 512U, &img[512]);
+  minimc_payload_ota_finish_t fin_req = {crc, 1U, {0U, 0U, 0U}};
+  send_minimc_frame(MINIMC_NODE_MC, MINIMC_CMD_OTA_FINISH, 33U, &fin_req);
+  require_true(s_last_tx[5] == MINIMC_CMD_ACK && s_jump_count == 1U, "UART2 finishes OTA after deferring USB");
+  /* 场景 B：USB 在 USER_READLIST 先持有锁 -> UART2 0x20 收到 NACK 0x05 -> USB 完成释放后 UART2 重试成功 */
+  boot_uart_ota_init();
+  s_erase_count = 0U;
+  s_jump_count = 0U;
+  mount_sim_udisk_package("firmwaremc.bin", img, sizeof(img), &tr);
+  usbh_user_handle.user_application();
+  usbh_user_handle.user_application();
+  require_true(g_upgrade_in_progress == 1U && boot_ota_get_active_writer() == BOOT_WRITER_USB, "USB holds writer");
+  send_minimc_frame(MINIMC_NODE_MC, MINIMC_CMD_OTA_START, 34U, &req);
+  require_true(s_last_tx[5] == MINIMC_CMD_NACK && s_last_tx[12] == MINIMC_ERR_DEVICE_BUSY && s_erase_count == 0U, "UART2 NACK 0x05");
+  usbh_user_handle.user_application();
+  usbh_user_handle.user_application();
+  require_true(boot_ota_get_active_writer() == BOOT_WRITER_NONE && g_upgrade_in_progress == 0U, "USB releases writer");
+  send_minimc_frame(MINIMC_NODE_MC, MINIMC_CMD_OTA_START, 35U, &req);
+  send_ota_data_chunk(36U, 0U, &img[0]);
+  send_ota_data_chunk(37U, 512U, &img[512]);
+  send_minimc_frame(MINIMC_NODE_MC, MINIMC_CMD_OTA_FINISH, 38U, &fin_req);
+  require_true(s_last_tx[5] == MINIMC_CMD_ACK && s_jump_count == 2U, "UART2 completes recovery upgrade");
+}
