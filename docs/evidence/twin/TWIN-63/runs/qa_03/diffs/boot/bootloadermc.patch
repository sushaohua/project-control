+  for (uint32_t i = 0U; i < len; i++)
+  {
+    s_sim_flash[off + i] &= p_data[i];
+    if (s_sim_flash[off + i] != p_data[i])
+    {
+      return -2;
+    }
+  }
+  return 0;
+}
