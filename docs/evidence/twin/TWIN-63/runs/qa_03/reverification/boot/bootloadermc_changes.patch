+static void test_usb_host_udisk_upgrade_and_bad_trailer_zero_erase(void)
+{
+  uint8_t img[1024];
+  fw_trailer_t tr;
+  uint32_t crc = 0U;
+  build_mc_image_and_trailer(img, sizeof(img), &tr, &crc);
