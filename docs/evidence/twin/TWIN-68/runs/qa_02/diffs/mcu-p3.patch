+/**
+ * @brief 验证 TWIN-68 同轮跨毫秒 SysTick 下溢防护 (0xFFFFFFFFU) 与 32 位计数器回绕超时判定
+ */
+static void test_th_relay_timeout_underflow_and_wraparound(void)
+{
+    minimc_proto_init();
+    uint8_t ota_data_pay[520];
+    memset(ota_data_pay, 0xA5, sizeof(ota_data_pay));
+
+    /* 场景 A: 发送期间 SysTick +1ms 推进且显式校验 now_ms < s_relay_start_ms 下溢不误超时 */
+    s_mock_tick_ms = 1120280U;
+    s_tick_advance_on_th_tx = 1U;
+    send_ap_frame(MINIMC_NODE_TH, 0x05U, MINIMC_CMD_OTA_DATA, ota_data_pay);
+    minimc_proto_poll();
+    check_th_relay_timeout(1120280U);
+    require_true(minimc_proto_is_th_relay_pending() && minimc_proto_is_th_proxy_active(), "no false timeout on underflow");
+
+    /* 2ms 后 TH 正常返回 0x00 CMD_ACK -> MC 正常透传回 AP，无 BAD_FRAME 0x07 */
+    s_tick_advance_on_th_tx = 0U;
+    s_mock_tick_ms = 1120283U;
+    const uint16_t rx_seq = (uint16_t)s_last_th_tx[8] | ((uint16_t)s_last_th_tx[9] << 8U);
+    inject_th_resp(MINIMC_NODE_AP, MINIMC_CMD_ACK, rx_seq, 4U);
+    s_last_ap_tx_len = 0U;
+    minimc_proto_poll();
+    require_true(s_last_ap_tx_len == 18U && s_last_ap_tx[5] == MINIMC_CMD_ACK, "ACK relayed without 0x07");
+
+    /* 场景 B: 32 位毫秒计数器跨 0xFFFFFFFFU -> 0x00000000U 正常回绕与超时释放 */
+    s_mock_tick_ms = 0xFFFFFFF0UL;
+    send_ap_frame(MINIMC_NODE_TH, 0x05U, MINIMC_CMD_OTA_DATA, ota_data_pay);
+    s_mock_tick_ms = 0x00000010UL;
+    minimc_proto_poll();
+    require_true(minimc_proto_is_th_relay_pending(), "32ms wraparound < 1500ms stays pending");
+    s_mock_tick_ms = 0x00000600UL;
+    minimc_proto_poll();
+    require_true(!minimc_proto_is_th_relay_pending(), "1552ms wraparound >= 1500ms triggers timeout");
+}
