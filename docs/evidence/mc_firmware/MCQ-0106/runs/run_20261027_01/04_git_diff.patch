 }
 
-static void build_version_resp_payload(uint8_t *buf)
+static void build_version_resp_payload(uint8_t fw_minor, uint8_t *buf)
 {
     if (buf == NULL)
     {
@@ -100,15 +103,47 @@ static void build_version_resp_payload(uint8_t *buf)
     buf[12] = 2U;
     buf[13] = 0U;
