{
  "schema_version": 2,
  "canonical_repository": "project-control",
  "canonical_rules": ".agents/rules",
  "external_agents_repository": "agents",
  "scope": "公共规则单源保存在 project-control/.agents/rules；分仓专属 AGENTS.md、rules 与 skills 独立存放在 agents 仓，不再向业务仓复制 shared/ 或 .repo-rules/ 快照。",
  "snapshot_version": "以任务或 QA 锁定的 project-control@<commit> 与 agents@<commit> 为准。",
  "repositories": {
    "project-control": {
      "branch": "main",
      "entry": "AGENTS.md",
      "mode": "canonical",
      "rules": ".agents/rules",
      "shared_source": null,
      "preserve_existing_links": false,
      "read_receipt": "现有read_sources及接单回执；列规则路径、版本、适用环境和缺项"
    },
    "agents": {
      "branch": "main",
      "entry": "AGENTS.md",
      "mode": "canonical-repo-rules",
      "rules": "<repo>/.agents/rules",
      "shared_source": "project-control/.agents/rules",
      "preserve_existing_links": false,
      "read_receipt": "现有read_sources及接单回执；列规则路径、版本、适用环境和缺项"
    },
    "test_harness": {
      "branch": "main",
      "entry": "AGENTS.md -> ../agents/test_harness/AGENTS.md",
      "mode": "external-agents",
      "agents_subdir": "test_harness",
      "rules": ".agents/rules -> ../agents/test_harness/.agents/rules",
      "shared_source": "project-control/.agents/rules",
      "preserve_existing_links": true,
      "read_receipt": "现有read_sources及接单回执；列 project-control 与 agents 规则版本"
    },
    "mcu-p3": {
      "branch": "feat/soc-debug",
      "entry": "AGENTS.md -> ../agents/mcu-p3/AGENTS.md",
      "mode": "external-agents",
      "agents_subdir": "mcu-p3",
      "rules": ".agents/rules -> ../agents/mcu-p3/.agents/rules",
      "shared_source": "project-control/.agents/rules",
      "preserve_existing_links": true,
      "read_receipt": "现有read_sources及接单回执；列 project-control 与 agents 规则版本"
    },
    "boot/bootloadermc": {
      "branch": "soc_debug",
      "entry": "AGENTS.md -> ../../agents/bootloadermc/AGENTS.md",
      "mode": "external-agents",
      "agents_subdir": "bootloadermc",
      "rules": ".agents/rules -> ../../agents/bootloadermc/.agents/rules",
      "shared_source": "project-control/.agents/rules",
      "preserve_existing_links": true,
      "read_receipt": "现有read_sources及接单回执；列 project-control 与 agents 规则版本"
    },
    "boot/bootloaderth": {
      "branch": "soc_debug",
      "entry": "AGENTS.md -> ../../agents/bootloaderth/AGENTS.md",
      "mode": "external-agents",
      "agents_subdir": "bootloaderth",
      "rules": ".agents/rules -> ../../agents/bootloaderth/.agents/rules",
      "shared_source": "project-control/.agents/rules",
      "preserve_existing_links": true,
      "read_receipt": "现有read_sources及接单回执；列 project-control 与 agents 规则版本"
    },
    "printer-soc": {
      "branch": "main",
      "entry": "AGENTS.md -> ../agents/printer-soc/AGENTS.md",
      "mode": "external-agents",
      "agents_subdir": "printer-soc",
      "rules": ".agents/rules -> ../agents/printer-soc/.agents/rules",
      "shared_source": "project-control/.agents/rules",
      "preserve_existing_links": true,
      "read_receipt": "现有read_sources及接单回执；列 project-control 与 agents 规则版本"
    }
  },
  "repo_clients": {
    "c308l": {
      "path": "sdk/c308l",
      "mode": "repo-client",
      "entry": "AGENTS.md -> ../../agents/c308l-sdk/AGENTS.md",
      "rules": ".agents/rules -> ../../agents/c308l-sdk/.agents/rules",
      "agents_subdir": "c308l-sdk",
      "shared_source": "project-control/.agents/rules",
      "project_policy": "contracts/c308l_platform_contract.yaml",
      "preserve_existing_links": true
    }
  }
}
